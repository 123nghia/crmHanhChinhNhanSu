@{
    var document = Model.Document as dynamic;
    var canSign = Model.CanSign != null && (bool)Model.CanSign;
    var termsTitle = Model.TermsTitle?.ToString() ?? "Dieu khoan ky tai lieu noi bo";
    var termsContent = Model.TermsContent?.ToString() ?? string.Empty;
    var requestedAtText = string.Empty;
    if (document != null && document.SignatureRequestedAt != null)
    {
        requestedAtText = document.SignatureRequestedAt.ToString("dd/MM/yyyy HH:mm");
    }
    var signerDisplay = string.Empty;
    var signedIpAddress = document?.SignedIpAddress?.ToString() ?? string.Empty;
    var signedUserAgent = document?.SignedUserAgent?.ToString() ?? string.Empty;
    var signedFileArchivePath = document?.SignedFileArchivePath?.ToString() ?? string.Empty;
    var signatureImagePath = document?.SignatureImagePath?.ToString() ?? string.Empty;
    var signatureIntentText = document?.SignatureIntentText?.ToString() ?? string.Empty;
    if (document != null)
    {
        if (!string.IsNullOrWhiteSpace((string?)document.SignedByUserNameSnapshot))
        {
            signerDisplay = document.SignedByUserNameSnapshot;
            if (!string.IsNullOrWhiteSpace((string?)document.SignedByFullNameSnapshot))
            {
                signerDisplay += " - " + document.SignedByFullNameSnapshot;
            }
        }
        else if (!string.IsNullOrWhiteSpace((string?)document.SignedByUserName))
        {
            signerDisplay = document.SignedByUserName;
            if (!string.IsNullOrWhiteSpace((string?)document.SignedByFullName))
            {
                signerDisplay += " - " + document.SignedByFullName;
            }
        }
    }
    var requestedByDisplay = string.Empty;
    if (document != null && !string.IsNullOrWhiteSpace(document.SignatureRequestedByUserName))
    {
        requestedByDisplay = document.SignatureRequestedByUserName;
        if (!string.IsNullOrWhiteSpace(document.SignatureRequestedByFullName))
        {
            requestedByDisplay += " - " + document.SignatureRequestedByFullName;
        }
    }
}

<div class="modal-header">
    <h5 class="modal-title">Ky xac nhan tai lieu</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    @if (document == null || document.Id < 1)
    {
        <div class="alert alert-danger mb-0">Khong tim thay tai lieu.</div>
    }
    else if (document.IsSignedInternal == true)
    {
        <div class="alert alert-success mb-0">
            Tai lieu nay da duoc ky noi bo.
            @if (!string.IsNullOrWhiteSpace(signerDisplay))
            {
                <div class="mt-2">Nguoi ky: <strong>@signerDisplay</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(signatureIntentText))
            {
                <div class="mt-2">Y chi dong y: <strong>@signatureIntentText</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(signedIpAddress))
            {
                <div>IP luc ky: <strong>@signedIpAddress</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(signedUserAgent))
            {
                <div class="text-break">User-Agent: <strong>@signedUserAgent</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(signedFileArchivePath))
            {
                <div class="text-break">Ban sao da ky: <a href="@signedFileArchivePath" target="_blank">Mo file da ky</a></div>
            }
            @if (!string.IsNullOrWhiteSpace(signatureImagePath))
            {
                <div class="text-break">Anh chu ky: <a href="@signatureImagePath" target="_blank">Mo anh chu ky</a></div>
            }
        </div>
    }
    else if (!canSign)
    {
        <div class="alert alert-warning mb-0">Tai lieu nay chua duoc yeu cau ky.</div>
    }
    else
    {
        <form id="signEmployeeDocumentForm" class="needs-validation" novalidate>
            <div class="col-12 form-group">
                <label class="form-label">Tai lieu</label>
                <input type="text" class="form-control" value="@document.DisplayText" readonly />
            </div>

            <div class="col-12 form-group mt-2">
                <label class="form-label">Nguoi ky</label>
                <input type="text" class="form-control" value="@($"{document.UserName} - {document.FullName}")" readonly />
            </div>

            <div class="col-12 form-group mt-2">
                <label class="form-label">File tai lieu</label>
                @if (!string.IsNullOrWhiteSpace((string?)document.ValueFile))
                {
                    <div>
                        <a href="@document.ValueFile" target="_blank">Mo file tai lieu</a>
                    </div>
                }
                else
                {
                    <div class="text-danger">Tai lieu chua co file.</div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(requestedAtText) || !string.IsNullOrWhiteSpace(requestedByDisplay))
            {
                <div class="alert alert-info mt-3">
                    @if (!string.IsNullOrWhiteSpace(requestedAtText))
                    {
                        <div>Yeu cau ky luc: <strong>@requestedAtText</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(requestedByDisplay))
                    {
                        <div>Nguoi yeu cau: <strong>@requestedByDisplay</strong></div>
                    }
                </div>
            }

            <div class="alert alert-warning mt-3">
                <div class="fw-bold mb-2">@termsTitle</div>
                <div>@termsContent</div>
                <div class="mt-2 small">
                    He thong se dong dau chu ky len ban archive cua file da ky doi voi PDF va file anh. Cac dinh dang khac se luu kem anh chu ky de truy vet.
                </div>
            </div>

            <div class="col-12 form-group mt-3">
                <label class="form-label">Chu ky nhan vien <span class="text-danger">*</span></label>
                <div class="border rounded bg-white p-2">
                    <canvas id="employeeSignatureCanvas" width="520" height="180" style="width:100%;max-width:100%;border:1px dashed #ced4da;border-radius:8px;touch-action:none;"></canvas>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearEmployeeSignaturePad()">Xoa chu ky</button>
                </div>
                <div class="small text-muted mt-1">Nhan vien ky truc tiep tren o ben tren bang chuot, but cam ung hoac ngon tay.</div>
                <div class="invalid-feedback-cs"></div>
            </div>

            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="cbDocumentAcceptTerms" />
                <label class="form-check-label" for="cbDocumentAcceptTerms">
                    Toi da doc, hieu va dong y voi dieu khoan ky noi bo doi voi tai lieu nay.
                </label>
                <div class="invalid-feedback-cs"></div>
            </div>

            <div class="col-12 form-group mt-3">
                <label class="form-label">Ma ky noi bo (tuy chon)</label>
                <input type="text" id="txtDocumentSignatureCode" class="form-control" maxlength="100" placeholder="VD: TOI_DONG_Y_KY_TAI_LIEU" />
            </div>

            <div class="col-12 form-group mt-2">
                <label class="form-label">Mat khau xac nhan <span class="text-danger">*</span></label>
                <input type="password" id="txtDocumentSignPassword" class="form-control" maxlength="100" autocomplete="off" />
                <div class="invalid-feedback-cs"></div>
            </div>

            <div class="col-12 form-group mt-2">
                <label class="form-label">Ghi chu ky (tuy chon)</label>
                <textarea id="txtDocumentSignNote" class="form-control" style="height: 90px" maxlength="500"></textarea>
            </div>
        </form>
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Dong</button>
    @if (document != null && document.Id > 0 && canSign && document.IsSignedInternal != true)
    {
        <button type="button" class="btn btn-primary" onclick="signEmployeeDocument(@document.Id)">Ky xac nhan</button>
    }
</div>
