<script>
    // Format dates ngay khi script load (trước khi DOM ready) - đặc biệt cho Firefox
    (function() {
        if (typeof DateFormatter !== 'undefined' && DateFormatter.formatDatesInContainer) {
            // Format ngay nếu DOM đã sẵn sàng
            if (document.body) {
                DateFormatter.formatDatesInContainer(document);
            }
            // Format lại sau khi DOM ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function() {
                    setTimeout(function() {
                        DateFormatter.formatDatesInContainer(document);
                    }, 50);
                });
            }
        }
    })();
</script>
