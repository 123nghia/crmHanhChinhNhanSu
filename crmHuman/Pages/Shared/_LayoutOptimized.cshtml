@model crmHuman.Pages.BaseModel2
<!DOCTYPE html>
<html lang="vi">
<head>
    @await Html.PartialAsync("_LayoutHeadResources")
    <style>
        :root {
            --primary: #98181c;
            --text: #495057;
            --bg: #fff;
        }

        body {
            font-family: system-ui, -apple-system, sans-serif;
            margin: 0;
            background: var(--bg);
        }

        .loading {
            opacity: .5;
            pointer-events: none;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @Html.AntiForgeryToken()

    <header id="header" class="header fixed-top d-flex align-items-center">
        <div class="d-flex align-items-center justify-content-between">
            <a href="~/" class="logo d-flex align-items-center">
                <img src="~/assets/img/logo.png" alt="crmHuman logo" loading="lazy" asp-append-version="true">
            </a>
            <button class="btn btn-link toggle-sidebar-btn" type="button" aria-label="Toggle sidebar">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <nav class="header-nav ms-auto" aria-label="Main navigation">
            <ul class="d-flex align-items-center mb-0">
                <li class="nav-item d-block d-lg-none">
                    <a class="nav-link nav-icon search-bar-toggle" href="#" aria-label="Search">
                        <i class="bi bi-search"></i>
                    </a>
                </li>
                <li class="nav-item dropdown pe-3">
                    <a class="nav-link nav-profile d-flex align-items-center pe-0"
                       href="#"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        <span class="d-none d-md-block dropdown-toggle ps-2">@Model.UserData?.FullName</span>
                    </a>
                </li>
            </ul>
        </nav>
    </header>

    <aside id="sidebar" class="sidebar">
        @await Html.PartialAsync("_RoleSidebar", Model)
    </aside>

    <main id="main" class="main">
        @RenderBody()
    </main>

    <footer id="footer" class="footer">
        <div class="copyright">
            &copy; 2025 <strong><span>crmHuman</span></strong>. All Rights Reserved
        </div>
    </footer>

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center" aria-label="Back to top">
        <i class="bi bi-arrow-up-short"></i>
    </a>

    @await Html.PartialAsync("_LayoutScripts")
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        window.addEventListener('load', function () {
            if ('performance' in window) {
                const { timing } = window.performance;
                const pageLoadTime = timing.loadEventEnd - timing.navigationStart;
                console.log('Page load time:', pageLoadTime + 'ms');
            }
        });
    </script>
</body>
</html>
