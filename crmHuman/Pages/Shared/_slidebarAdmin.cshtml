@model crmHuman.Pages.BaseModel2
@{
    var unreadNotificationCount = Model?.HeaderUnreadNotificationCount ?? 0;
    var canOpenLeaveApproval = Model.HasViewPermission("LeaveApproval") || Model.HasApprovePermission("LeaveApproval");
    var canOpenLeaveRequest = Model.HasViewPermission("LeaveRequest");
    var canOpenLeaveBalance = Model.HasViewPermission("LeaveBalance");
    var canOpenAttendance = Model.HasViewPermission("Attendance");
    var canOpenLateEarlyRequest = Model.HasViewPermission("LateEarlyRequest");
    var canOpenLateEarlyApproval = Model.HasApprovePermission("LateEarlyApproval");
    var canOpenEmployee = Model.HasViewPermission("Employee");
    var canOpenGroupPage = Model.HasViewPermission("GroupPage");
    var canOpenContract = Model.HasViewPermission("Contract");
    var canOpenCandidate = Model.HasViewPermission("Candidate");
    var canOpenScheduleInterview = Model.HasViewPermission("ScheduleInterview");
    var canOpenInternalNews = Model.HasViewPermission("InternalNews");
    var canOpenFormTemplate = Model.HasViewPermission("FormTemplate");
    var canOpenMeetingRoom = Model.HasViewPermission("MeetingRoom");
    var canOpenSupportRequest = Model.HasViewPermission("SupportRequest");
    var canOpenSupportProcessing = Model.HasViewPermission("SupportRequestProcessing");
    var canOpenReportAnalytics = Model.HasViewPermission("ReportAnalytics");
    var canOpenCloudStorage = Model.HasViewPermission("CloudStorage");
    var canOpenSystem = Model.HasViewPermission("System");
    var canOpenMailSetting = Model.HasViewPermission("MailSetting");
    var canOpenSipManagement = Model.HasViewPermission("SipManagement");
    var canOpenMailGroup = Model.HasViewPermission("MailGroup");
    var canOpenPermission = Model.HasViewPermission("Permission");

    var showPriorityPanel =
        unreadNotificationCount > 0
        || canOpenLeaveApproval
        || canOpenLeaveRequest
        || canOpenLateEarlyApproval
        || canOpenAttendance
        || canOpenEmployee
        || canOpenCandidate;
}

<aside id="sidebar" class="sidebar sidebar-admin">
    @if (showPriorityPanel)
    {
        <div class="sidebar-priority-panel">
            <div class="sidebar-priority-head">
                <span class="sidebar-priority-kicker">Ưu tiên</span>
                <strong>Luồng hay dùng</strong>
            </div>
            <div class="sidebar-priority-links">
                <a class="sidebar-priority-link" href="/Notifications">
                    <i class="bi bi-bell"></i>
                    <span>Thông báo</span>
                    @if (unreadNotificationCount > 0)
                    {
                        <strong class="sidebar-link-badge">@((unreadNotificationCount > 99) ? "99+" : unreadNotificationCount.ToString())</strong>
                    }
                </a>

                @if (canOpenLeaveApproval)
                {
                    <a class="sidebar-priority-link is-primary" href="/Leave/LeaveApproval">
                        <i class="bi bi-check2-square"></i>
                        <span>Hộp duyệt nghỉ phép</span>
                    </a>
                }
                else if (canOpenLeaveRequest)
                {
                    <a class="sidebar-priority-link is-primary" href="/Leave/LeaveRequest">
                        <i class="bi bi-calendar2-plus"></i>
                        <span>Đăng ký nghỉ phép</span>
                    </a>
                }

                @if (canOpenLateEarlyApproval)
                {
                    <a class="sidebar-priority-link" href="/LateEarly/Approval">
                        <i class="bi bi-clock-history"></i>
                        <span>Duyệt đi trễ/về sớm</span>
                    </a>
                }
                else if (canOpenAttendance)
                {
                    <a class="sidebar-priority-link" href="/Attendance">
                        <i class="bi bi-calendar3"></i>
                        <span>Tổng hợp chấm công</span>
                    </a>
                }

                @if (canOpenEmployee)
                {
                    <a class="sidebar-priority-link" href="/Employee">
                        <i class="bi bi-people"></i>
                        <span>Danh sách nhân viên</span>
                    </a>
                }
                else if (canOpenCandidate)
                {
                    <a class="sidebar-priority-link" href="/Candidate">
                        <i class="bi bi-person-workspace"></i>
                        <span>Danh sách ứng viên</span>
                    </a>
                }
            </div>
        </div>
    }

    <ul class="sidebar-nav sidebar-nav-enhanced" id="sidebar-nav">
        @if (Model.HasViewPermission("Dashboard"))
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/">
                    <i class="bi bi-pie-chart-fill"></i>
                    <span>Bảng điều khiển</span>
                </a>
            </li>
        }

        @if (canOpenLeaveApproval || canOpenLeaveRequest || canOpenLeaveBalance || canOpenAttendance || canOpenLateEarlyRequest || canOpenLateEarlyApproval)
        {
            <li class="nav-heading">Điều hành</li>
        }

        @if (canOpenLeaveApproval || canOpenLeaveRequest || canOpenLeaveBalance)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" data-bs-target="#leave-nav" data-bs-toggle="collapse" href="#">
                    <i class="bi bi-umbrella"></i><span>Nghỉ phép</span><i class="bi bi-chevron-down ms-auto"></i>
                </a>
                <ul id="leave-nav" class="nav-content collapse" data-bs-parent="#sidebar-nav">
                    @if (canOpenLeaveApproval)
                    {
                        <li>
                            <a href="/Leave/LeaveApproval">
                                <i class="bi bi-check2-circle"></i><span>Duyệt nghỉ phép</span>
                            </a>
                        </li>
                    }
                    @if (canOpenLeaveRequest)
                    {
                        <li>
                            <a href="/Leave/LeaveRequest">
                                <i class="bi bi-pencil-square"></i><span>Đăng ký nghỉ phép</span>
                            </a>
                        </li>
                    }
                    @if (canOpenLeaveBalance)
                    {
                        <li>
                            <a href="/Leave/LeaveBalance">
                                <i class="bi bi-calculator"></i><span>Quản lý ngày phép</span>
                            </a>
                        </li>
                    }
                </ul>
            </li>
        }

        @if (canOpenAttendance || canOpenLateEarlyRequest || canOpenLateEarlyApproval)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" data-bs-target="#attendance-nav" data-bs-toggle="collapse" href="#">
                    <i class="bi bi-calendar-check-fill"></i><span>Chấm công</span><i class="bi bi-chevron-down ms-auto"></i>
                </a>
                <ul id="attendance-nav" class="nav-content collapse" data-bs-parent="#sidebar-nav">
                    @if (canOpenLateEarlyApproval)
                    {
                        <li>
                            <a href="/LateEarly/Approval">
                                <i class="bi bi-check2-square"></i><span>Duyệt đi trễ/về sớm</span>
                            </a>
                        </li>
                    }
                    @if (canOpenLateEarlyRequest)
                    {
                        <li>
                            <a href="/LateEarly/Request">
                                <i class="bi bi-clock"></i><span>Đăng ký đi trễ/về sớm</span>
                            </a>
                        </li>
                    }
                    @if (canOpenAttendance)
                    {
                        <li>
                            <a href="/Attendance">
                                <i class="bi bi-calendar3"></i><span>Tổng hợp chấm công</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Attendance/CheckInOut">
                                <i class="bi bi-fingerprint"></i><span>Lịch sử quẹt thẻ/điểm danh</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Attendance/Schedule">
                                <i class="bi bi-calendar-week"></i><span>Ca kíp và lịch làm việc</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Attendance/Rules">
                                <i class="bi bi-journal-check"></i><span>Quy tắc đi trễ/về sớm/OT</span>
                            </a>
                        </li>
                    }
                </ul>
            </li>
        }

        @if (canOpenEmployee || canOpenGroupPage || canOpenContract)
        {
            <li class="nav-heading">Nhân sự</li>
            <li class="nav-item">
                <a class="nav-link collapsed" data-bs-target="#employee-nav" data-bs-toggle="collapse" href="#">
                    <i class="bi bi-person-vcard"></i><span>Quản lý nhân viên</span><i class="bi bi-chevron-down ms-auto"></i>
                </a>
                <ul id="employee-nav" class="nav-content collapse" data-bs-parent="#sidebar-nav">
                    @if (canOpenEmployee)
                    {
                        <li>
                            <a href="/Employee">
                                <i class="bi bi-person-lines-fill"></i><span>Danh sách nhân viên</span>
                            </a>
                        </li>
                    }
                    @if (canOpenGroupPage)
                    {
                        <li>
                            <a href="/GroupPage">
                                <i class="bi bi-diagram-3"></i><span>Danh sách nhóm</span>
                            </a>
                        </li>
                    }
                    @if (canOpenContract)
                    {
                        <li>
                            <a href="/Contract">
                                <i class="bi bi-file-earmark-person"></i><span>Hợp đồng lao động</span>
                            </a>
                        </li>
                    }
                </ul>
            </li>
        }

        @if (canOpenCandidate || canOpenScheduleInterview)
        {
            <li class="nav-heading">Tuyển dụng</li>
        }

        @if (canOpenScheduleInterview)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/ScheduleInterview">
                    <i class="bi bi-calendar2-check"></i>
                    <span>Lịch phỏng vấn</span>
                </a>
            </li>
        }

        @if (canOpenCandidate)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" data-bs-target="#candidate-nav" data-bs-toggle="collapse" href="#">
                    <i class="bi bi-people"></i><span>Quản lý ứng viên</span><i class="bi bi-chevron-down ms-auto"></i>
                </a>
                <ul id="candidate-nav" class="nav-content collapse" data-bs-parent="#sidebar-nav">
                    <li>
                        <a href="/Candidate">
                            <i class="bi bi-person-lines-fill"></i><span>Danh sách ứng viên</span>
                        </a>
                    </li>
                </ul>
            </li>
        }

        @if (canOpenInternalNews || canOpenFormTemplate || canOpenMeetingRoom || canOpenSupportRequest || canOpenSupportProcessing || canOpenReportAnalytics || canOpenCloudStorage || Model?.UserData?.RoleCode != "1" || Model?.UserData?.RoleCode == "2")
        {
            <li class="nav-heading">Tiện ích chung</li>
        }

        @if (canOpenInternalNews)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/InternalNews">
                    <i class="bi bi-newspaper"></i>
                    <span>Tin nội bộ</span>
                </a>
            </li>
        }

        @if (canOpenFormTemplate)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/FormTemplate">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Biểu mẫu</span>
                </a>
            </li>
        }

        @if (canOpenMeetingRoom)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/Meeting">
                    <i class="bi bi-door-open"></i>
                    <span>Đặt phòng họp</span>
                </a>
            </li>
        }

        @if (canOpenSupportRequest)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/SupportRequest/Request">
                    <i class="bi bi-headset"></i>
                    <span>Yêu cầu hỗ trợ</span>
                </a>
            </li>
        }

        @if (canOpenSupportProcessing)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/SupportRequest/Processing">
                    <i class="bi bi-list-check"></i>
                    <span>Xử lý yêu cầu</span>
                </a>
            </li>
        }

        @if (canOpenReportAnalytics)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/ReportAnalytics">
                    <i class="bi bi-graph-up"></i>
                    <span>Báo cáo và phân tích</span>
                </a>
            </li>
        }

        @if (canOpenCloudStorage)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/Cloud/Storage">
                    <i class="bi bi-cloud-check"></i>
                    <span>Kho tài liệu</span>
                </a>
            </li>
        }

        @if (Model?.UserData?.RoleCode != "1")
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/Setting">
                    <i class="bi bi-gear"></i>
                    <span>Cài đặt cá nhân</span>
                </a>
            </li>
        }

        @if (Model?.UserData?.RoleCode == "2")
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/EmployeeInfo">
                    <i class="bi bi-person-badge"></i>
                    <span>Hồ sơ của tôi</span>
                </a>
            </li>
        }

        @if (canOpenSystem || canOpenMailSetting || canOpenSipManagement || canOpenMailGroup || canOpenPermission)
        {
            <li class="nav-heading">Quản trị hệ thống</li>
        }

        @if (canOpenSystem)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" data-bs-target="#master-nav" data-bs-toggle="collapse" href="#">
                    <i class="bi bi-database"></i><span>Master data</span><i class="bi bi-chevron-down ms-auto"></i>
                </a>
                <ul id="master-nav" class="nav-content collapse" data-bs-parent="#sidebar-nav">
                    <li><a href="/MasterDataPage?Type=loai-hdld"><i class="bi bi-folder2-open"></i><span>Loại HĐLĐ</span></a></li>
                    <li><a href="/MasterDataPage?Type=vi-tri-viec-lam"><i class="bi bi-person-badge"></i><span>Vị trí việc làm</span></a></li>
                    <li><a href="/MasterDataPage?Type=phong-ban"><i class="bi bi-building"></i><span>Phòng ban</span></a></li>
                    <li><a href="/MasterDataPage?Type=quan-he-nguoi-than"><i class="bi bi-people"></i><span>Quan hệ người thân</span></a></li>
                    <li><a href="/MasterDataPage?Type=trang-thai-ho-so"><i class="bi bi-file-earmark-bar-graph"></i><span>Trạng thái hồ sơ</span></a></li>
                    <li><a href="/MasterDataPage?Type=trang-thai-lam-viec"><i class="bi bi-briefcase"></i><span>Trạng thái làm việc</span></a></li>
                    <li><a href="/MasterDataPage?Type=trang-thai-hon-nhan"><i class="bi bi-suit-heart"></i><span>Trạng thái hôn nhân</span></a></li>
                    <li><a href="/MasterDataPage?Type=trinh-do-hoc-van"><i class="bi bi-mortarboard"></i><span>Trình độ học vấn</span></a></li>
                    <li><a href="/MasterDataPage?Type=dan-toc"><i class="bi bi-globe-central-south-asia"></i><span>Dân tộc</span></a></li>
                    <li><a href="/MasterDataPage?Type=trang-thai-chung-tu"><i class="bi bi-file-earmark-check"></i><span>Trạng thái chứng từ</span></a></li>
                    <li><a href="/MasterDataPage?Type=Loai-chung-tu"><i class="bi bi-files"></i><span>Loại chứng từ</span></a></li>
                    <li><a href="/StatusPage"><i class="bi bi-card-list"></i><span>Danh sách trạng thái</span></a></li>
                </ul>
            </li>

            <li class="nav-item">
                <a class="nav-link collapsed" href="/Setting">
                    <i class="bi bi-gear-wide-connected"></i><span>Cài đặt hệ thống</span>
                </a>
            </li>
        }

        @if (canOpenMailSetting)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/System/MailSetting">
                    <i class="bi bi-envelope-at"></i><span>Cấu hình mail</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link collapsed" href="/System/MailHistory">
                    <i class="bi bi-envelope-check"></i><span>Lịch sử mail</span>
                </a>
            </li>
        }

        @if (canOpenSipManagement)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/System/SipManagement">
                    <i class="bi bi-telephone-forward"></i><span>Cấu hình SIP</span>
                </a>
            </li>
        }

        @if (canOpenMailGroup)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/System/MailGroup">
                    <i class="bi bi-collection"></i><span>Nhóm mail</span>
                </a>
            </li>
        }

        @if (canOpenPermission)
        {
            <li class="nav-item">
                <a class="nav-link collapsed" href="/System/Permission">
                    <i class="bi bi-shield-lock"></i><span>Quản lý phân quyền</span>
                </a>
            </li>
        }

        <li class="nav-item">
            <a class="nav-link collapsed" onclick="logout()" href="javascript:void(0)">
                <i class="bi bi-box-arrow-right"></i><span>Đăng xuất tài khoản</span>
            </a>
        </li>
    </ul>
</aside>
