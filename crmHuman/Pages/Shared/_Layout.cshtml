@model crmHuman.Pages.BaseModel2
@{
    var profileLink = Model?.UserData?.RoleCode == "CANDIDATE" ? "/Candidate/Profile" : "/Infomation";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    @{
    }
    @await Html.PartialAsync("_LayoutHeadResources")
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @Html.AntiForgeryToken()

    <header id="header" class="header fixed-top d-flex align-items-center">
        <div class="d-flex align-items-center justify-content-between">
            <a href="~/" class="logo d-flex align-items-center">
                <img src="~/assets/img/logo.png" alt="crmHuman logo" asp-append-version="true">
            </a>
            <button class="btn btn-link toggle-sidebar-btn" type="button" aria-label="Toggle sidebar">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <nav class="header-nav ms-auto" aria-label="User navigation">
            <ul class="d-flex align-items-center mb-0">
                <li class="nav-item d-block d-lg-none">
                    <a class="nav-link nav-icon search-bar-toggle" href="#" aria-label="Toggle search">
                        <i class="bi bi-search"></i>
                    </a>
                </li>
                <li class="nav-item dropdown pe-3">
                    <a class="nav-link nav-profile d-flex align-items-center pe-0"
                       href="#"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        <img src="~/assets/img/profile-img.jpg" alt="Profile" class="rounded-circle" asp-append-version="true">
                        <span class="d-none d-md-block dropdown-toggle ps-2">@Model.UserData?.FullName</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                        <li class="dropdown-header text-center">
                            <h6 class="mb-0">@Model.UserData?.UserName</h6>
                            <small class="text-muted">
                                @(Model.UserData?.UserName == "VS061" ? "HCNS" : Model.UserData?.RoleName)
                            </small>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center" href="@profileLink">
                                <i class="bi bi-person me-2"></i>
                                <span>Thông tin cá nhân</span>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center" type="button" onclick="logout()">
                                <i class="bi bi-box-arrow-right me-2"></i>
                                <span>Đăng xuất</span>
                            </button>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>
    </header>

    <aside id="sidebar" class="sidebar">
        @await Html.PartialAsync("_RoleSidebar", Model)
    </aside>

    <main id="main" class="main">
        @RenderBody()

        <form method="post" asp-page="Index" asp-page-handler="LogOut" class="d-none">
            <input type="submit" id="logoutSubmit">
        </form>
    </main>

    <footer id="footer" class="footer">
        <div class="credits">
            Designed by <a href="javascript:void(0)">Vietstar</a>
        </div>
    </footer>

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center" aria-label="Back to top">
        <i class="bi bi-arrow-up-short"></i>
    </a>

    @await Html.PartialAsync("_LayoutScripts")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
