@using global::System.Linq
@using global::System.Text.Json
@inject global::Microsoft.Extensions.Configuration.IConfiguration Configuration
@model crmHuman.Pages.BaseModel2
@{
    var profileLink = Model?.UserData?.RoleCode == "CANDIDATE" ? "/Candidate/Profile" : "/Infomation";
    var logoPath = string.IsNullOrWhiteSpace(Model?.LogoPath) ? "/assets/img/logo.png" : Model.LogoPath;
    var themeStyle = Model?.ThemeStyle ?? string.Empty;
    var avatarPath = string.IsNullOrWhiteSpace(Model?.UserData?.AvatarFile) ? "/assets/img/profile-img.jpg" : Model.UserData.AvatarFile;
    var roleLabel = Model?.UserData?.UserName == "VS061" ? "HCNS" : Model?.UserData?.RoleName;
    var pageTitle = ViewData["Title"] as string ?? "crmHuman";
    var recordingPlaybackBaseUrl = Configuration["Telephony:RecordingPlaybackBaseUrl"] ?? string.Empty;
    var canOpenLeaveApproval = Model != null && (Model.HasViewPermission("LeaveApproval") || Model.HasApprovePermission("LeaveApproval"));
    var canOpenLeaveRequest = Model != null && Model.HasViewPermission("LeaveRequest");
    var canOpenLateEarlyApproval = Model != null && Model.HasApprovePermission("LateEarlyApproval");
    var canOpenAttendance = Model != null && Model.HasViewPermission("Attendance");
    var canOpenEmployee = Model != null && Model.HasViewPermission("Employee");
    var canOpenCandidate = Model != null && Model.HasViewPermission("Candidate");
    var canOpenInternalNews = Model != null && Model.HasViewPermission("InternalNews");
    var canOpenCloudStorage = Model != null && Model.HasViewPermission("CloudStorage");
    var unreadNotificationCount = Model?.HeaderUnreadNotificationCount ?? 0;

    var headerShortcuts = new global::System.Collections.Generic.List<(string Href, string Icon, string Label, string ShortcutKey, string Badge)>();
    headerShortcuts.Add(("/", "bi bi-grid-1x2", "Trang chủ", "1", string.Empty));
    headerShortcuts.Add(("/Notifications", "bi bi-bell", "Thông báo", "2", unreadNotificationCount > 0 ? (unreadNotificationCount > 99 ? "99+" : unreadNotificationCount.ToString()) : string.Empty));

    if (canOpenLeaveApproval)
    {
        headerShortcuts.Add(("/Leave/LeaveApproval", "bi bi-check2-square", "Hộp duyệt", "3", string.Empty));
    }
    else if (canOpenLeaveRequest)
    {
        headerShortcuts.Add(("/Leave/LeaveRequest", "bi bi-calendar2-plus", "Nghỉ phép", "3", string.Empty));
    }

    if (canOpenLateEarlyApproval)
    {
        headerShortcuts.Add(("/LateEarly/Approval", "bi bi-clock-history", "Duyệt công", "4", string.Empty));
    }
    else if (canOpenAttendance)
    {
        headerShortcuts.Add(("/Attendance", "bi bi-calendar3", "Chấm công", "4", string.Empty));
    }

    if (canOpenEmployee)
    {
        headerShortcuts.Add(("/Employee", "bi bi-people", "Nhân sự", "5", string.Empty));
    }
    else if (canOpenCandidate)
    {
        headerShortcuts.Add(("/Candidate", "bi bi-person-workspace", "Tuyển dụng", "5", string.Empty));
    }

    if (canOpenInternalNews)
    {
        headerShortcuts.Add(("/InternalNews", "bi bi-megaphone", "Tin nội bộ", "6", string.Empty));
    }
    else if (canOpenCloudStorage)
    {
        headerShortcuts.Add(("/Cloud/Storage", "bi bi-cloud-check", "Tài liệu", "6", string.Empty));
    }

    var headerPrimaryShortcuts = headerShortcuts.Take(4).ToList();
    var headerOverflowShortcuts = headerShortcuts.Skip(4).ToList();
    var headerShortcutConfig = headerShortcuts.Select(item => new
    {
        key = item.ShortcutKey,
        href = item.Href,
        label = item.Label
    }).ToList();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    @{
    }
    @await Html.PartialAsync("_LayoutHeadResources")
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-shell" style="@themeStyle">
    @Html.AntiForgeryToken()

    <header id="header" class="header fixed-top d-flex align-items-center">
        <div class="header-brand-group d-flex align-items-center">
            <button class="btn btn-link toggle-sidebar-btn shell-icon-btn" type="button" aria-label="Toggle sidebar">
                <i class="bi bi-list"></i>
            </button>
            <a href="~/" class="logo d-flex align-items-center app-brand">
                <img src="@logoPath" alt="crmHuman logo" asp-append-version="true">
                <span class="app-brand-copy d-none d-sm-flex">
                    <small class="app-brand-kicker">HR workspace</small>
                    <strong>crmHuman</strong>
                </span>
            </a>
        </div>

        <div class="header-page-meta d-none d-xl-flex">
            <span class="header-page-kicker">Hệ thống nhân sự</span>
            <span class="header-page-title">@pageTitle</span>
        </div>

        @if (headerPrimaryShortcuts.Count > 0)
        {
            <div class="header-shortcuts d-none d-xl-flex">
                @foreach (var shortcut in headerPrimaryShortcuts)
                {
                    <a class="header-shortcut-link"
                       href="@shortcut.Href"
                       data-shortcut-key="@shortcut.ShortcutKey"
                       title="@($"{shortcut.Label} (Alt+{shortcut.ShortcutKey})")">
                        <i class="@shortcut.Icon"></i>
                        <span>@shortcut.Label</span>
                        <small class="header-shortcut-hint">Alt+@shortcut.ShortcutKey</small>
                        @if (!string.IsNullOrWhiteSpace(shortcut.Badge))
                        {
                            <strong class="header-shortcut-badge">@shortcut.Badge</strong>
                        }
                    </a>
                }

                @if (headerOverflowShortcuts.Count > 0)
                {
                    <div class="dropdown">
                        <button class="btn btn-link header-shortcut-overflow"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-label="Truy cập nhanh">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow quick-actions-dropdown">
                            <li class="dropdown-header">
                                <strong>Truy cập nhanh</strong>
                                <small class="d-block text-muted">Mở nhanh các luồng hay dùng</small>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var shortcut in headerOverflowShortcuts)
                            {
                                <li>
                                    <a class="dropdown-item quick-actions-item"
                                       href="@shortcut.Href"
                                       data-shortcut-key="@shortcut.ShortcutKey">
                                        <i class="@shortcut.Icon"></i>
                                        <span>@shortcut.Label</span>
                                        <small class="quick-actions-hint">Alt+@shortcut.ShortcutKey</small>
                                        @if (!string.IsNullOrWhiteSpace(shortcut.Badge))
                                        {
                                            <strong class="header-shortcut-badge">@shortcut.Badge</strong>
                                        }
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }

        <nav class="header-nav ms-auto" aria-label="User navigation">
            <ul class="d-flex align-items-center mb-0">
                @if (headerShortcuts.Count > 0)
                {
                    <li class="nav-item dropdown d-xl-none pe-2">
                        <a class="nav-link nav-icon header-quick-actions-toggle"
                           href="#"
                           data-bs-toggle="dropdown"
                           aria-expanded="false"
                           aria-label="Truy cập nhanh">
                            <i class="bi bi-grid"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow quick-actions-dropdown">
                            <li class="dropdown-header">
                                <strong>Truy cập nhanh</strong>
                                <small class="d-block text-muted">Nhấn Alt + số để mở nhanh</small>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var shortcut in headerShortcuts)
                            {
                                <li>
                                    <a class="dropdown-item quick-actions-item"
                                       href="@shortcut.Href"
                                       data-shortcut-key="@shortcut.ShortcutKey">
                                        <i class="@shortcut.Icon"></i>
                                        <span>@shortcut.Label</span>
                                        <small class="quick-actions-hint">Alt+@shortcut.ShortcutKey</small>
                                        @if (!string.IsNullOrWhiteSpace(shortcut.Badge))
                                        {
                                            <strong class="header-shortcut-badge">@shortcut.Badge</strong>
                                        }
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }

                <li class="nav-item d-block d-lg-none">
                    <a class="nav-link nav-icon search-bar-toggle" href="#" aria-label="Toggle search">
                        <i class="bi bi-search"></i>
                    </a>
                </li>
                <li class="nav-item dropdown notification-nav-item pe-3">
                    <a class="nav-link nav-icon position-relative"
                       href="#"
                       data-bs-toggle="dropdown"
                       aria-expanded="false"
                       aria-label="Thông báo">
                        <i class="bi bi-bell"></i>
                        @if (unreadNotificationCount > 0)
                        {
                            <span class="badge rounded-pill bg-danger notification-counter">
                                @(unreadNotificationCount > 99 ? "99+" : unreadNotificationCount.ToString())
                            </span>
                        }
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow notifications notification-dropdown">
                        <li class="dropdown-header d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <strong>Thông báo</strong>
                                <small class="d-block text-muted">@unreadNotificationCount chưa đọc</small>
                            </div>
                            <a class="btn btn-sm btn-outline-primary" href="/Notifications">Mở trung tâm</a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        @if (Model.HeaderNotifications.Count == 0)
                        {
                            <li class="px-3 py-2 text-muted small">Chưa có thông báo nào.</li>
                        }
                        else
                        {
                            foreach (var notif in Model.HeaderNotifications)
                            {
                                var isUnread = !notif.IsRead;
                                var isActionRequired = string.Equals(notif.Category, "ACTION_REQUIRED", global::System.StringComparison.OrdinalIgnoreCase);
                                var isInternalNews = string.Equals(notif.RelatedEntityType, "INTERNAL_NEWS", global::System.StringComparison.OrdinalIgnoreCase)
                                    || (!string.IsNullOrWhiteSpace(notif.Link) && notif.Link.StartsWith("/InternalNews", global::System.StringComparison.OrdinalIgnoreCase));
                                var badgeClass = isActionRequired ? "bg-danger" : isInternalNews ? "bg-info text-dark" : "bg-secondary";
                                var badgeText = isActionRequired ? "Cần xử lý" : isInternalNews ? "Tin nội bộ" : "Thông báo";
                                <li>
                                    <a class="dropdown-item notification-dropdown-item @(isUnread ? "notification-dropdown-item-unread" : string.Empty)"
                                       href="/Notifications?handler=Open&id=@notif.Id">
                                        <div class="d-flex flex-column gap-1">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="badge @badgeClass">@badgeText</span>
                                                @if (notif.DueAt.HasValue)
                                                {
                                                    <span class="small text-muted">Hạn @notif.DueAt.Value.ToString("dd/MM HH:mm")</span>
                                                }
                                            </div>
                                            <div class="small notification-dropdown-message">@notif.Message</div>
                                            <div class="small text-muted">@notif.CreateAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        </div>
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </li>
                <li class="nav-item dropdown pe-3">
                    <a class="nav-link nav-profile d-flex align-items-center pe-0"
                       href="#"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        <span class="header-user-meta d-none d-md-flex">
                            <span class="header-user-name">@Model.UserData?.FullName</span>
                            <span class="header-user-role">@roleLabel</span>
                        </span>
                        <img src="@avatarPath" alt="Profile" class="rounded-circle" asp-append-version="true">
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                        <li class="dropdown-header text-center">
                            <h6 class="mb-0">@Model.UserData?.UserName</h6>
                            <small class="text-muted">@roleLabel</small>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center" href="@profileLink">
                                <i class="bi bi-person me-2"></i>
                                <span>Thông tin cá nhân</span>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center" type="button" onclick="logout()">
                                <i class="bi bi-box-arrow-right me-2"></i>
                                <span>Đăng xuất</span>
                            </button>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>
    </header>

    @await Html.PartialAsync("_RoleSidebar", Model)

    <main id="main" class="main">
        @RenderBody()

        <form method="post" asp-page="/Index" asp-page-handler="LogOut" class="d-none">
            <input type="submit" id="logoutSubmit">
        </form>
    </main>

    <footer id="footer" class="footer">
        <div class="credits">
            <span>crmHuman</span>
            <span class="footer-separator"></span>
            <span>Nền tảng quản trị nhân sự nội bộ</span>
        </div>
    </footer>

    <style>
        .notification-nav-item .nav-icon {
            font-size: 1.1rem;
        }

        .notification-counter {
            position: absolute;
            top: 2px;
            right: -6px;
            font-size: 0.65rem;
        }

        .notification-dropdown {
            width: min(420px, calc(100vw - 24px));
            max-height: 70vh;
            overflow-y: auto;
        }

        .notification-dropdown-item {
            white-space: normal;
            padding-top: 0.85rem;
            padding-bottom: 0.85rem;
        }

        .notification-dropdown-item-unread {
            background: #f8fafc;
        }

        .notification-dropdown-message {
            color: #111827;
            line-height: 1.4;
        }
    </style>

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center" aria-label="Back to top">
        <i class="bi bi-arrow-up-short"></i>
    </a>

    @await Html.PartialAsync("_LayoutScripts")
    <script>
        window.crmAppSettings = Object.assign({}, window.crmAppSettings, {
            recordingPlaybackBaseUrl: @Html.Raw(JsonSerializer.Serialize(recordingPlaybackBaseUrl)),
            headerShortcuts: @Html.Raw(JsonSerializer.Serialize(headerShortcutConfig))
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
