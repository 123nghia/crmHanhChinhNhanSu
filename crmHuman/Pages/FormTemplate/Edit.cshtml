@page
@model crmHuman.Pages.FormTemplate.EditModel
@{
    ViewData["Title"] = Model.TitlePage;
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chu</a></li>
            <li class="breadcrumb-item"><a href="/FormTemplate">Bieu mau</a></li>
            <li class="breadcrumb-item active">@(Model.IsEditMode ? "Chinh sua" : "Them moi")</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Template.Id" />
                        <input type="hidden" asp-for="Template.FileName" />
                        <input type="hidden" asp-for="Template.FilePath" />
                        <input type="hidden" asp-for="Template.FileSize" />
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label" for="Template_Title">Tieu de</label>
                            <input class="form-control" asp-for="Template.Title" maxlength="250" required />
                            <span asp-validation-for="Template.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="Template_Content">Noi dung</label>
                            <textarea class="form-control tinymce-editor" asp-for="Template.Content"></textarea>
                        </div>

                        @if (Model.IsEditMode && !string.IsNullOrWhiteSpace(Model.Template.FilePath))
                        {
                            <div class="mb-3">
                                <label class="form-label">File hien tai</label>
                                <div>
                                    <a href="@Model.Template.FilePath" target="_blank">@Model.Template.FileName</a>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label" for="UploadFile">Tai file</label>
                            <input class="form-control" type="file" id="UploadFile" name="UploadFile" />
                            <div class="form-text">Neu khong chon file moi, he thong giu file hien tai.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Luu</button>
                            @if (Model.IsEditMode)
                            {
                                <a class="btn btn-outline-secondary" href="/FormTemplate/Detail?Id=@Model.Template.Id">Huy</a>
                            }
                            else
                            {
                                <a class="btn btn-outline-secondary" href="/FormTemplate">Huy</a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
