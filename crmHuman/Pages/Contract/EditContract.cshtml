@{
    var contract = Model.Contract as dynamic;
    var contractTypes = Model.ContractTypes as IEnumerable<dynamic>;
    var employees = Model.Employees as IEnumerable<dynamic>;
    var statusSuggestions = Model.StatusSuggestions as IEnumerable<string>;
    var isNew = contract == null || contract.Id < 1;
    var startDate = "";
    var endDate = "";
    if (contract != null && contract.StartDate != null)
    {
        startDate = ((DateTime)contract.StartDate).ToString("yyyy-MM-dd");
    }
    if (contract != null && contract.EndDate != null)
    {
        endDate = ((DateTime)contract.EndDate).ToString("yyyy-MM-dd");
    }
}

<div class="modal-header">
    <h5 class="modal-title">@(isNew ? "Thêm hợp đồng" : "Cập nhật hợp đồng")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <form id="contractForm" class="needs-validation" novalidate>
        <div class="col-12 form-group">
            <label class="form-label">Nhân viên</label>
            <select id="cbEmployeeId" class="form-select">
                <option value="">Chọn nhân viên</option>
                @foreach (var emp in employees)
                {
                    if (contract != null && contract.EmployeeId == emp.Id)
                    {
                        <option selected value="@emp.Id">@emp.UserName - @emp.FullName</option>
                    }
                    else
                    {
                        <option value="@emp.Id">@emp.UserName - @emp.FullName</option>
                    }
                }
            </select>
            <div class="invalid-feedback-cs"></div>
        </div>

        <div class="col-12 form-group">
            <label class="form-label">Loại hợp đồng</label>
            <select id="cbContractType" class="form-select">
                <option value="">Chọn loại</option>
                @foreach (var type in contractTypes)
                {
                    if (contract != null && contract.ContractTypeCode == type.Code)
                    {
                        <option selected value="@type.Code">@type.Name</option>
                    }
                    else
                    {
                        <option value="@type.Code">@type.Name</option>
                    }
                }
            </select>
            <div class="invalid-feedback-cs"></div>
        </div>

        <div class="row">
            <div class="col-6 form-group">
                <label class="form-label">Ngày bắt đầu</label>
                <input type="date" id="dtStartDate" class="form-control" value="@startDate" />
            </div>
            <div class="col-6 form-group">
                <label class="form-label">Ngày kết thúc</label>
                <input type="date" id="dtEndDate" class="form-control" value="@endDate" />
            </div>
        </div>

        <div class="col-12 form-group">
            <label class="form-label">Trạng thái</label>
            <input type="text" id="txtStatus" class="form-control" list="contractStatusList" value="@(contract?.Status ?? "")" />
            <datalist id="contractStatusList">
                @foreach (var status in statusSuggestions)
                {
                    <option value="@status"></option>
                }
            </datalist>
        </div>

        <div class="col-12 form-group">
            <label class="form-label">Ghi chú</label>
            <textarea id="txtNote" class="form-control" style="height: 100px">@(contract?.Note ?? "")</textarea>
        </div>

        @if (isNew)
        {
            <div class="col-12 form-group">
                <label class="form-label">File hợp đồng</label>
                <input type="file" id="fileContract" class="form-control" />
                <div class="invalid-feedback-cs"></div>
            </div>
        }
        else
        {
            <div class="col-12 form-group">
                <label class="form-label">File hợp đồng</label>
                @if (!string.IsNullOrWhiteSpace(contract?.FileUrl))
                {
                    <div>
                        <a href="@contract.FileUrl" target="_blank">Tải về</a>
                    </div>
                }
                <small class="text-muted">File hợp đồng không thay đổi sau khi tạo.</small>
            </div>
        }
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
    <button type="button" class="btn btn-primary" onclick="saveContract(@(contract?.Id ?? -1))">Lưu</button>
</div>
