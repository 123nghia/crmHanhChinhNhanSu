@{
    var history = Model as IEnumerable<dynamic>;
}

<div class="modal-header">
    <h5 class="modal-title">Lich su hop dong</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Thoi gian</th>
                <th>Hanh dong</th>
                <th>Loai hop dong</th>
                <th>Ngay bat dau</th>
                <th>Ngay ket thuc</th>
                <th>Trạng thái</th>
                <th>Người ký</th>
                <th>Thoi diem ky</th>
                <th>Ghi chu</th>
            </tr>
        </thead>
        <tbody>
            @if (history != null)
            {
                foreach (var item in history)
                {
                    var createdText = "";
                    if (item.CreateAt != null)
                    {
                        createdText = item.CreateAt.ToString("dd/MM/yyyy HH:mm");
                    }
                    var startText = "";
                    var endText = "";
                    var signedAtText = "";
                    var signedByText = "";
                    var hrSignedAtText = "";
                    var hrSignedByText = "";
                    var employeeSignedAtText = "";
                    var employeeSignedByText = "";
                    if (item.StartDate != null)
                    {
                        startText = item.StartDate.ToString("dd/MM/yyyy");
                    }
                    if (item.EndDate != null)
                    {
                        endText = item.EndDate.ToString("dd/MM/yyyy");
                    }
                    if (item.HrSignedAt != null)
                    {
                        hrSignedAtText = item.HrSignedAt.ToString("dd/MM/yyyy HH:mm");
                    }
                    if (!string.IsNullOrWhiteSpace(item.HrSignedByUserName))
                    {
                        hrSignedByText = item.HrSignedByUserName;
                        if (!string.IsNullOrWhiteSpace(item.HrSignedByFullName))
                        {
                            hrSignedByText += " - " + item.HrSignedByFullName;
                        }
                    }
                    if (item.SignedAt != null)
                    {
                        employeeSignedAtText = item.SignedAt.ToString("dd/MM/yyyy HH:mm");
                    }
                    if (!string.IsNullOrWhiteSpace(item.SignedByUserName))
                    {
                        employeeSignedByText = item.SignedByUserName;
                        if (!string.IsNullOrWhiteSpace(item.SignedByFullName))
                        {
                            employeeSignedByText += " - " + item.SignedByFullName;
                        }
                    }
                    if (!string.IsNullOrWhiteSpace(hrSignedByText))
                    {
                        signedByText = "HR: " + hrSignedByText;
                    }
                    if (!string.IsNullOrWhiteSpace(employeeSignedByText))
                    {
                        signedByText = string.IsNullOrWhiteSpace(signedByText)
                            ? "NV: " + employeeSignedByText
                            : signedByText + " | NV: " + employeeSignedByText;
                    }
                    if (!string.IsNullOrWhiteSpace(hrSignedAtText))
                    {
                        signedAtText = "HR: " + hrSignedAtText;
                    }
                    if (!string.IsNullOrWhiteSpace(employeeSignedAtText))
                    {
                        signedAtText = string.IsNullOrWhiteSpace(signedAtText)
                            ? "NV: " + employeeSignedAtText
                            : signedAtText + " | NV: " + employeeSignedAtText;
                    }
                    <tr>
                        <td>@createdText</td>
                        <td>@item.Action</td>
                        <td>@item.ContractTypeName</td>
                        <td>@startText</td>
                        <td>@endText</td>
                        <td>@item.Status</td>
                        <td>@signedByText</td>
                        <td>@signedAtText</td>
                        <td>
                            @item.Note
                            @if (!string.IsNullOrWhiteSpace(item.SignNote))
                            {
                                <div class="small text-muted">@item.SignNote</div>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Dong</button>
</div>
