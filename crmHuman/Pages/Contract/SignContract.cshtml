@{
    var contract = Model.Contract as dynamic;
    var canSignHr = Model.CanSignHr != null && (bool)Model.CanSignHr;
    var canSignEmployee = Model.CanSignEmployee != null && (bool)Model.CanSignEmployee;
    var isHrSigned = contract != null && contract.IsHrSigned == true;
    var isSignedInternal = contract != null && contract.IsSignedInternal == true;
    var canShowForm = (canSignHr && !isHrSigned) || (canSignEmployee && isHrSigned && !isSignedInternal);

    var signedAtText = string.Empty;
    if (contract != null && contract.SignedAt != null)
    {
        signedAtText = contract.SignedAt.ToString("dd/MM/yyyy HH:mm");
    }

    var signerDisplay = string.Empty;
    if (contract != null)
    {
        if (!string.IsNullOrWhiteSpace((string?)contract.SignedByUserNameSnapshot))
        {
            signerDisplay = contract.SignedByUserNameSnapshot;
            if (!string.IsNullOrWhiteSpace((string?)contract.SignedByFullNameSnapshot))
            {
                signerDisplay += " - " + contract.SignedByFullNameSnapshot;
            }
        }
        else if (!string.IsNullOrWhiteSpace((string?)contract.SignedByUserName))
        {
            signerDisplay = contract.SignedByUserName;
            if (!string.IsNullOrWhiteSpace((string?)contract.SignedByFullName))
            {
                signerDisplay += " - " + contract.SignedByFullName;
            }
        }
    }

    var hrSignedAtText = string.Empty;
    if (contract != null && contract.HrSignedAt != null)
    {
        hrSignedAtText = contract.HrSignedAt.ToString("dd/MM/yyyy HH:mm");
    }

    var hrSignerDisplay = string.Empty;
    if (contract != null)
    {
        if (!string.IsNullOrWhiteSpace((string?)contract.HrSignedByUserNameSnapshot))
        {
            hrSignerDisplay = contract.HrSignedByUserNameSnapshot;
            if (!string.IsNullOrWhiteSpace((string?)contract.HrSignedByFullNameSnapshot))
            {
                hrSignerDisplay += " - " + contract.HrSignedByFullNameSnapshot;
            }
        }
        else if (!string.IsNullOrWhiteSpace((string?)contract.HrSignedByUserName))
        {
            hrSignerDisplay = contract.HrSignedByUserName;
            if (!string.IsNullOrWhiteSpace((string?)contract.HrSignedByFullName))
            {
                hrSignerDisplay += " - " + contract.HrSignedByFullName;
            }
        }
    }

    var signedIpAddress = contract?.SignedIpAddress?.ToString() ?? string.Empty;
    var signedUserAgent = contract?.SignedUserAgent?.ToString() ?? string.Empty;
    var signedFileArchivePath = contract?.SignedFileArchivePath?.ToString() ?? string.Empty;
    var signatureImagePath = contract?.SignatureImagePath?.ToString() ?? string.Empty;
    var signatureIntentText = contract?.SignatureIntentText?.ToString() ?? string.Empty;

    var hrSignedIpAddress = contract?.HrSignedIpAddress?.ToString() ?? string.Empty;
    var hrSignedUserAgent = contract?.HrSignedUserAgent?.ToString() ?? string.Empty;

    var dialogTitle = "Thông tin ký hợp đồng";
    if (canSignHr && !isHrSigned)
    {
        dialogTitle = "Ký HR hợp đồng";
    }
    else if (canSignEmployee && isHrSigned && contract != null && contract.IsSignedInternal != true)
    {
        dialogTitle = "Ký nhân viên";
    }
}

<div class="modal-header">
    <h5 class="modal-title">@dialogTitle</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    @if (contract == null || contract.Id < 1)
    {
        <div class="alert alert-danger mb-0">Không tìm thấy hợp đồng.</div>
    }
    else if (isSignedInternal)
    {
        <div class="alert alert-success">
            Hợp đồng đã được nhân viên ký nội bộ.
            @if (!string.IsNullOrWhiteSpace(signedAtText))
            {
                <div class="mt-2">Thời gian ký: <strong>@signedAtText</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(signerDisplay))
            {
                <div>Người ký: <strong>@signerDisplay</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(signatureIntentText))
            {
                <div class="mt-2">Ý chí đồng ý: <strong>@signatureIntentText</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(signedIpAddress))
            {
                <div>IP lúc ký: <strong>@signedIpAddress</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(signedUserAgent))
            {
                <div class="text-break">User-Agent: <strong>@signedUserAgent</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(signedFileArchivePath))
            {
                <div class="text-break">Bản sao đã ký: <a href="@signedFileArchivePath" target="_blank">Mở file đã ký</a></div>
            }
            @if (!string.IsNullOrWhiteSpace(signatureImagePath))
            {
                <div class="text-break">Ảnh chữ ký: <a href="@signatureImagePath" target="_blank">Mở ảnh chữ ký</a></div>
            }
        </div>

        @if (isHrSigned)
        {
            <div class="alert alert-success mt-2">
                HR đã ký hợp đồng.
                @if (!string.IsNullOrWhiteSpace(hrSignedAtText))
                {
                    <div class="mt-2">Thời gian ký HR: <strong>@hrSignedAtText</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(hrSignerDisplay))
                {
                    <div>Người ký HR: <strong>@hrSignerDisplay</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(hrSignedIpAddress))
                {
                    <div>IP HR lúc ký: <strong>@hrSignedIpAddress</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(hrSignedUserAgent))
                {
                    <div class="text-break">User-Agent HR: <strong>@hrSignedUserAgent</strong></div>
                }
            </div>
        }
    }
    else
    {
        if (isHrSigned)
        {
            <div class="alert alert-success">
                HR đã ký hợp đồng.
                @if (!string.IsNullOrWhiteSpace(hrSignedAtText))
                {
                    <div class="mt-2">Thời gian ký HR: <strong>@hrSignedAtText</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(hrSignerDisplay))
                {
                    <div>Người ký HR: <strong>@hrSignerDisplay</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(hrSignedIpAddress))
                {
                    <div>IP HR lúc ký: <strong>@hrSignedIpAddress</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(hrSignedUserAgent))
                {
                    <div class="text-break">User-Agent HR: <strong>@hrSignedUserAgent</strong></div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                Hợp đồng chưa được HR ký.
            </div>
        }

        @if (!canShowForm)
        {
            if (!isHrSigned)
            {
                <div class="alert alert-warning mb-0">Bạn không có quyền ký HR hợp đồng này.</div>
            }
            else
            {
                <div class="alert alert-info mb-0">Chờ nhân viên ký hợp đồng.</div>
            }
        }
        else
        {
            <form id="signContractForm" class="needs-validation" novalidate>
                <div class="col-12 form-group">
                    <label class="form-label">Nhân viên</label>
                    <input type="text" class="form-control" value="@($"{contract.UserName} - {contract.FullName}")" readonly />
                </div>

                <div class="col-12 form-group mt-2">
                    <label class="form-label">File hợp đồng</label>
                    @if (!string.IsNullOrWhiteSpace((string?)contract.FileUrl))
                    {
                        <div>
                            <a href="@contract.FileUrl" target="_blank">Mở file hợp đồng</a>
                        </div>
                    }
                    else
                    {
                        <div class="text-danger">Hợp đồng chưa có file.</div>
                    }
                </div>

                @if (canSignEmployee && isHrSigned)
                {
                    <div class="alert alert-warning mt-3">
                        <div class="fw-bold mb-2">Điều khoản ký hợp đồng nội bộ</div>
                        <div>Tôi xác nhận chính tôi là người ký, đã đọc, hiểu, đồng ý với nội dung hợp đồng và đồng ý ký điện tử nội bộ cho hợp đồng này.</div>
                        <div class="mt-2 small">
                            Hệ thống sẽ đóng dấu chữ ký lên bản archive của file đã ký đối với PDF và file ảnh. Các định dạng khác sẽ lưu kèm ảnh chữ ký để truy vết.
                        </div>
                    </div>

                    <div class="col-12 form-group mt-3">
                        <label class="form-label">Chữ ký nhân viên <span class="text-danger">*</span></label>
                        <div class="border rounded bg-white p-2">
                            <canvas id="contractSignatureCanvas" width="520" height="180" style="width:100%;max-width:100%;border:1px dashed #ced4da;border-radius:8px;touch-action:none;"></canvas>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearContractSignaturePad()">Xóa chữ ký</button>
                        </div>
                        <div class="small text-muted mt-1">Nhân viên ky truc tiep tren o ben tren bang chuot, but cam ung hoac ngon tay.</div>
                        <div class="invalid-feedback-cs"></div>
                    </div>

                    <div class="form-group form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="cbContractAcceptTerms" />
                        <label class="form-check-label" for="cbContractAcceptTerms">
                            Tôi đã đọc, hiểu và đồng ý với điều khoản ký nội bộ đối với hợp đồng này.
                        </label>
                        <div class="invalid-feedback-cs"></div>
                    </div>
                }
                else if (canSignHr && !isHrSigned)
                {
                    <div class="alert alert-info mt-3">
                        HR xác nhận ký nội bộ cho hợp đồng này bằng tài khoản và mật khẩu đăng nhập hiện tại.
                    </div>
                }

                <div class="col-12 form-group mt-3">
                    <label class="form-label">Mã ký nội bộ (tùy chọn)</label>
                    <input type="text" id="txtSignatureCode" class="form-control" maxlength="100" placeholder="VD: TOI_DONG_Y_KY_HOP_DONG" />
                </div>

                <div class="col-12 form-group mt-2">
                    <label class="form-label">Mật khẩu xác nhận <span class="text-danger">*</span></label>
                    <input type="password" id="txtSignPassword" class="form-control" maxlength="100" autocomplete="off" />
                    <div class="invalid-feedback-cs"></div>
                </div>

                <div class="col-12 form-group mt-2">
                    <label class="form-label">Ghi chú ký (tùy chọn)</label>
                    <textarea id="txtSignNote" class="form-control" style="height: 90px" maxlength="500"></textarea>
                </div>
            </form>
        }
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
    @if (contract != null && contract.Id > 0 && contract.IsSignedInternal != true)
    {
        if (canSignHr && !isHrSigned)
        {
            <button type="button" class="btn btn-primary" onclick="signContract(@contract.Id)">Ky HR</button>
        }
        else if (canSignEmployee && isHrSigned)
        {
            <button type="button" class="btn btn-primary" onclick="signContract(@contract.Id)">Ký nhân viên</button>
        }
    }
</div>
