@page
@model crmHuman.Pages.InternalNews.EditModel
@{
    ViewData["Title"] = Model.TitlePage;
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/InternalNews">Tin nội bộ</a></li>
            <li class="breadcrumb-item active">Chỉnh sửa</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Thông tin bài viết</h5>
                    <form method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="News.Id" />
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label" for="News_Title">Tiêu đề</label>
                            <input class="form-control" asp-for="News.Title" maxlength="200" required />
                            <span asp-validation-for="News.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="News_Content">Nội dung</label>
                            <textarea class="form-control tinymce-editor" asp-for="News.Content"></textarea>
                            <span asp-validation-for="News.Content" class="text-danger"></span>
                        </div>

                        @if (Model.News.Attachments?.Count > 0)
                        {
                            <div class="mb-3">
                                <label class="form-label">File đính kèm hiện tại</label>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var attachment in Model.News.Attachments)
                                    {
                                        <li>
                                            <i class="bi bi-paperclip me-1"></i>
                                            <a href="@attachment.FilePath" target="_blank">@attachment.FileName</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label" for="AttachmentFiles">Thêm file đính kèm</label>
                            <input class="form-control" type="file" id="AttachmentFiles" name="AttachmentFiles" multiple />
                            <div class="form-text">Có thể chọn nhiều file.</div>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="News.IsSendMail" />
                            <label class="form-check-label" for="News_IsSendMail">
                                Gửi mail thông báo (làm sau)
                            </label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Lưu bài viết</button>
                            <a class="btn btn-outline-secondary" href="/InternalNews/Detail?Id=@Model.News.Id">Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
