@page
@model crmHuman.Pages.InternalNews.DetailModel
@{
    ViewData["Title"] = "Chi tiết tin nội bộ";
    var createdAt = Model.NewsItem?.CreateAt != default(DateTime)
        ? Model.NewsItem.CreateAt.ToString("dd/MM/yyyy - HH:mm")
        : "";
}

<div class="pagetitle">
    <h1>Tin nội bộ</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/InternalNews">Tin nội bộ</a></li>
            <li class="breadcrumb-item active">Chi tiết</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["WarningMessage"] != null)
                    {
                        <div class="alert alert-warning mt-3">@TempData["WarningMessage"]</div>
                    }

                    <article class="internal-news-detail">
                        <h2 class="internal-news-detail-title">@Model.NewsItem?.Title</h2>
                        <div class="internal-news-detail-meta">@createdAt</div>

                        <div class="internal-news-detail-content mt-3">
                            @Html.Raw(Model.NewsItem?.Content ?? "")
                        </div>

                        @if (Model.NewsItem?.Attachments?.Count > 0)
                        {
                            <div class="internal-news-attachments mt-4">
                                <div class="internal-news-subtitle">Các file đính kèm:</div>
                                <ul class="internal-news-attachments-list">
                                    @foreach (var attachment in Model.NewsItem.Attachments)
                                    {
                                        <li>
                                            <i class="bi bi-paperclip me-1"></i>
                                            <a href="@attachment.FilePath" target="_blank">@attachment.FileName</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.RelatedNews?.Count > 0)
                        {
                            <div class="internal-news-related mt-4">
                                <div class="internal-news-subtitle">Bài viết liên quan</div>
                                <ul class="internal-news-related-list">
                                    @foreach (var related in Model.RelatedNews)
                                    {
                                        var relatedDate = related.CreateAt != default(DateTime)
                                            ? related.CreateAt.ToString("dd/MM/yyyy")
                                            : "";
                                        <li>
                                            <a href="/InternalNews/Detail?Id=@related.Id">@related.Title</a>
                                            <span>(@relatedDate)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </article>

                    <div class="mt-3 d-flex gap-2 flex-wrap">
                        @if (Model.CanEdit)
                        {
                            <a class="btn btn-primary btn-sm" href="/InternalNews/Edit?Id=@Model.NewsItem?.Id">Chỉnh sửa</a>
                        }
                        @if (Model.CanDelete)
                        {
                            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.NewsItem?.Id" class="d-inline" onsubmit="return confirm('Xóa thông báo?');">
                                <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                            </form>
                        }
                        <a class="btn btn-outline-secondary btn-sm" href="/InternalNews">Quay lại</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .internal-news-detail-title {
            color: #c11d1d;
            font-weight: 700;
            font-size: 1.5rem;
            margin-bottom: 4px;
        }

        .internal-news-detail-meta {
            color: #666;
            font-size: 0.9rem;
        }

        .internal-news-detail-content {
            line-height: 1.6;
        }

        .internal-news-detail-content img {
            max-width: 100%;
            height: auto;
        }

        .internal-news-detail-content table {
            max-width: 100%;
        }

        .internal-news-subtitle {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .internal-news-attachments-list,
        .internal-news-related-list {
            list-style: none;
            padding-left: 0;
            margin: 0;
        }

        .internal-news-attachments-list li,
        .internal-news-related-list li {
            margin: 6px 0;
        }

        .internal-news-attachments-list a,
        .internal-news-related-list a {
            color: #1b66d1;
            text-decoration: none;
        }

        .internal-news-attachments-list a:hover,
        .internal-news-related-list a:hover {
            text-decoration: underline;
        }

        .internal-news-related-list li::before {
            content: "›";
            color: #d93025;
            margin-right: 8px;
        }
    </style>
}
