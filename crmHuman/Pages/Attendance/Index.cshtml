@page
@model crmHuman.Pages.Attendance.IndexModel
@{
    ViewData["Title"] = Model.TitlePage;
    var canImport = Model.Permision?.Add ?? false;
    var summary = Model.SelectedSummary;
    var monthValue = Model.SelectedMonth;
    var isTcRole = Model.IsTcRole;
    var employeeSummaryCount = 0;

    if (Model.SummaryItems != null)
    {
        foreach (var _ in Model.SummaryItems)
        {
            employeeSummaryCount++;
        }
    }
}

@section Styles
{
    <style>
        .attendance-summary-card {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 12px 14px;
            background: #f8f9fa;
            height: 100%;
        }

        .attendance-summary-card .label {
            color: #6c757d;
            font-size: 0.85rem;
        }

        .attendance-summary-card .value {
            font-size: 1.25rem;
            font-weight: 600;
        }

        .attendance-summary-row.active {
            background-color: #eef2ff;
        }

        .attendance-calendar {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: 8px;
        }

        .attendance-day-cell {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 8px;
            min-height: 90px;
            background: #fff;
        }

        .attendance-day-cell.attendance-day-off {
            background: #fff2f2;
            border-color: #f1b0b7;
            box-shadow: inset 0 0 0 1px #f8d7da;
        }

        .attendance-day-number {
            font-weight: 600;
            font-size: 0.9rem;
        }

        .attendance-day-meta {
            font-size: 0.75rem;
            color: #6c757d;
        }

        .attendance-badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 6px;
            font-size: 0.72rem;
            font-weight: 600;
        }

        .attendance-row-absent {
            background-color: #fdecec;
        }

        .attendance-row-scheduled-off {
            background-color: #fff2f2;
        }

        .attendance-row-half-day {
            background-color: #fff7e6;
        }

        .attendance-row-leave {
            background-color: #ecfdf3;
        }

        .attendance-row-holiday {
            background-color: #eff6ff;
        }

        .attendance-cell-late {
            background-color: #fff3cd;
            font-weight: 600;
        }

        .attendance-cell-early {
            background-color: #dbeafe;
            font-weight: 600;
        }

        .attendance-cell-absent {
            background-color: #f8d7da;
            font-weight: 600;
        }

        .attendance-cell-off {
            background-color: #fde2e4;
            font-weight: 600;
            color: #b42318;
        }

        .attendance-cell-half-day {
            background-color: #ffe7c2;
            font-weight: 600;
            color: #9a3412;
        }

        .attendance-cell-leave {
            background-color: #dcfce7;
            font-weight: 600;
            color: #166534;
        }

        .attendance-cell-holiday {
            background-color: #dbeafe;
            font-weight: 600;
            color: #1d4ed8;
        }

        .attendance-day-cell.attendance-day-half-day {
            background: #fff7e6;
            border-color: #fdba74;
            box-shadow: inset 0 0 0 1px #fed7aa;
        }

        .attendance-day-cell.attendance-day-leave {
            background: #ecfdf3;
            border-color: #86efac;
            box-shadow: inset 0 0 0 1px #bbf7d0;
        }

        .attendance-day-cell.attendance-day-holiday {
            background: #eff6ff;
            border-color: #93c5fd;
            box-shadow: inset 0 0 0 1px #bfdbfe;
        }

        .attendance-note-list {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }

        .attendance-note-chip,
        .attendance-note-link {
            display: inline-flex;
            align-items: center;
            max-width: 100%;
            padding: 3px 8px;
            border-radius: 999px;
            font-size: 0.74rem;
            line-height: 1.25;
            text-decoration: none;
        }

        .attendance-note-chip {
            background: #eef2ff;
            color: #1e3a8a;
        }

        .attendance-note-link {
            background: #eff6ff;
            color: #1d4ed8;
            font-weight: 600;
        }

        .attendance-note-link:hover {
            background: #dbeafe;
            color: #1e40af;
        }

        .attendance-note-empty {
            color: #9ca3af;
            font-size: 0.78rem;
        }

        .attendance-summary-row.active > td {
            background: #eef4ff !important;
        }

        .attendance-summary-row .table-metric-group {
            gap: 6px;
        }

        .attendance-summary-row .table-metric-card {
            min-width: 68px;
            padding: 6px 8px;
        }

        .attendance-summary-row .table-metric-card strong {
            font-size: 14px;
        }

        .attendance-detail-table .table-metric-group {
            gap: 6px;
        }

        .attendance-detail-table .table-metric-card {
            min-width: 62px;
            padding: 6px 8px;
        }

        .attendance-detail-table .table-info-chip {
            margin-right: 4px;
        }

        .attendance-summary-toolbar {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        @@media (max-width: 768px) {
            .attendance-col-shift {
                display: none;
            }

            #attendanceDetailTableWrapper .table th,
            #attendanceDetailTableWrapper .table td {
                white-space: nowrap;
                font-size: 0.82rem;
                padding: 0.45rem;
            }

            #attendanceDetailTableWrapper .attendance-note-list {
                min-width: 180px;
            }

            .attendance-day-cell {
                min-height: 76px;
                padding: 6px;
            }
        }
    </style>
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Chấm công</li>
        </ol>
    </nav>
</div>

<section class="section admin-page-shell">
    <div class="admin-hero-panel">
        <div class="admin-hero-copy">
            <span class="admin-hero-kicker">Chấm công</span>
            <h2 class="admin-hero-title">Tổng hợp công theo nhóm thông tin, không còn bảng dài khó quét.</h2>
            <p class="admin-hero-subtitle">Danh sách nhân sự được gom lại theo 5 nhóm chính: người, tổ chức, hiệu suất, vi phạm và thao tác. Phần chi tiết ngày công cũng được rút về các cụm dữ liệu dễ đọc hơn.</p>
        </div>
        <div class="admin-hero-side">
            <div class="admin-hero-note">
                <strong>Tháng theo dõi</strong>
                <span>@monthValue và @employeeSummaryCount nhân sự đang có trong danh sách tổng hợp của bộ lọc hiện tại.</span>
            </div>
            @if (Model.SyncStatus?.HasData == true)
            {
                <div class="admin-hero-note">
                    <strong>Đồng bộ gần nhất</strong>
                    <span>@(Model.SyncStatus.LastSyncedAt.HasValue ? Model.SyncStatus.LastSyncedAt.Value.ToString("dd/MM/yyyy HH:mm:ss") : "Chưa có dữ liệu")</span>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @Html.AntiForgeryToken()

            <div class="attendance-summary-toolbar mb-3">
                <div class="admin-list-copy">
                    <span class="admin-list-kicker">Bộ lọc tổng hợp</span>
                    <h5 class="admin-list-title mb-0">Tra cứu nhanh chấm công</h5>
                    <p class="admin-list-note">Chọn tháng, nhân sự hoặc từ khóa để rút bảng tổng hợp về đúng tập dữ liệu cần xem.</p>
                </div>
                <div class="admin-list-meta">
                    <span class="admin-meta-chip">
                        <strong>@employeeSummaryCount</strong>
                        <span>nhân sự hiển thị</span>
                    </span>
                </div>
            </div>

            <form class="row g-3 align-items-end" method="get">
                <div class="col-md-3">
                    <label class="form-label">Tháng</label>
                    <input type="hidden" id="attendanceMonthInput" name="month" value="@monthValue" />
                    <input type="hidden" id="attendanceFingerprintInput" name="fingerprintCode" value="@Model.RequestSearch.FingerprintCode" />
                    <input type="text" class="form-control" id="attendanceMonthDisplay" placeholder="MM/YYYY" autocomplete="off" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Nhân viên</label>
                    @if (isTcRole)
                    {
                        <input type="hidden" id="attendanceEmployeeId" name="employeeId" value="@Model.SelectedEmployeeId" />
                        <input type="text" class="form-control" value="@(summary?.FullName ?? Model.UserData?.FullName)" disabled />
                    }
                    else
                    {
                        <select class="form-select" name="employeeId" id="attendanceEmployeeSelect">
                            <option value="">-- Tất cả --</option>
                            @foreach (var item in Model.SummaryItems)
                            {
                                var isSelected = item.EmployeeId > 0
                                    ? item.EmployeeId == Model.SelectedEmployeeId
                                    : Model.SelectedEmployeeId <= 0
                                        && !string.IsNullOrWhiteSpace(Model.SelectedFingerprintCode)
                                        && string.Equals(item.FingerprintCode, Model.SelectedFingerprintCode, StringComparison.OrdinalIgnoreCase);
                                <option value="@item.EmployeeId" data-fingerprint="@item.FingerprintCode" selected="@(isSelected ? "selected" : null)">@item.FullName (@item.FingerprintCode)</option>
                            }
                        </select>
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label">Từ khóa</label>
                    <input type="text" class="form-control" id="attendanceTokenInput" name="token" value="@Model.RequestSearch.Token" placeholder="Tên, mã vân tay" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Xem</button>
                    <button type="button" class="btn btn-outline-success w-100" onclick="submitAttendanceExport()">Xuất Excel</button>
                    @* Ẩn nút import theo yêu cầu *@
                </div>
            </form>

            <form id="attendanceExportForm" method="post" asp-page-handler="Export">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Month" id="exportMonth" />
                <input type="hidden" name="EmployeeId" id="exportEmployeeId" />
                <input type="hidden" name="FingerprintCode" id="exportFingerprintCode" />
                <input type="hidden" name="Token" id="exportToken" />
            </form>

            @if (Model.SyncStatus?.HasData == true)
            {
                <div class="alert alert-light border mt-3 mb-0">
                    <div><strong>Last update</strong></div>
                    @if (!string.IsNullOrWhiteSpace(Model.SyncStatus.ModeText))
                    {
                        <div class="small text-muted">Nguồn: @Model.SyncStatus.ModeText</div>
                    }
                    @if (Model.SyncStatus.LatestLogTime.HasValue)
                    {
                        <div class="small text-muted">Log mới nhất: @Model.SyncStatus.LatestLogTime.Value.ToString("dd/MM/yyyy HH:mm:ss")</div>
                    }
                    @if (Model.SyncStatus.LastSyncedAt.HasValue)
                    {
                        <div class="small text-muted">Đồng bộ gần nhất: @Model.SyncStatus.LastSyncedAt.Value.ToString("dd/MM/yyyy HH:mm:ss")</div>
                    }
                    @if (Model.SyncStatus.AttendanceLastUpdatedAt.HasValue)
                    {
                        <div class="small text-muted">Bảng công cập nhật lần cuối: @Model.SyncStatus.AttendanceLastUpdatedAt.Value.ToString("dd/MM/yyyy HH:mm:ss")</div>
                    }
                    @if (Model.SyncStatus.AttendanceThroughDate.HasValue)
                    {
                        <div class="small text-muted">Dữ liệu công đang tới ngày: @Model.SyncStatus.AttendanceThroughDate.Value.ToString("dd/MM/yyyy")</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.SyncStatus.ErrorMessage))
                    {
                        <div class="small text-danger">@Model.SyncStatus.ErrorMessage</div>
                    }
                </div>
            }

            <div class="row g-3 mt-3" id="attendanceSummaryCards">
                <div class="col-md-3">
                    <div class="attendance-summary-card">
                        <div class="label">Tổng công</div>
                        <div class="value" id="summaryWorkDays">@((summary?.TotalWorkDays ?? 0).ToString("0.##"))</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="attendance-summary-card">
                        <div class="label">Ngày nghỉ</div>
                        <div class="value" id="summaryOffCount">@((summary?.OffCount ?? 0).ToString())</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="attendance-summary-card">
                        <div class="label">Đi trễ (lần)</div>
                        <div class="value" id="summaryLateCount">@((summary?.LateCount ?? 0).ToString())</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="attendance-summary-card">
                        <div class="label">Ra sớm (lần)</div>
                        <div class="value" id="summaryEarlyCount">@((summary?.EarlyCount ?? 0).ToString())</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="attendance-summary-card">
                        <div class="label">Trễ (phút)</div>
                        <div class="value" id="summaryLateMinutes">@((summary?.LateMinutes ?? 0).ToString())</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="attendance-summary-card">
                        <div class="label">Sớm (phút)</div>
                        <div class="value" id="summaryEarlyMinutes">@((summary?.EarlyMinutes ?? 0).ToString())</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="attendance-summary-card">
                        <div class="label">Tổng giờ</div>
                        <div class="value" id="summaryTotalHours">@((summary?.TotalHours ?? 0).ToString("0.##"))</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="attendance-summary-card">
                        <div class="label">Giờ công</div>
                        <div class="value" id="summaryWorkHours">@((summary?.TotalWorkHours ?? 0).ToString("0.##"))</div>
                    </div>
                </div>
            </div>

            <div class="table-responsive admin-table-scroll mt-4">
                <table class="table table-striped table-admin-compact" id="attendanceSummaryTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nhân sự</th>
                            <th>Tổ chức</th>
                            <th>Hiệu suất</th>
                            <th>Vi phạm và nghỉ</th>
                            <th class="text-center">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 0;
                        }
                        @foreach (var item in Model.SummaryItems)
                        {
                            index++;
                            var isActive = item.EmployeeId > 0
                                ? item.EmployeeId == Model.SelectedEmployeeId
                                : Model.SelectedEmployeeId <= 0
                                    && !string.IsNullOrWhiteSpace(Model.SelectedFingerprintCode)
                                    && string.Equals(item.FingerprintCode, Model.SelectedFingerprintCode, StringComparison.OrdinalIgnoreCase);
                            <tr class="attendance-summary-row @(isActive ? "active" : string.Empty)"
                                data-employee-id="@item.EmployeeId"
                                data-fingerprint="@item.FingerprintCode"
                                data-full-name="@item.FullName"
                                data-work-days="@item.TotalWorkDays"
                                data-off-count="@item.OffCount"
                                data-late-count="@item.LateCount"
                                data-early-count="@item.EarlyCount"
                                data-late-minutes="@item.LateMinutes"
                                data-early-minutes="@item.EarlyMinutes"
                                data-total-hours="@item.TotalHours"
                                data-work-hours="@item.TotalWorkHours">
                                <td class="text-nowrap">@index</td>
                                <td>
                                    <div class="table-stack">
                                        <div class="table-stack-title">@item.FullName</div>
                                        <div class="table-stack-subtitle">Mã vân tay: @(string.IsNullOrWhiteSpace(item.FingerprintCode) ? "Chưa cập nhật" : item.FingerprintCode)</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="table-stack">
                                        <div class="table-stack-title">@(string.IsNullOrWhiteSpace(item.DepartmentText) ? "Chưa cập nhật bộ phận" : item.DepartmentText)</div>
                                        <div class="table-stack-subtitle">@(string.IsNullOrWhiteSpace(item.PositionText) ? "Chưa cập nhật vị trí" : item.PositionText)</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="table-metric-group">
                                        <div class="table-metric-card">
                                            <strong>@((item.TotalWorkDays ?? 0).ToString("0.##"))</strong>
                                            <span>Công</span>
                                        </div>
                                        <div class="table-metric-card">
                                            <strong>@((item.TotalWorkHours ?? 0).ToString("0.##"))</strong>
                                            <span>Giờ công</span>
                                        </div>
                                        <div class="table-metric-card">
                                            <strong>@((item.TotalHours ?? 0).ToString("0.##"))</strong>
                                            <span>Tổng giờ</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="table-stack">
                                        <div class="table-metric-group">
                                            <div class="table-metric-card">
                                                <strong>@((item.OffCount ?? 0).ToString())</strong>
                                                <span>Nghỉ</span>
                                            </div>
                                            <div class="table-metric-card">
                                                <strong>@((item.LateCount ?? 0).ToString())</strong>
                                                <span>Trễ</span>
                                            </div>
                                            <div class="table-metric-card">
                                                <strong>@((item.EarlyCount ?? 0).ToString())</strong>
                                                <span>Sớm</span>
                                            </div>
                                        </div>
                                        <div class="table-stack-meta">
                                            <span class="table-info-chip is-warning">Trễ @((item.LateMinutes ?? 0).ToString()) phút</span>
                                            <span class="table-info-chip">Sớm @((item.EarlyMinutes ?? 0).ToString()) phút</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="selectAttendanceEmployee(this)">Xem</button>
                                </td>
                            </tr>
                        }
                        @if (index == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center">Không có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
                <h5 class="card-title mb-0">Chi tiết chấm công</h5>
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary active" id="attendanceTableViewBtn" onclick="toggleAttendanceView('table')">Bảng</button>
                    <button type="button" class="btn btn-outline-secondary" id="attendanceCalendarViewBtn" onclick="toggleAttendanceView('calendar')">Lịch</button>
                </div>
            </div>

            <div id="attendanceDetailHint" class="text-muted mb-2">Chọn nhân viên để xem chi tiết.</div>

            <div class="table-responsive admin-table-scroll d-none" id="attendanceDetailTableWrapper">
                <table class="table table-sm table-striped table-admin-compact attendance-detail-table">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Chấm công</th>
                            <th>Kết quả</th>
                            <th>Vi phạm và ký hiệu</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody id="attendanceDetailBody"></tbody>
                </table>
            </div>

            <div id="attendanceCalendarWrapper" class="d-none">
                <div class="attendance-calendar" id="attendanceCalendar"></div>
            </div>
        </div>
    </div>
</section>

@if (canImport)
{
    <div class="modal fade" id="attendanceImportModal" tabindex="-1" aria-labelledby="attendanceImportLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="attendanceImportLabel">Import chấm công</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="attendanceImportForm" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Chọn file Excel (.xlsx)</label>
                            <input type="file" name="FileRequest" class="form-control" accept=".xlsx" required />
                        </div>
                    </form>
                    <div class="text-muted small">
                        Mã nhân viên trong file sẽ được map theo mã vân tay.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary" onclick="submitAttendanceImport()">Import</button>
                </div>
            </div>
        </div>
    </div>
}

<div id="attendanceMeta"
     data-selected-id="@Model.SelectedEmployeeId"
     data-selected-fingerprint="@Model.SelectedFingerprintCode"
     data-month="@Model.SelectedMonth"></div>

<script src="/js/pages/attendance.js?v=@DateTime.Now.Ticks"></script>
