@page
@model crmHuman.Pages.Attendance.ScheduleModel
@{
    ViewData["Title"] = Model.TitlePage;
}

@section Styles
{
    <style>
        .attendance-rule-card {
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            background: #fff;
        }

        .attendance-rule-note {
            font-size: 0.9rem;
            color: #6b7280;
        }

        .attendance-rule-time {
            font-weight: 600;
            color: #0f172a;
        }
    </style>
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Attendance">Chấm công</a></li>
            <li class="breadcrumb-item active">Ca kíp / lịch làm việc</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="card">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <h5 class="card-title mb-1">Thiết lập giờ làm việc theo bộ phận</h5>
                    <div class="attendance-rule-note">
                        Admin cấu hình giờ vào làm, giờ nghỉ trưa, giờ vào lại và giờ tan làm cho từng bộ phận.
                        Hệ thống sẽ dùng mốc này để kết luận đi trễ, về sớm, số giờ công, 1/2 công, nghỉ phép, nghỉ không phép và nghỉ lễ.
                    </div>
                </div>
                @if (Model.CanManageRules)
                {
                    <form method="post" asp-page-handler="RunEvaluation" class="d-inline">
                        <button type="submit" class="btn btn-outline-primary">Chạy đánh giá lại tháng này</button>
                    </form>
                }
            </div>

            <div class="alert alert-info mt-3 mb-0">
                Hệ thống tự chốt lại dữ liệu chấm công mỗi ngày sau 21:00. Nút trên dùng để chạy lại ngay khi vừa đổi cấu hình.
            </div>

            @if (!string.IsNullOrWhiteSpace(TempData["ErrorMessage"] as string))
            {
                <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
            }

            @if (!string.IsNullOrWhiteSpace(TempData["SuccessMessage"] as string))
            {
                <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
            }

            @if (Model.CanManageRules)
            {
                <div class="attendance-rule-card p-3 mt-4">
                    <form method="post" asp-page-handler="SaveRule" class="row g-3">
                        <input type="hidden" name="RuleForm.Id" value="@Model.RuleForm.Id" />

                        <div class="col-md-4">
                            <label class="form-label">Bộ phận</label>
                            <select class="form-select" name="RuleForm.DepartmentCode" required>
                                <option value="">-- Chọn bộ phận --</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    if (Model.RuleForm.DepartmentCode == dept.Code)
                                    {
                                        <option value="@dept.Code" selected>@dept.Name (@dept.Code)</option>
                                    }
                                    else
                                    {
                                        <option value="@dept.Code">@dept.Name (@dept.Code)</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Giờ vào làm</label>
                            <input type="time" class="form-control" name="RuleForm.WorkStartTime" value="@Model.FormatTime(Model.RuleForm.WorkStartTime)" step="60" required />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Giờ nghỉ trưa</label>
                            <input type="time" class="form-control" name="RuleForm.LunchStartTime" value="@Model.FormatTime(Model.RuleForm.LunchStartTime)" step="60" required />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Giờ vào lại</label>
                            <input type="time" class="form-control" name="RuleForm.LunchEndTime" value="@Model.FormatTime(Model.RuleForm.LunchEndTime)" step="60" required />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Giờ tan làm</label>
                            <input type="time" class="form-control" name="RuleForm.WorkEndTime" value="@Model.FormatTime(Model.RuleForm.WorkEndTime)" step="60" required />
                        </div>

                        <div class="col-md-3">
                            <div class="form-check mt-2">
                                <input type="hidden" name="RuleForm.IsActive" value="false" />
                                @if (Model.RuleForm.IsActive)
                                {
                                    <input class="form-check-input" type="checkbox" id="ruleIsActive" name="RuleForm.IsActive" value="true" checked />
                                }
                                else
                                {
                                    <input class="form-check-input" type="checkbox" id="ruleIsActive" name="RuleForm.IsActive" value="true" />
                                }
                                <label class="form-check-label" for="ruleIsActive">Đang áp dụng</label>
                            </div>
                        </div>

                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                @(Model.RuleForm.Id > 0 ? "Cập nhật cấu hình" : "Lưu cấu hình")
                            </button>
                            <a href="/Attendance/Schedule" class="btn btn-outline-secondary">Làm mới</a>
                        </div>
                    </form>
                </div>
            }

            <div class="table-responsive mt-4">
                <table class="table table-striped table-sm align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Bộ phận</th>
                            <th>Giờ vào</th>
                            <th>Nghỉ trưa</th>
                            <th>Vào lại</th>
                            <th>Tan làm</th>
                            <th class="text-end">Giờ chuẩn</th>
                            <th>Trạng thái</th>
                            @if (Model.CanManageRules)
                            {
                                <th class="text-center">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 0;
                        }
                        @foreach (var item in Model.DepartmentRules)
                        {
                            index++;
                            <tr>
                                <td>@index</td>
                                <td>
                                    <div class="attendance-rule-time">@item.DepartmentText</div>
                                    <div class="text-muted small">@item.DepartmentCode</div>
                                </td>
                                <td>@Model.FormatTime(item.WorkStartTime)</td>
                                <td>@Model.FormatTime(item.LunchStartTime)</td>
                                <td>@Model.FormatTime(item.LunchEndTime)</td>
                                <td>@Model.FormatTime(item.WorkEndTime)</td>
                                <td class="text-end">@((item.ExpectedWorkHours ?? 0).ToString("0.##"))</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Đang áp dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngưng</span>
                                    }
                                </td>
                                @if (Model.CanManageRules)
                                {
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-2">
                                            <a class="btn btn-sm btn-outline-primary" href="/Attendance/Schedule?editId=@item.Id">Sửa</a>
                                            <form method="post" asp-page-handler="DeleteRule" class="d-inline" onsubmit="return confirm('Xóa cấu hình bộ phận này?');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }

                        @if (index == 0)
                        {
                            <tr>
                                <td colspan="@(Model.CanManageRules ? 9 : 8)" class="text-center text-muted">Chưa có cấu hình giờ làm việc theo bộ phận.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <hr class="my-4" />

            <div>
                <h5 class="card-title mb-1">Thiết lập ngày nghỉ lễ</h5>
                <div class="attendance-rule-note">
                    Admin khai báo trước các ngày nghỉ lễ. Hệ thống sẽ hiển thị riêng trên bảng chấm công và không quy vào nghỉ không phép.
                </div>
            </div>

            @if (Model.CanManageRules)
            {
                <div class="attendance-rule-card p-3 mt-4">
                    <form method="post" asp-page-handler="SaveHoliday" class="row g-3">
                        <input type="hidden" name="HolidayForm.Id" value="@Model.HolidayForm.Id" />

                        <div class="col-md-5">
                            <label class="form-label">Tên ngày lễ</label>
                            <input type="text" class="form-control" name="HolidayForm.HolidayName" value="@Model.HolidayForm.HolidayName" maxlength="200" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Từ ngày</label>
                            <input type="date" class="form-control" name="HolidayForm.FromDate" value="@Model.HolidayForm.FromDate.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Đến ngày</label>
                            <input type="date" class="form-control" name="HolidayForm.ToDate" value="@Model.HolidayForm.ToDate.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-1">
                            <div class="form-check mt-4 pt-2">
                                <input type="hidden" name="HolidayForm.IsActive" value="false" />
                                @if (Model.HolidayForm.IsActive)
                                {
                                    <input class="form-check-input" type="checkbox" id="holidayIsActive" name="HolidayForm.IsActive" value="true" checked />
                                }
                                else
                                {
                                    <input class="form-check-input" type="checkbox" id="holidayIsActive" name="HolidayForm.IsActive" value="true" />
                                }
                                <label class="form-check-label" for="holidayIsActive">Bật</label>
                            </div>
                        </div>

                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                @(Model.HolidayForm.Id > 0 ? "Cập nhật ngày lễ" : "Lưu ngày lễ")
                            </button>
                            <a href="/Attendance/Schedule" class="btn btn-outline-secondary">Làm mới</a>
                        </div>
                    </form>
                </div>
            }

            <div class="table-responsive mt-4">
                <table class="table table-striped table-sm align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tên ngày lễ</th>
                            <th>Từ ngày</th>
                            <th>Đến ngày</th>
                            <th>Trạng thái</th>
                            @if (Model.CanManageRules)
                            {
                                <th class="text-center">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var holidayIndex = 0;
                        }
                        @foreach (var item in Model.Holidays)
                        {
                            holidayIndex++;
                            <tr>
                                <td>@holidayIndex</td>
                                <td class="attendance-rule-time">@item.HolidayName</td>
                                <td>@item.FromDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.ToDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Đang áp dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngưng</span>
                                    }
                                </td>
                                @if (Model.CanManageRules)
                                {
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-2">
                                            <a class="btn btn-sm btn-outline-primary" href="/Attendance/Schedule?editHolidayId=@item.Id">Sửa</a>
                                            <form method="post" asp-page-handler="DeleteHoliday" class="d-inline" onsubmit="return confirm('Xóa ngày nghỉ lễ này?');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }

                        @if (holidayIndex == 0)
                        {
                            <tr>
                                <td colspan="@(Model.CanManageRules ? 6 : 5)" class="text-center text-muted">Chưa có ngày nghỉ lễ nào được khai báo.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
