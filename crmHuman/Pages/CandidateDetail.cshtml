<script>
    document.addEventListener('DOMContentLoaded', function() {
        const cbStatus = document.getElementById('cbStatus');
        const divExpected = document.getElementById('divExpectedOnboardDate');
        
        if (cbStatus && divExpected) {
            cbStatus.addEventListener('change', function() {
                const status = this.value;
                if (status == '92' || status == '93') {
                    divExpected.style.display = '';
                } else {
                    divExpected.style.display = 'none';
                }
            });
        }
    });
</script>

<script>
    function toDateTimeLocalValue(value) {
        if (!value) {
            return '';
        }

        const text = value.toString();
        if (text.length >= 16 && text.includes('T')) {
            return text.substring(0, 16);
        }

        const parsed = new Date(text);
        if (!Number.isNaN(parsed.getTime())) {
            const year = parsed.getFullYear();
            const month = String(parsed.getMonth() + 1).padStart(2, '0');
            const day = String(parsed.getDate()).padStart(2, '0');
            const hours = String(parsed.getHours()).padStart(2, '0');
            const minutes = String(parsed.getMinutes()).padStart(2, '0');
            return `${year}-${month}-${day}T${hours}:${minutes}`;
        }

        return '';
    }

    // Edit schedule - load data into form
    async function editSchedule(scheduleId) {
        try {
            const response = await fetch(`/CandidateDetail?handler=ScheduleById&scheduleId=${scheduleId}`);
            const result = await response.json();
            
            if (result.success && result.data) {
                const data = result.data;
                
                const scheduleIdInput = document.getElementById('scheduleId');
                if (scheduleIdInput) {
                    scheduleIdInput.value = data.id || '';
                }
                
                if (document.getElementById('scheduleRound')) {
                    document.getElementById('scheduleRound').value = data.type || '1';
                }
                if (document.getElementById('scheduleStatus')) {
                    document.getElementById('scheduleStatus').value = data.status || '1';
                }
                if (document.getElementById('scheduleMode')) {
                    document.getElementById('scheduleMode').value = data.interviewMode || '1';
                }
                if (document.getElementById('scheduleResult')) {
                    document.getElementById('scheduleResult').value = data.interviewResult || '';
                }
                if (document.getElementById('scheduleDateTime')) {
                    document.getElementById('scheduleDateTime').value = toDateTimeLocalValue(data.scheduleDate);
                }
                if (document.getElementById('scheduleInterviewer')) {
                    document.getElementById('scheduleInterviewer').value = data.interviewerId || '';
                }
                if (document.getElementById('scheduleAddressInfo')) {
                    document.getElementById('scheduleAddressInfo').value = data.addressInfo || '';
                }
                if (document.getElementById('scheduleNote')) {
                    document.getElementById('scheduleNote').value = data.noted || '';
                }
                if (document.getElementById('scheduleSendEmail')) {
                    document.getElementById('scheduleSendEmail').checked = false;
                }
                if (typeof updateScheduleEmailUi === 'function') {
                    updateScheduleEmailUi();
                }
                
                const submitBtn = document.querySelector('.interview-schedule-form button[type="button"]');
                if (submitBtn) {
                    submitBtn.innerHTML = 'Cập nhật lịch phỏng vấn';
                }
                
                // Scroll to form
                document.getElementById('contact-tab')?.click();
                
                showToast('Đã tải thông tin lịch phỏng vấn', 'info');
            } else {
                showToast(result.message || 'Không thể tải thông tin lịch phỏng vấn', 'error');
            }
        } catch (error) {
            console.error('Error loading schedule:', error);
            showToast('Lỗi khi tải thông tin', 'error');
        }
    }
    
    // Delete schedule with confirmation
    async function deleteSchedule(scheduleId) {
        if (!confirm('Bạn có chắc chắn muốn xóa lịch phỏng vấn này?')) {
            return;
        }
        
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const response = await fetch('/CandidateDetail?handler=DeleteSchedule', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'RequestVerificationToken': token
                },
                body: new URLSearchParams({ scheduleId: scheduleId.toString() })
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Remove the row from table
                const row = document.getElementById(`schedule-row-${scheduleId}`);
                if (row) {
                    row.remove();
                }
                showToast('Đã xóa lịch phỏng vấn thành công', 'success');
            } else {
                showToast(result.message || 'Không thể xóa lịch phỏng vấn', 'error');
            }
        } catch (error) {
            console.error('Error deleting schedule:', error);
            showToast('Lỗi khi xóa lịch phỏng vấn', 'error');
        }
    }
    
    // Helper function to show toast notifications
    function showToast(message, type = 'info') {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: message,
                showConfirmButton: false,
                timer: 3000
            });
        } else {
            alert(message);
        }
    }
</script>

