<script>
    document.addEventListener('DOMContentLoaded', function () {
        const cbStatus = document.getElementById('cbStatus');
        const divExpected = document.getElementById('divExpectedOnboardDate');
        const candidateValidators = [
            {
                id: 'txtFullName',
                validate: function (value) {
                    return value ? '' : 'Vui lòng nhập tên ứng viên';
                }
            },
            {
                id: 'txtPhone',
                validate: function (value) {
                    if (!value) {
                        return 'Vui lòng nhập số điện thoại';
                    }

                    const normalized = value.replace(/[^\d+]/g, '');
                    return /^(0|\+84)\d{8,10}$/.test(normalized) ? '' : 'Số điện thoại chưa đúng định dạng';
                }
            },
            {
                id: 'dob',
                validate: function (value) {
                    return value ? '' : 'Vui lòng chọn ngày sinh';
                }
            },
            {
                id: 'txtEmail',
                validate: function (value) {
                    if (!value) {
                        return 'Vui lòng nhập email';
                    }

                    return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(value) ? '' : 'Email chưa đúng định dạng';
                }
            },
            {
                id: 'txtNationalId',
                validate: function (value) {
                    if (!value) {
                        return '';
                    }

                    return /^\d{9,12}$/.test(value) ? '' : 'CCCD phải gồm 9 đến 12 chữ số';
                }
            }
        ];
        const mirroredFields = [
            { sourceId: 'heroStatusHuman', targetId: 'cbStatusHuman', eventName: 'change' },
            { sourceId: 'heroStatus', targetId: 'cbStatus', eventName: 'change' },
            { sourceId: 'heroExpectedOnboardDate', targetId: 'txtExpectedOnboardDate', eventName: 'input' }
        ];

        function toggleExpectedOnboardDate() {
            if (!cbStatus || !divExpected) {
                return;
            }

            const shouldShow = cbStatus.value === '92' || cbStatus.value === '93';
            divExpected.classList.toggle('is-hidden', !shouldShow);
            document.getElementById('heroExpectedOnboardWrap')?.classList.toggle('is-hidden', !shouldShow);
        }

        function resolveToneClass(text) {
            const normalized = (text || '').toLowerCase();
            if (!normalized) {
                return 'candidate-status-badge--info';
            }
            if (normalized.includes('đã') || normalized.includes('ok') || normalized.includes('pass') || normalized.includes('hoàn') || normalized.includes('đủ')) {
                return 'candidate-status-badge--success';
            }
            if (normalized.includes('chờ') || normalized.includes('đang') || normalized.includes('hold') || normalized.includes('xử lý')) {
                return 'candidate-status-badge--warning';
            }
            if (normalized.includes('fail') || normalized.includes('lỗi') || normalized.includes('từ chối') || normalized.includes('thiếu')) {
                return 'candidate-status-badge--danger';
            }
            return 'candidate-status-badge--info';
        }

        function updateQuickBadge(selectId, badgeId) {
            const select = document.getElementById(selectId);
            const badge = document.getElementById(badgeId);
            if (!select || !badge) {
                return;
            }

            const optionText = select.options[select.selectedIndex]?.text || '';
            badge.textContent = optionText;
            badge.className = `candidate-status-badge ${resolveToneClass(optionText)}`;
        }

        function syncFieldValue(sourceId, targetId) {
            const source = document.getElementById(sourceId);
            const target = document.getElementById(targetId);
            if (!source || !target) {
                return;
            }

            target.value = source.value;
            if (targetId === 'cbStatus') {
                toggleExpectedOnboardDate();
                updateQuickBadge('heroStatus', 'heroStatusBadge');
            }
            if (targetId === 'cbStatusHuman') {
                updateQuickBadge('heroStatusHuman', 'heroStatusHumanBadge');
            }
        }

        function runCandidateFieldValidation(fieldConfig) {
            const input = document.getElementById(fieldConfig.id);
            if (!input) {
                return true;
            }

            const value = (input.value || '').trim();
            const message = fieldConfig.validate(value);
            if (message) {
                addError(fieldConfig.id, message);
                return false;
            }

            removeError(fieldConfig.id);
            return true;
        }

        window.validateCandidateDetailForm = function () {
            let isValid = true;

            candidateValidators.forEach(function (fieldConfig) {
                if (!runCandidateFieldValidation(fieldConfig)) {
                    isValid = false;
                }
            });

            return isValid;
        };

        candidateValidators.forEach(function (fieldConfig) {
            const input = document.getElementById(fieldConfig.id);
            if (!input) {
                return;
            }

            input.addEventListener('blur', function () {
                runCandidateFieldValidation(fieldConfig);
            });

            input.addEventListener('input', function () {
                if (input.closest('.form-group')?.classList.contains('hasError')) {
                    runCandidateFieldValidation(fieldConfig);
                }
            });
        });

        if (cbStatus && divExpected) {
            cbStatus.addEventListener('change', toggleExpectedOnboardDate);
        }

        mirroredFields.forEach(function (field) {
            const source = document.getElementById(field.sourceId);
            const target = document.getElementById(field.targetId);
            if (!source || !target) {
                return;
            }

            source.addEventListener(field.eventName, function () {
                syncFieldValue(field.sourceId, field.targetId);
            });

            target.addEventListener(field.eventName, function () {
                source.value = target.value;
                if (field.targetId === 'cbStatus') {
                    toggleExpectedOnboardDate();
                    updateQuickBadge('heroStatus', 'heroStatusBadge');
                }
                if (field.targetId === 'cbStatusHuman') {
                    updateQuickBadge('heroStatusHuman', 'heroStatusHumanBadge');
                }
            });
        });

        toggleExpectedOnboardDate();
        updateQuickBadge('heroStatus', 'heroStatusBadge');
        updateQuickBadge('heroStatusHuman', 'heroStatusHumanBadge');
    });
</script>

<script>
    function toDateTimeLocalValue(value) {
        if (!value) {
            return '';
        }

        const text = value.toString();
        if (text.length >= 16 && text.includes('T')) {
            return text.substring(0, 16);
        }

        const parsed = new Date(text);
        if (!Number.isNaN(parsed.getTime())) {
            const year = parsed.getFullYear();
            const month = String(parsed.getMonth() + 1).padStart(2, '0');
            const day = String(parsed.getDate()).padStart(2, '0');
            const hours = String(parsed.getHours()).padStart(2, '0');
            const minutes = String(parsed.getMinutes()).padStart(2, '0');
            return `${year}-${month}-${day}T${hours}:${minutes}`;
        }

        return '';
    }

    // Edit schedule - load data into form
    async function editSchedule(scheduleId) {
        try {
            const response = await fetch(`/CandidateDetail?handler=ScheduleById&scheduleId=${scheduleId}`);
            const result = await response.json();
            
            if (result.success && result.data) {
                const data = result.data;
                
                const scheduleIdInput = document.getElementById('scheduleId');
                if (scheduleIdInput) {
                    scheduleIdInput.value = data.id || '';
                }
                
                if (document.getElementById('scheduleRound')) {
                    document.getElementById('scheduleRound').value = data.type || '1';
                }
                if (document.getElementById('scheduleStatus')) {
                    document.getElementById('scheduleStatus').value = data.status || '1';
                }
                if (document.getElementById('scheduleMode')) {
                    document.getElementById('scheduleMode').value = data.interviewMode || '1';
                }
                if (document.getElementById('scheduleResult')) {
                    document.getElementById('scheduleResult').value = data.interviewResult || '';
                }
                if (document.getElementById('scheduleDateTime')) {
                    document.getElementById('scheduleDateTime').value = toDateTimeLocalValue(data.scheduleDate);
                }
                if (document.getElementById('scheduleInterviewer')) {
                    document.getElementById('scheduleInterviewer').value = data.interviewerId || '';
                }
                if (document.getElementById('scheduleAddressInfo')) {
                    document.getElementById('scheduleAddressInfo').value = data.addressInfo || '';
                }
                if (document.getElementById('scheduleNote')) {
                    document.getElementById('scheduleNote').value = data.noted || '';
                }
                if (document.getElementById('scheduleSendEmail')) {
                    document.getElementById('scheduleSendEmail').checked = false;
                }
                if (typeof updateScheduleEmailUi === 'function') {
                    updateScheduleEmailUi();
                }
                
                const submitBtn = document.querySelector('.interview-schedule-form button[type="button"]');
                if (submitBtn) {
                    submitBtn.innerHTML = 'Cập nhật lịch phỏng vấn';
                }
                
                // Scroll to form
                document.getElementById('contact-tab')?.click();
                
                showToast('Đã tải thông tin lịch phỏng vấn', 'info');
            } else {
                showToast(result.message || 'Không thể tải thông tin lịch phỏng vấn', 'error');
            }
        } catch (error) {
            console.error('Error loading schedule:', error);
            showToast('Lỗi khi tải thông tin', 'error');
        }
    }
    
    // Delete schedule with confirmation
    async function deleteSchedule(scheduleId) {
        if (!confirm('Bạn có chắc chắn muốn xóa lịch phỏng vấn này?')) {
            return;
        }
        
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const response = await fetch('/CandidateDetail?handler=DeleteSchedule', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'RequestVerificationToken': token
                },
                body: new URLSearchParams({ scheduleId: scheduleId.toString() })
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Remove the row from table
                const row = document.getElementById(`schedule-row-${scheduleId}`);
                if (row) {
                    row.remove();
                }
                showToast('Đã xóa lịch phỏng vấn thành công', 'success');
            } else {
                showToast(result.message || 'Không thể xóa lịch phỏng vấn', 'error');
            }
        } catch (error) {
            console.error('Error deleting schedule:', error);
            showToast('Lỗi khi xóa lịch phỏng vấn', 'error');
        }
    }
    
    // Helper function to show toast notifications
    function showToast(message, type = 'info') {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: message,
                showConfirmButton: false,
                timer: 3000
            });
        } else {
            alert(message);
        }
    }

    function openCvPreview(fileUrl) {
        if (!fileUrl) {
            return;
        }

        const modalElement = document.getElementById('cvPreviewModal');
        const modalTitle = document.getElementById('cvPreviewTitle');
        const modalBody = document.getElementById('cvPreviewBody');
        if (!modalElement || !modalTitle || !modalBody) {
            window.open(fileUrl, '_blank', 'noopener');
            return;
        }

        const normalizedUrl = fileUrl.split('?')[0].toLowerCase();
        const isPdf = normalizedUrl.endsWith('.pdf');
        const isImage = normalizedUrl.endsWith('.png')
            || normalizedUrl.endsWith('.jpg')
            || normalizedUrl.endsWith('.jpeg')
            || normalizedUrl.endsWith('.gif')
            || normalizedUrl.endsWith('.webp');

        modalTitle.textContent = isPdf ? 'Xem trước CV PDF' : 'Xem trước CV';

        if (isPdf) {
            modalBody.innerHTML = `<iframe src="${fileUrl}" title="CV preview"></iframe>`;
        } else if (isImage) {
            modalBody.innerHTML = `<img src="${fileUrl}" alt="CV preview" />`;
        } else {
            window.open(fileUrl, '_blank', 'noopener');
            return;
        }

        const previewModal = bootstrap.Modal.getOrCreateInstance(modalElement);
        previewModal.show();
    }
</script>

