@{
    ViewData["Title"] = Model.TitlePage;
    var itemResult = Model.ResultModel;
    var dataSchedulelist = Model.DataHistory;
    var dataFile = Model.DataFile;

    string ResolveMasterDataName(int typeData, int? selectedCode, bool skipApplyFor = false)
    {
        if (!selectedCode.HasValue)
        {
            return "Chưa cập nhật";
        }

        var selectedCodeText = selectedCode.Value.ToString();
        foreach (var item in Model.DataDepartment)
        {
            if (item.TypeData != typeData)
            {
                continue;
            }

            if (skipApplyFor && item.ApplyFor == 1)
            {
                continue;
            }

            if (item.Code == selectedCodeText)
            {
                return item.Name;
            }
        }

        return "Chưa cập nhật";
    }

    string ResolveSemanticTone(string? text)
    {
        var normalized = (text ?? string.Empty).ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return "info";
        }

        if (normalized.Contains("đã") || normalized.Contains("ok") || normalized.Contains("pass") || normalized.Contains("hoàn") || normalized.Contains("đủ"))
        {
            return "success";
        }

        if (normalized.Contains("chờ") || normalized.Contains("đang") || normalized.Contains("hold") || normalized.Contains("xử lý"))
        {
            return "warning";
        }

        if (normalized.Contains("fail") || normalized.Contains("lỗi") || normalized.Contains("từ chối") || normalized.Contains("thiếu"))
        {
            return "danger";
        }

        return "info";
    }

    string ResolveActivityHandler(string? queryString)
    {
        var normalized = (queryString ?? string.Empty).ToLowerInvariant();
        if (normalized.Contains("handler=update"))
        {
            return "update";
        }
        if (normalized.Contains("handler=adddocument"))
        {
            return "document";
        }
        if (normalized.Contains("handler=addschedule"))
        {
            return "schedule";
        }
        if (normalized.Contains("handler=onboard"))
        {
            return "onboard";
        }
        if (normalized.Contains("handler=delete"))
        {
            return "delete";
        }

        return "activity";
    }

    string ResolveActivityTitle(VS.Human.Rep.Model.AuditLog activity)
    {
        return ResolveActivityHandler(activity.QueryString) switch
        {
            "update" => "Cập nhật hồ sơ ứng viên",
            "document" => "Cập nhật chứng từ",
            "schedule" => "Tạo hoặc cập nhật lịch phỏng vấn",
            "onboard" => "Onboard ứng viên",
            "delete" => "Thao tác xóa dữ liệu",
            _ => "Thao tác trên hồ sơ"
        };
    }

    string ResolveActivityIcon(string handler)
    {
        return handler switch
        {
            "update" => "bi-pencil-square",
            "document" => "bi-folder-check",
            "schedule" => "bi-calendar2-check",
            "onboard" => "bi-person-up",
            "delete" => "bi-trash",
            _ => "bi-clock-history"
        };
    }

    string ResolveActivityTone(VS.Human.Rep.Model.AuditLog activity)
    {
        if (activity.StatusCode.HasValue && activity.StatusCode.Value >= 400)
        {
            return "danger";
        }

        return ResolveActivityHandler(activity.QueryString) switch
        {
            "document" => "info",
            "schedule" => "warning",
            "onboard" => "success",
            "delete" => "danger",
            _ => "info"
        };
    }

    var candidatePositionText = ResolveMasterDataName(2, itemResult.Position);
    var candidateStatusText = ResolveMasterDataName(9, itemResult.Status, true);
    var documentStatusText = ResolveMasterDataName(8, itemResult.StatusHuman, true);
    var candidateActivities = Model.CandidateActivities ?? new List<VS.Human.Rep.Model.AuditLog>();
    var priorityFieldTotal = 5;
    var priorityFieldCompleted = 0;

    if (!string.IsNullOrWhiteSpace(itemResult.Name))
    {
        priorityFieldCompleted++;
    }
    if (!string.IsNullOrWhiteSpace(itemResult.Phone))
    {
        priorityFieldCompleted++;
    }
    if (!string.IsNullOrWhiteSpace(itemResult.Email))
    {
        priorityFieldCompleted++;
    }
    if (!string.IsNullOrWhiteSpace(itemResult.NationalId))
    {
        priorityFieldCompleted++;
    }
    if (!string.IsNullOrWhiteSpace(itemResult.CVLink))
    {
        priorityFieldCompleted++;
    }

    var priorityLabel = priorityFieldCompleted >= 5 ? "Sẵn sàng" : priorityFieldCompleted >= 3 ? "Đang xử lý" : "Ưu tiên cao";
    var priorityTone = priorityFieldCompleted >= 5 ? "success" : priorityFieldCompleted >= 3 ? "warning" : "danger";
    var candidateStatusTone = ResolveSemanticTone(candidateStatusText);
    var documentStatusTone = ResolveSemanticTone(documentStatusText);

}
