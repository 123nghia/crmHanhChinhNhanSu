@page
@model crmHuman.Pages.Leave.LeaveApprovalModel
@{
    ViewData["Title"] = Model.TitlePage;
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Duyệt nghỉ phép</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Danh sách chờ duyệt</h5>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nhân viên</th>
                                <th>Loại nghỉ</th>
                                <th>Từ ngày</th>
                                <th>Đến ngày</th>
                                <th class="text-center">Số ngày</th>
                                <th>Lý do</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var item in Model.LeaveList.Data)
                            {
                                i++;
                                var info = item as dynamic;
                                <tr>
                                    <td>@i</td>
                                    <td>@info.EmployeeName</td>
                                    <td>@info.LeaveTypeName</td>
                                    <td>@info.FromDate.ToString("dd/MM/yyyy")</td>
                                    <td>@info.ToDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">@info.NumDays</td>
                                    <td>@info.Reason</td>
                                    <td class="text-center">
                                        @if (info.Status == 0)
                                        {
                                            <span class="badge bg-warning text-dark">Chờ Lead duyệt</span>
                                        }
                                        else if (info.Status == 1)
                                        {
                                            <span class="badge bg-info text-dark">Chờ HCNS duyệt</span>
                                        }
                                        else if (info.Status == 2)
                                        {
                                            <span class="badge bg-primary">Chờ BGĐ duyệt</span>
                                        }
                                        else if (info.Status == 3)
                                        {
                                            <span class="badge bg-success">Đã duyệt</span>
                                        }
                                        else if (info.Status == 4)
                                        {
                                            <span class="badge bg-success">Đã duyệt (HCNS duyệt thay)</span>
                                        }
                                        else if (info.Status == 5)
                                        {
                                            <span class="badge bg-danger">Từ chối</span>
                                        }
                                        else if (info.Status == 6)
                                        {
                                            <span class="badge bg-secondary">Đã hủy</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-info" onclick="viewHistory(@info.Id)" title="Xem lịch sử"><i class="bi bi-clock-history"></i></button>
                                            <button class="btn btn-sm btn-success" onclick="approveLeave(@info.Id, 'Agree')">Duyệt</button>
                                            @if (Model.UserData.RoleCode == "2" || Model.UserData.RoleCode == "1")
                                            {
                                                <button class="btn btn-sm btn-primary" onclick="approveLeave(@info.Id, 'Acting')">Duyệt thay BGĐ</button>
                                            }
                                            <button class="btn btn-sm btn-danger" onclick="approveLeave(@info.Id, 'Reject')">Từ chối</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (i == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center">Không có yêu cầu chờ duyệt</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal for Rejection Comment -->
<div class="modal fade" id="commentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ghi chú duyệt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="approveId" />
                <input type="hidden" id="approveAction" />
                <div class="mb-3">
                    <label class="form-label">Ý kiến phản hồi</label>
                    <textarea class="form-control" id="approveComment" rows="3"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="submitApproval()">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for View History -->
<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Lịch sử xử lý đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Người xử lý</th>
                                <th>Hành động</th>
                                <th>Ghi chú/Lý do</th>
                            </tr>
                        </thead>
                        <tbody id="historyContent">
                            <!-- History items will be injected here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/pages/leave-approval.js?v=@DateTime.Now.Ticks"></script>
