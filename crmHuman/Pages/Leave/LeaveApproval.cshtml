@page
@model crmHuman.Pages.Leave.LeaveApprovalModel
@{
    ViewData["Title"] = Model.TitlePage;
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Duyệt nghỉ phép</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Danh sách chờ duyệt</h5>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nhân viên</th>
                                <th>Loại nghỉ</th>
                                <th>Từ ngày</th>
                                <th>Đến ngày</th>
                                <th class="text-center">Số ngày</th>
                                <th>Lý do</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var item in Model.LeaveList.Data)
                            {
                                i++;
                                var info = item as dynamic;
                                <tr>
                                    <td>@i</td>
                                    <td>@info.EmployeeName</td>
                                    <td>@info.LeaveTypeName</td>
                                    <td>@info.FromDate.ToString("dd/MM/yyyy")</td>
                                    <td>@info.ToDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">@info.NumDays</td>
                                    <td>@info.Reason</td>
                                    <td class="text-center">
                                        @if (info.Status == 0)
                                        {
                                            <span class="badge bg-warning text-dark">Chờ quản lý trực tiếp phê duyệt</span>
                                        }
                                        else if (info.Status == 1)
                                        {
                                            <span class="badge bg-info text-dark">Chờ HCNS phê duyệt</span>
                                        }
                                        else if (info.Status == 2)
                                        {
                                            <span class="badge bg-primary">Chờ BGĐ phê duyệt</span>
                                        }
                                        else if (info.Status == 3)
                                        {
                                            <span class="badge bg-success">Đã phê duyệt</span>
                                        }
                                        else if (info.Status == 4)
                                        {
                                            <span class="badge bg-success">Đã phê duyệt (HCNS duyệt thay)</span>
                                        }
                                        else if (info.Status == 5)
                                        {
                                            <span class="badge bg-danger">Từ chối</span>
                                        }
                                        else if (info.Status == 6)
                                        {
                                            <span class="badge bg-secondary">Đã hủy</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @{
                                            var isSelfApprovalBlocked = (Model.UserData.RoleCode == "1" || Model.UserData.RoleCode == "8")
                                                && info.EmployeeId == Model.UserData.UserId;
                                        }
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-info" onclick="viewWorkflowDetail(@info.Id)" title="Workflow detail"><i class="bi bi-diagram-3"></i></button>
                                            @if (!isSelfApprovalBlocked)
                                            {
                                                <button class="btn btn-sm btn-success" onclick="approveLeave(@info.Id, 'Agree')">Phê duyệt</button>
                                                @if (Model.UserData.RoleCode == "9" || Model.UserData.RoleCode == "1")
                                                {
                                                    <button class="btn btn-sm btn-primary" onclick="approveLeave(@info.Id, 'Acting')">Duyệt thay BGĐ</button>
                                                }
                                                <button class="btn btn-sm btn-danger" onclick="approveLeave(@info.Id, 'Reject')">Từ chối</button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Không được tự phê duyệt</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (i == 0)
                            {
                                <tr>
                                    <td colspan="9" class="text-center">Không có yêu cầu chờ duyệt</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="commentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ý kiến phê duyệt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="approveId" />
                <input type="hidden" id="approveAction" />
                <div class="mb-3">
                    <label class="form-label">Ghi chú/Lý do</label>
                    <textarea class="form-control" id="approveComment" rows="3"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="submitApproval()">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Lịch sử xử lý đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Người xử lý</th>
                                <th>Hành động</th>
                                <th>Ghi chú/Lý do</th>
                            </tr>
                        </thead>
                        <tbody id="historyContent">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="workflowModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content workflow-detail-modal">
            <div class="modal-header">
                <div>
                    <div class="text-muted small" id="workflowRequestCode">LEAVE</div>
                    <h5 class="modal-title mb-0" id="workflowTitle">Workflow detail</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="workflowHeader" class="workflow-header-grid mb-3"></div>
                <div id="workflowActionArea" class="workflow-action-area mb-3"></div>
                <div class="row g-3">
                    <div class="col-lg-7">
                        <h6 class="fw-bold">Timeline</h6>
                        <div id="workflowTimeline" class="workflow-timeline"></div>
                    </div>
                    <div class="col-lg-5">
                        <h6 class="fw-bold">Business info</h6>
                        <div id="workflowBusinessInfo" class="workflow-info"></div>
                        <h6 class="fw-bold mt-3">Audit / sync</h6>
                        <div id="workflowAuditInfo" class="workflow-info"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .workflow-header-grid {
        display: grid;
        gap: 10px;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    }
    .workflow-kpi {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 10px 12px;
        background: #fff;
    }
    .workflow-kpi-label {
        color: #6b7280;
        font-size: 12px;
    }
    .workflow-kpi-value {
        color: #111827;
        font-weight: 700;
    }
    .workflow-action-area {
        border: 1px solid #dbeafe;
        border-radius: 8px;
        padding: 12px;
        background: #eff6ff;
    }
    .workflow-timeline {
        border-left: 3px solid #d1d5db;
        padding-left: 14px;
    }
    .workflow-timeline-item {
        position: relative;
        padding: 0 0 14px 4px;
    }
    .workflow-timeline-item::before {
        content: "";
        position: absolute;
        left: -23px;
        top: 4px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #2563eb;
        border: 2px solid #fff;
        box-shadow: 0 0 0 1px #2563eb;
    }
    .workflow-info {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 12px;
        background: #fff;
    }
</style>

<script src="/js/pages/leave-approval.js?v=@DateTime.Now.Ticks"></script>
