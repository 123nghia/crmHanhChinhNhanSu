@page
@model crmHuman.Pages.Leave.LeaveApprovalModel
@{
    ViewData["Title"] = Model.TitlePage;
    var pendingCount = 0;
    var managerPendingCount = 0;
    var hrPendingCount = 0;
    var boardPendingCount = 0;

    if (Model.LeaveList?.Data != null)
    {
        foreach (var item in Model.LeaveList.Data)
        {
            var info = item as dynamic;
            if (info == null)
            {
                continue;
            }

            pendingCount++;

            if (info.Status == 0)
            {
                managerPendingCount++;
            }
            else if (info.Status == 1)
            {
                hrPendingCount++;
            }
            else if (info.Status == 2)
            {
                boardPendingCount++;
            }
        }
    }
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Duyệt nghỉ phép</li>
        </ol>
    </nav>
</div>

@if (Model.IsDeepLinkMode)
{
    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card leave-deeplink-card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h5 class="card-title mb-1">Chi tiết đơn nghỉ phép</h5>
                                <div class="text-muted">Mở trực tiếp từ mail/thông báo để xem và xử lý trên cùng màn hình.</div>
                            </div>
                            <a class="btn btn-outline-secondary" href="/Leave/LeaveApproval">Quay lại danh sách duyệt</a>
                        </div>

                        <div id="inlineWorkflowLoading" class="text-muted">Đang tải chi tiết đơn nghỉ phép...</div>
                        <div id="inlineWorkflowError" class="alert alert-danger d-none mb-3"></div>

                        <div id="inlineWorkflowContent" class="d-none">
                            <div class="text-muted small" id="inlineWorkflowRequestCode">LEAVE</div>
                            <h4 class="mb-3" id="inlineWorkflowTitle">Chi tiết quy trình</h4>
                            <div id="inlineWorkflowHeader" class="workflow-header-grid mb-3"></div>
                            <div id="inlineWorkflowActionArea" class="workflow-action-area mb-3"></div>
                            <div class="row g-3">
                                <div class="col-lg-7">
                                    <h6 class="fw-bold workflow-section-title">Tiến trình xử lý</h6>
                                    <div id="inlineWorkflowTimeline" class="workflow-timeline"></div>
                                </div>
                                <div class="col-lg-5">
                                    <h6 class="fw-bold workflow-section-title">Thông tin đơn</h6>
                                    <div id="inlineWorkflowBusinessInfo" class="workflow-info"></div>
                                    <h6 class="fw-bold workflow-section-title mt-3">Theo dõi đồng bộ</h6>
                                    <div id="inlineWorkflowAuditInfo" class="workflow-info"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <section class="section admin-page-shell">
        <div class="admin-kpi-strip">
            <div class="admin-kpi-card">
                <span class="admin-kpi-label">Đơn chờ xử lý</span>
                <strong class="admin-kpi-value">@pendingCount</strong>
                <span class="admin-kpi-meta">Tổng yêu cầu hiện nằm trong hộp duyệt</span>
            </div>
            <div class="admin-kpi-card">
                <span class="admin-kpi-label">Chờ quản lý</span>
                <strong class="admin-kpi-value">@managerPendingCount</strong>
                <span class="admin-kpi-meta">Cần theo sát tuyến duyệt đầu tiên</span>
            </div>
            <div class="admin-kpi-card">
                <span class="admin-kpi-label">Chờ HCNS</span>
                <strong class="admin-kpi-value">@hrPendingCount</strong>
                <span class="admin-kpi-meta">Đơn đang nằm tại bước HCNS</span>
            </div>
            <div class="admin-kpi-card">
                <span class="admin-kpi-label">Chờ BGĐ</span>
                <strong class="admin-kpi-value">@boardPendingCount</strong>
                <span class="admin-kpi-meta">Các quyết định cuối cần xử lý</span>
            </div>
        </div>

        <div class="card admin-list-card">
            <div class="card-body">
                <div class="admin-list-header">
                    <div class="admin-list-copy">
                        <span class="admin-list-kicker">Phê duyệt</span>
                        <h5 class="admin-list-title">Danh sách chờ duyệt nghỉ phép</h5>
                        <p class="admin-list-note">Rút gọn số cột nhìn thấy cùng lúc, gom kỳ nghỉ vào một cột và giữ thao tác xử lý ngay trên từng dòng để quét nhanh hơn.</p>
                    </div>
                    <div class="admin-list-meta">
                        <span class="admin-meta-chip">
                            <strong>@pendingCount</strong>
                            <span>đơn đang mở</span>
                        </span>
                        <span class="admin-meta-chip">
                            <strong>@(managerPendingCount + hrPendingCount + boardPendingCount)</strong>
                            <span>đơn cần bám sát</span>
                        </span>
                    </div>
                </div>

                <div class="table-responsive admin-table-scroll">
                    <table class="table table-striped table-admin-compact">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nhân viên</th>
                                <th>Loại nghỉ</th>
                                <th>Kỳ nghỉ</th>
                                <th class="text-center">Số ngày</th>
                                <th>Lý do</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var item in Model.LeaveList.Data)
                            {
                                i++;
                                var info = item as dynamic;
                                <tr>
                                    <td class="text-nowrap">@i</td>
                                    <td>
                                        <div class="table-primary-text">@info.EmployeeName</div>
                                    </td>
                                    <td>@info.LeaveTypeName</td>
                                    <td class="text-nowrap">
                                        <div class="table-primary-text">@info.FromDate.ToString("dd/MM/yyyy")</div>
                                        <div class="table-secondary-text">đến @info.ToDate.ToString("dd/MM/yyyy")</div>
                                    </td>
                                    <td class="text-center text-nowrap">@info.NumDays</td>
                                    <td>
                                        <div class="table-col-truncate is-wide" title="@info.Reason">@info.Reason</div>
                                    </td>
                                    <td class="text-center">
                                        @if (info.Status == 0)
                                        {
                                            <span class="badge bg-warning text-dark">Chờ quản lý trực tiếp phê duyệt</span>
                                        }
                                        else if (info.Status == 1)
                                        {
                                            <span class="badge bg-info text-dark">Chờ HCNS phê duyệt</span>
                                        }
                                        else if (info.Status == 2)
                                        {
                                            <span class="badge bg-primary">Chờ BGĐ phê duyệt</span>
                                        }
                                        else if (info.Status == 3)
                                        {
                                            <span class="badge bg-success">Đã phê duyệt</span>
                                        }
                                        else if (info.Status == 4)
                                        {
                                            <span class="badge bg-success">Đã phê duyệt (HCNS duyệt thay)</span>
                                        }
                                        else if (info.Status == 5)
                                        {
                                            <span class="badge bg-danger">Từ chối</span>
                                        }
                                        else if (info.Status == 6)
                                        {
                                            <span class="badge bg-secondary">Đã hủy</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @{
                                            var isSelfApprovalBlocked = (Model.UserData.RoleCode == "1" || Model.UserData.RoleCode == "8")
                                                && info.EmployeeId == Model.UserData.UserId;
                                        }
                                        <div class="table-actions table-actions-compact justify-content-center">
                                            <button class="btn btn-sm btn-outline-primary" onclick="viewWorkflowDetail(@info.Id)" title="Chi tiết quy trình">
                                                <i class="bi bi-diagram-3"></i>
                                            </button>
                                            @if (!isSelfApprovalBlocked)
                                            {
                                                <button class="btn btn-sm btn-outline-success" onclick="approveLeave(@info.Id, 'Agree')">Duyệt</button>
                                                @if (Model.UserData.RoleCode == "9" || Model.UserData.RoleCode == "1")
                                                {
                                                    <button class="btn btn-sm btn-outline-primary" onclick="approveLeave(@info.Id, 'Acting')">BGĐ</button>
                                                }
                                                <button class="btn btn-sm btn-outline-danger" onclick="approveLeave(@info.Id, 'Reject')">Từ chối</button>
                                            }
                                            else
                                            {
                                                <span class="admin-meta-chip">Không tự duyệt</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (i == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center">Không có yêu cầu chờ duyệt</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
}

<div class="modal fade" id="commentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ý kiến phê duyệt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="approveId" />
                <input type="hidden" id="approveAction" />
                <div class="mb-3">
                    <label class="form-label">Ghi chú/Lý do</label>
                    <textarea class="form-control" id="approveComment" rows="3"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="submitApproval()">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Lịch sử xử lý đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Người xử lý</th>
                                <th>Hành động</th>
                                <th>Ghi chú/Lý do</th>
                            </tr>
                        </thead>
                        <tbody id="historyContent">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="workflowModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content workflow-detail-modal">
            <div class="modal-header">
                <div>
                    <div class="text-muted small" id="workflowRequestCode">LEAVE</div>
                    <h5 class="modal-title mb-0" id="workflowTitle">Chi tiết quy trình</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="workflowHeader" class="workflow-header-grid mb-3"></div>
                <div id="workflowActionArea" class="workflow-action-area mb-3"></div>
                <div class="row g-3">
                    <div class="col-lg-7">
                        <h6 class="fw-bold workflow-section-title">Tiến trình xử lý</h6>
                        <div id="workflowTimeline" class="workflow-timeline"></div>
                    </div>
                    <div class="col-lg-5">
                        <h6 class="fw-bold workflow-section-title">Thông tin đơn</h6>
                        <div id="workflowBusinessInfo" class="workflow-info"></div>
                        <h6 class="fw-bold workflow-section-title mt-3">Theo dõi đồng bộ</h6>
                        <div id="workflowAuditInfo" class="workflow-info"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .leave-deeplink-card {
        border: 1px solid #dbeafe;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        border-radius: 16px;
    }

    .leave-deeplink-card .card-body {
        padding: 24px 28px 28px;
    }

    .workflow-header-grid {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }

    .workflow-kpi {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 14px 16px;
        background: #fff;
    }

    .workflow-kpi-label {
        color: #6b7280;
        font-size: 12px;
        margin-bottom: 4px;
    }

    .workflow-kpi-value {
        color: #111827;
        font-weight: 700;
    }

    .workflow-header-card,
    .workflow-info-card {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: #fff;
        padding: 14px 16px;
    }

    .workflow-header-label,
    .workflow-info-label {
        display: block;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #6b7280;
        margin-bottom: 4px;
    }

    .workflow-header-value,
    .workflow-info-value {
        display: block;
        font-weight: 600;
        color: #111827;
        word-break: break-word;
    }

    .workflow-action-area {
        border: 1px dashed #bfdbfe;
        background: #eff6ff;
        border-radius: 16px;
        padding: 16px;
    }

    .workflow-section-title {
        margin-bottom: 12px;
        color: #1f2937;
    }

    .workflow-timeline {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .workflow-timeline-item {
        position: relative;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 16px 16px 16px 18px;
        background: #fff;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
    }

    .workflow-timeline-item::before {
        content: "";
        position: absolute;
        left: 0;
        top: 16px;
        bottom: 16px;
        width: 4px;
        border-radius: 999px;
        background: #cbd5f5;
    }

    .workflow-timeline-item.is-pending::before {
        background: #f59e0b;
    }

    .workflow-timeline-item.is-approved::before {
        background: #10b981;
    }

    .workflow-timeline-item.is-rejected::before {
        background: #ef4444;
    }

    .workflow-timeline-item.is-current {
        border-color: #93c5fd;
        background: #f8fbff;
    }

    .workflow-timeline-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }

    .workflow-timeline-title {
        font-weight: 700;
        color: #111827;
    }

    .workflow-timeline-meta {
        font-size: 0.85rem;
        color: #6b7280;
    }

    .workflow-timeline-message {
        color: #374151;
        margin-bottom: 8px;
        white-space: pre-wrap;
    }

    .workflow-timeline-footer {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        font-size: 0.82rem;
        color: #6b7280;
    }

    .workflow-info {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .workflow-action-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .workflow-action-note {
        color: #475569;
        margin-bottom: 12px;
    }

    @@media (max-width: 991px) {
        .leave-deeplink-card .card-body {
            padding: 20px;
        }
    }
</style>

@section Scripts {
    <script src="/js/pages/leave-approval.js?v=@DateTime.Now.Ticks"></script>
}
