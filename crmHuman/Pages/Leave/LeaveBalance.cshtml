@page
@model crmHuman.Pages.Leave.LeaveBalanceModel
@using global::System.Globalization
@{
    ViewData["Title"] = Model.TitlePage;
    var isTcRole = Model.UserData?.RoleCode == "2";
    var myBalance = Model.MyBalance;
    var tooltipClass = "ms-1 bi bi-info-circle text-muted";
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Quản lý ngày phép</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    @Html.AntiForgeryToken()

                    @if (isTcRole)
                    {
                        var allowedValue = myBalance?.AllowedLeaveDays ?? 0m;
                        var carryOverValue = myBalance?.CarryOverLeaveDays ?? 0m;
                        var usedValue = myBalance?.UsedLeaveDays ?? 0m;
                        var expiredValue = myBalance?.ExpiredLeaveDays ?? 0m;
                        var remainingValue = myBalance?.RemainingLeaveDays ?? (allowedValue + carryOverValue - expiredValue - usedValue);

                        <div class="row g-3 mb-3">
                            <div class="col-md-3">
                                <div class="border rounded p-3 h-100 bg-light">
                                    <div class="text-muted small">
                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Số ngày phép được cấp cho năm hiện tại, chưa bao gồm phép tồn năm cũ.">
                                            Phép năm 2026<i class="@tooltipClass"></i>
                                        </span>
                                    </div>
                                    <div class="fs-5 fw-semibold">@allowedValue.ToString("0.##", CultureInfo.InvariantCulture)</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-3 h-100 bg-light">
                                    <div class="text-muted small">
                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Số ngày phép được chuyển từ năm trước sang và chỉ được sử dụng đến hết 31/03.">
                                            Phép tồn năm cũ<i class="@tooltipClass"></i>
                                        </span>
                                    </div>
                                    <div class="fs-5 fw-semibold">@carryOverValue.ToString("0.##", CultureInfo.InvariantCulture)</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-3 h-100 bg-light">
                                    <div class="text-muted small">
                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Số ngày phép năm đã trừ vào quỹ phép, thường là các đơn nghỉ phép năm đã duyệt.">
                                            Đã dùng<i class="@tooltipClass"></i>
                                        </span>
                                    </div>
                                    <div class="fs-5 fw-semibold">@usedValue.ToString("0.##", CultureInfo.InvariantCulture)</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-3 h-100 bg-light">
                                    <div class="text-muted small">
                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Số ngày phép còn lại = Phép năm + Phép tồn năm cũ - Phép hết hạn - Đã dùng.">
                                            Còn lại<i class="@tooltipClass"></i>
                                        </span>
                                    </div>
                                    <div class="fs-5 fw-semibold">@remainingValue.ToString("0.##", CultureInfo.InvariantCulture)</div>
                                </div>
                            </div>
                        </div>
                        <div class="text-muted small mb-3">
                            Phép tồn năm cũ được sử dụng đến hết 31/03, sau đó sẽ chuyển thành phép quá hạn.
                        </div>
                    }
                    else
                    {
                        <form class="row g-3 mb-3" method="get" action="/Leave/LeaveBalance">
                            <div class="col-md-3">
                                <label class="form-label">Từ khóa</label>
                                <input type="text" value="@Model.RequestSearch.Token" name="token" class="form-control" placeholder="Tên, mã, SĐT">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Phòng ban</label>
                                <select name="departmentCode" class="form-select">
                                    <option value="-1">-- Tất cả --</option>
                                    @foreach (var dept in Model.MasterDataList.Where(x => x.TypeData == 5).OrderBy(x => x.Name))
                                    {
                                        if (Model.RequestSearch.DepartmentCode == dept.Code)
                                        {
                                            <option value="@dept.Code" selected>@dept.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@dept.Code">@dept.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Vị trí</label>
                                <select name="positionCode" class="form-select">
                                    <option value="-1">-- Tất cả --</option>
                                    @foreach (var pos in Model.MasterDataList.Where(x => x.TypeData == 2).OrderBy(x => x.Name))
                                    {
                                        if (Model.RequestSearch.PositionCode == pos.Code)
                                        {
                                            <option value="@pos.Code" selected>@pos.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@pos.Code">@pos.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Trạng thái NV</label>
                                <select name="statusWork" class="form-select">
                                    <option value="-1">-- Tất cả --</option>
                                    @foreach (var status in Model.MasterDataList.Where(x => x.TypeData == 11).OrderBy(x => x.Name))
                                    {
                                        if (Model.RequestSearch.StatusWork == status.Code)
                                        {
                                            <option value="@status.Code" selected>@status.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@status.Code">@status.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-1">
                                <label class="form-label">Hiển thị</label>
                                <select name="limit" class="form-select">
                                    <option value="10" selected="@(Model.RequestSearch.Limit == 10)">10</option>
                                    <option value="20" selected="@(Model.RequestSearch.Limit == 20)">20</option>
                                    <option value="50" selected="@(Model.RequestSearch.Limit == 50)">50</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
                            </div>
                        </form>
                    }

                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    @if (!isTcRole)
                                    {
                                        <th>Mã NV</th>
                                        <th>Họ tên</th>
                                        <th>Bộ phận</th>
                                        <th>Vị trí</th>
                                    }
                                    <th class="text-end">
                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Số ngày phép được cấp cho năm hiện tại.">
                                            Phép năm 2026<i class="@tooltipClass"></i>
                                        </span>
                                    </th>
                                    <th class="text-end">
                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Số ngày phép tồn từ năm trước, được dùng đến hết 31/03.">
                                            Phép tồn năm cũ<i class="@tooltipClass"></i>
                                        </span>
                                    </th>
                                    <th class="text-end">
                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Phần phép tồn năm cũ không còn được sử dụng sau hạn 31/03.">
                                            Phép hết hạn<i class="@tooltipClass"></i>
                                        </span>
                                    </th>
                                    <th class="text-end">
                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Số ngày phép năm đã trừ vào quỹ phép của nhân viên.">
                                            Đã dùng<i class="@tooltipClass"></i>
                                        </span>
                                    </th>
                                    <th class="text-end">
                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Số ngày phép còn lại = Phép năm + Phép tồn năm cũ - Phép hết hạn - Đã dùng.">
                                            Còn lại<i class="@tooltipClass"></i>
                                        </span>
                                    </th>
                                    <th class="text-end">
                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Tổng số ngày nghỉ không lương đã duyệt. Cột này không trừ vào quỹ phép năm.">
                                            Nghỉ không lương<i class="@tooltipClass"></i>
                                        </span>
                                    </th>
                                    <th class="text-end">
                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Tổng số ngày nghỉ đã duyệt, gồm nghỉ phép năm, nghỉ bệnh, nghỉ việc riêng, thai sản và nghỉ không lương.">
                                            Tổng nghỉ<i class="@tooltipClass"></i>
                                        </span>
                                    </th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var index = 0;
                                    var columnCount = isTcRole ? 9 : 13;
                                }
                                @foreach (var item in Model.LeaveBalanceList.Data)
                                {
                                    index++;
                                    var info = item as dynamic;
                                    var allowedValue = (decimal?)info?.AllowedLeaveDays ?? 0m;
                                    var carryOverValue = (decimal?)info?.CarryOverLeaveDays ?? 0m;
                                    var expiredValue = (decimal?)info?.ExpiredLeaveDays ?? 0m;
                                    var usedValue = (decimal?)info?.UsedLeaveDays ?? 0m;
                                    var remainingValue = (decimal?)info?.RemainingLeaveDays ?? (allowedValue + carryOverValue - expiredValue - usedValue);
                                    var unpaidValue = (decimal?)info?.UsedUnpaidLeaveDays ?? 0m;
                                    var totalApprovedValue = (decimal?)info?.TotalApprovedLeaveDays ?? 0m;
                                    var allowedText = allowedValue.ToString("0.##", CultureInfo.InvariantCulture);
                                    var carryOverText = carryOverValue.ToString("0.##", CultureInfo.InvariantCulture);
                                    var expiredText = expiredValue.ToString("0.##", CultureInfo.InvariantCulture);
                                    var usedText = usedValue.ToString("0.##", CultureInfo.InvariantCulture);
                                    var remainingText = remainingValue.ToString("0.##", CultureInfo.InvariantCulture);
                                    var unpaidText = unpaidValue.ToString("0.##", CultureInfo.InvariantCulture);
                                    var totalApprovedText = totalApprovedValue.ToString("0.##", CultureInfo.InvariantCulture);

                                    <tr data-id="@info.Id" data-name="@info.FullName" data-allowed="@allowedText" data-carryover="@carryOverText" data-expired="@expiredText" data-used="@usedText">
                                        <td>@index</td>
                                        @if (!isTcRole)
                                        {
                                            <td>@info.UserName</td>
                                            <td>@info.FullName</td>
                                            <td>@info.DepartmentText</td>
                                            <td>@info.PositionText</td>
                                        }
                                        <td class="text-end">@allowedText</td>
                                        <td class="text-end">@carryOverText</td>
                                        <td class="text-end">@expiredText</td>
                                        <td class="text-end">@usedText</td>
                                        <td class="text-end">@remainingText</td>
                                        <td class="text-end">@unpaidText</td>
                                        <td class="text-end">@totalApprovedText</td>
                                        <td class="text-center">
                                            @if (Model.Permision.Edit ?? false)
                                            {
                                                <button type="button" class="btn btn-sm btn-primary" onclick="openLeaveBalanceModal(this)" title="Cập nhật" aria-label="Cập nhật">
                                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted">--</span>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1" onclick="openLeaveDetailsModal(this)" title="Chi tiết" aria-label="Chi tiết">
                                                <i class="bi bi-eye" aria-hidden="true"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (index == 0)
                                {
                                    <tr>
                                        <td colspan="@columnCount" class="text-center">Không có dữ liệu</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!isTcRole)
                    {
                        Html.RenderPartial("formSearch/pagination", Model);
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="leaveBalanceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật ngày phép</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="leaveBalanceEmployeeId" />
                <div class="mb-3">
                    <label class="form-label">Nhân viên</label>
                    <input type="text" class="form-control" id="leaveBalanceEmployeeName" readonly disabled />
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">
                            <span data-bs-toggle="tooltip" data-bs-placement="top" title="Chỉ tiêu phép năm được cấp cho nhân viên trong năm hiện tại.">
                                Số ngày được hưởng<i class="@tooltipClass"></i>
                            </span>
                        </label>
                        <input type="number" step="0.5" min="0" class="form-control" id="allowedLeaveDays" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">
                            <span data-bs-toggle="tooltip" data-bs-placement="top" title="Số ngày phép được chuyển từ năm trước sang.">
                                Phép tồn năm cũ<i class="@tooltipClass"></i>
                            </span>
                        </label>
                        <input type="number" step="0.5" min="0" class="form-control" id="carryOverLeaveDays" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">
                            <span data-bs-toggle="tooltip" data-bs-placement="top" title="Giá trị này được hệ thống tự động tính từ các đơn nghỉ đã duyệt, không sửa tay tại đây.">
                                Số ngày đã dùng<i class="@tooltipClass"></i>
                            </span>
                        </label>
                        <input type="number" step="0.5" min="0" class="form-control" id="usedLeaveDays" readonly disabled />
                        <div class="form-text">Tự động tính từ đơn nghỉ phép đã duyệt.</div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">
                            <span data-bs-toggle="tooltip" data-bs-placement="top" title="Số ngày phép tồn năm cũ đã hết hạn, không còn được sử dụng.">
                                Phép hết hạn<i class="@tooltipClass"></i>
                            </span>
                        </label>
                        <input type="number" step="0.5" min="0" class="form-control" id="expiredLeaveDays" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="saveLeaveBalance()">Lưu</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="leaveDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết ngày nghỉ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nhân viên</label>
                    <input type="text" class="form-control" id="leaveDetailEmployeeName" readonly disabled />
                </div>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Loại nghỉ</th>
                                <th>Từ ngày</th>
                                <th>Đến ngày</th>
                                <th class="text-end">Số ngày</th>
                                <th>Lý do</th>
                                <th>Người duyệt hiện tại</th>
                                <th>Ngày tạo</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="leaveDetailContent">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/pages/leave-balance.js?v=@DateTime.Now.Ticks"></script>
