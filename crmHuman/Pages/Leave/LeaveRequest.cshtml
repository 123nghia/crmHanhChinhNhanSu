@page
@model crmHuman.Pages.Leave.LeaveRequestModel
@{
    ViewData["Title"] = Model.TitlePage;
    var totalRequests = 0;
    var pendingRequests = 0;
    var approvedRequests = 0;
    var closedRequests = 0;

    if (Model.LeaveList?.Data != null)
    {
        foreach (var item in Model.LeaveList.Data)
        {
            var info = item as dynamic;
            if (info == null)
            {
                continue;
            }

            totalRequests++;
            if (info.Status == 0 || info.Status == 1 || info.Status == 2)
            {
                pendingRequests++;
            }
            else if (info.Status == 3 || info.Status == 4)
            {
                approvedRequests++;
            }
            else if (info.Status == 5 || info.Status == 6)
            {
                closedRequests++;
            }
        }
    }
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Nghỉ phép</li>
        </ol>
    </nav>
</div>

<section class="section admin-page-shell">
    @if (Model.UserData?.RoleCode == "4" && Model.LeaveBalance != null)
    {
        var allowedLeave = Model.LeaveBalance.AllowedLeaveDays ?? 0m;
        var carryOverLeave = Model.LeaveBalance.CarryOverLeaveDays ?? 0m;
        var expiredLeave = Model.LeaveBalance.ExpiredLeaveDays ?? 0m;
        var usedLeave = Model.LeaveBalance.UsedLeaveDays ?? 0m;
        var remainingLeave = Model.LeaveBalance.RemainingLeaveDays ?? (allowedLeave + carryOverLeave - expiredLeave - usedLeave);
        <div class="admin-hero-panel leave-request-hero">
            <div class="admin-hero-copy">
                <span class="admin-hero-kicker">Nghỉ phép</span>
                <h2 class="admin-hero-title">Đơn nghỉ phép gọn hơn, nhìn là biết việc nào đang chờ.</h2>
                <p class="admin-hero-subtitle">Bảng đã được gom theo nhóm thông tin: người tạo, kế hoạch nghỉ, bàn giao và trạng thái. Mỗi dòng giờ tập trung vào quyết định, không còn phải kéo ngang qua quá nhiều cột rời rạc.</p>
                <div class="admin-hero-actions">
                    <form method="post" asp-page-handler="Export">
                        <button type="submit" class="btn btn-outline-success">Xuất file</button>
                    </form>
                    @if (Model.Permision.Add ?? false)
                    {
                        <button type="button" class="btn btn-primary" onclick="openAddLeave()">Đăng ký nghỉ phép</button>
                    }
                </div>
            </div>
            <div class="admin-hero-side">
                <div class="admin-hero-note">
                    <strong>Quỹ phép còn lại</strong>
                    <span>@($"{remainingLeave:0.#}") ngày. Phép năm @DateTime.Now.Year: @($"{allowedLeave:0.#}") ngày, phép tồn: @($"{carryOverLeave:0.#}") ngày.</span>
                </div>
                <div class="admin-hero-note">
                    <strong>Đã dùng và hết hạn</strong>
                    <span>Đã sử dụng @($"{usedLeave:0.#}") ngày, hết hạn @($"{expiredLeave:0.#}") ngày. Công thức tính đã được rút gọn trong cùng khối hiển thị.</span>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="admin-hero-panel">
            <div class="admin-hero-copy">
                <span class="admin-hero-kicker">Nghỉ phép</span>
                <h2 class="admin-hero-title">Theo dõi luồng nghỉ phép với bố cục ít cột hơn.</h2>
                <p class="admin-hero-subtitle">Mỗi cột giờ đại diện cho một nhóm thông tin thay vì từng trường lẻ, giúp duyệt nhanh hơn và giữ trọng tâm vào trạng thái xử lý.</p>
                <div class="admin-hero-actions">
                    <form method="post" asp-page-handler="Export">
                        <button type="submit" class="btn btn-outline-success">Xuất file</button>
                    </form>
                    @if (Model.Permision.Add ?? false)
                    {
                        <button type="button" class="btn btn-primary" onclick="openAddLeave()">Đăng ký nghỉ phép</button>
                    }
                </div>
            </div>
            <div class="admin-hero-side">
                <div class="admin-hero-note">
                    <strong>Luồng đang chờ</strong>
                    <span>@pendingRequests đơn đang nằm trong các bước phê duyệt. Các trạng thái đóng đã được tách riêng để không làm nhiễu danh sách.</span>
                </div>
            </div>
        </div>
    }

    <div class="admin-kpi-strip">
        <div class="admin-kpi-card">
            <span class="admin-kpi-label">Tổng đơn</span>
            <strong class="admin-kpi-value">@totalRequests</strong>
            <span class="admin-kpi-meta">Tất cả đơn hiển thị theo bộ lọc hiện tại</span>
        </div>
        <div class="admin-kpi-card">
            <span class="admin-kpi-label">Đang chờ duyệt</span>
            <strong class="admin-kpi-value">@pendingRequests</strong>
            <span class="admin-kpi-meta">Các đơn đang ở trong workflow phê duyệt</span>
        </div>
        <div class="admin-kpi-card">
            <span class="admin-kpi-label">Đã duyệt</span>
            <strong class="admin-kpi-value">@approvedRequests</strong>
            <span class="admin-kpi-meta">Bao gồm cả trường hợp HCNS duyệt thay</span>
        </div>
        <div class="admin-kpi-card">
            <span class="admin-kpi-label">Đã đóng</span>
            <strong class="admin-kpi-value">@closedRequests</strong>
            <span class="admin-kpi-meta">Từ chối hoặc đã hủy</span>
        </div>
    </div>

    <div class="card admin-list-card">
        <div class="card-body">
            <div class="admin-list-header">
                <div class="admin-list-copy">
                    <span class="admin-list-kicker">Đơn từ</span>
                    <h5 class="admin-list-title">Lịch sử đơn nghỉ phép</h5>
                    <p class="admin-list-note">Thông tin cùng loại đã được gom trong cùng một ô: người tạo, kế hoạch nghỉ, bàn giao và trạng thái. Bảng ngắn hơn và dễ quét hơn rõ rệt.</p>
                </div>
                <div class="admin-list-actions">
                    <form method="post" asp-page-handler="Export">
                        <button type="submit" class="btn btn-outline-success">Xuất file</button>
                    </form>
                    @if (Model.Permision.Add ?? false)
                    {
                        <button type="button" class="btn btn-primary" onclick="openAddLeave()">Đăng ký nghỉ phép</button>
                    }
                </div>
            </div>

            <div class="table-responsive admin-table-scroll">
                <table class="table table-striped table-admin-compact">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Người tạo</th>
                            <th>Kế hoạch nghỉ</th>
                            <th>Bàn giao và lý do</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 0;
                        }
                        @foreach (var item in Model.LeaveList.Data)
                        {
                            i++;
                            var info = item as dynamic;
                            var handoverName = Convert.ToString(info.HandoverEmployeeName);
                            var approverName = Convert.ToString(info.ApproverName);
                            <tr>
                                <td class="text-nowrap">@i</td>
                                <td>
                                    <div class="table-stack">
                                        <div class="table-stack-title">@info.EmployeeName</div>
                                        <div class="table-stack-subtitle">Tạo ngày @info.CreateAt.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="table-stack">
                                        <div class="table-stack-title">@info.LeaveTypeName</div>
                                        <div class="table-stack-subtitle">@info.FromDate.ToString("dd/MM/yyyy") đến @info.ToDate.ToString("dd/MM/yyyy")</div>
                                        <div class="table-stack-meta">
                                            <span class="table-info-chip is-primary">@info.NumDays ngày</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="table-stack">
                                        <div class="table-stack-title">Bàn giao: @(string.IsNullOrWhiteSpace(handoverName) ? "Chưa chọn" : handoverName)</div>
                                        <div class="table-reason-block" title="@info.Reason">@info.Reason</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="table-status-stack">
                                        @if (info.Status == 0)
                                        {
                                            <span class="badge bg-warning text-dark">Chờ quản lý trực tiếp phê duyệt</span>
                                        }
                                        else if (info.Status == 1)
                                        {
                                            <span class="badge bg-info text-dark">Chờ HCNS phê duyệt</span>
                                        }
                                        else if (info.Status == 2)
                                        {
                                            <span class="badge bg-primary">Chờ BGĐ phê duyệt</span>
                                        }
                                        else if (info.Status == 3)
                                        {
                                            <span class="badge bg-success">Đã phê duyệt</span>
                                        }
                                        else if (info.Status == 4)
                                        {
                                            <span class="badge bg-success">Đã phê duyệt (HCNS duyệt thay)</span>
                                        }
                                        else if (info.Status == 5)
                                        {
                                            <span class="badge bg-danger">Từ chối</span>
                                        }
                                        else if (info.Status == 6)
                                        {
                                            <span class="badge bg-secondary">Đã hủy</span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(approverName))
                                        {
                                            <span class="table-info-chip">Duyệt cuối: @approverName</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="table-actions table-actions-compact justify-content-center">
                                        @if (info.Status == 0 && (Model.Permision.Edit ?? false))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openEditLeave(@info.Id)" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="viewWorkflowDetail(@info.Id)" title="Workflow detail">
                                            <i class="bi bi-diagram-3"></i>
                                        </button>
                                        @if ((info.Status == 0 || info.Status == 1 || info.Status == 2) && (Model.Permision.Delete ?? false))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteLeave(@info.Id)" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (i == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center">Không có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="leaveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="leaveModalTitle">Đăng ký nghỉ phép</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="leaveForm">
                    <input type="hidden" id="leaveId" value="0" />
                    <div class="mb-3">
                        <label class="form-label">Loại nghỉ</label>
                        <select class="form-select" id="leaveType" required>
                            @foreach (var t in Model.LeaveTypes)
                            {
                                <option value="@t.Code">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Từ ngày</label>
                            <input type="date" class="form-control" id="fromDate" required onchange="calculateDays()" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Đến ngày</label>
                            <input type="date" class="form-control" id="toDate" required onchange="calculateDays()" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số ngày nghỉ</label>
                        <input type="number" step="0.5" class="form-control" id="numDays" required />
                    </div>
                    <div class="mb-3" id="handoverEmployeeGroup" data-hide-annual-leave-handover="@Model.HideAnnualLeaveHandover.ToString().ToLowerInvariant()">
                        <label class="form-label">Người nhận bàn giao công việc</label>
                        <select class="form-select" id="handoverEmployeeId">
                            <option value="">-- Chọn người nhận bàn giao --</option>
                            @foreach (var emp in Model.EmployeeList)
                            {
                                <option value="@emp.Id">@emp.FullName (@emp.UserName)@(string.IsNullOrWhiteSpace(emp.RoleLabel) ? string.Empty : $" - {emp.RoleLabel}")</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lý do</label>
                        <textarea class="form-control" id="reason" rows="3" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="leaveSaveButton" onclick="saveLeave()">Lưu lại</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Lịch sử xử lý đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Người xử lý</th>
                                <th>Hành động</th>
                                <th>Ghi chú/Lý do</th>
                            </tr>
                        </thead>
                        <tbody id="historyContent">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="workflowModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content workflow-detail-modal">
            <div class="modal-header">
                <div>
                    <div class="text-muted small" id="workflowRequestCode">LEAVE</div>
                    <h5 class="modal-title mb-0" id="workflowTitle">Workflow detail</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="workflowHeader" class="workflow-header-grid mb-3"></div>
                <div id="workflowActionArea" class="workflow-action-area mb-3"></div>
                <div class="row g-3">
                    <div class="col-lg-7">
                        <h6 class="fw-bold">Timeline</h6>
                        <div id="workflowTimeline" class="workflow-timeline"></div>
                    </div>
                    <div class="col-lg-5">
                        <h6 class="fw-bold">Business info</h6>
                        <div id="workflowBusinessInfo" class="workflow-info"></div>
                        <h6 class="fw-bold mt-3">Audit / sync</h6>
                        <div id="workflowAuditInfo" class="workflow-info"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .leave-request-hero .admin-hero-note strong {
            color: #1d4ed8;
        }

        .workflow-header-grid {
            display: grid;
            gap: 10px;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        }

        .workflow-kpi {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 10px 12px;
            background: #fff;
        }

        .workflow-kpi-label {
            color: #6b7280;
            font-size: 12px;
        }

        .workflow-kpi-value {
            color: #111827;
            font-weight: 700;
        }

        .workflow-action-area {
            border: 1px solid #dbeafe;
            border-radius: 8px;
            padding: 12px;
            background: #eff6ff;
        }

        .workflow-timeline {
            border-left: 3px solid #d1d5db;
            padding-left: 14px;
        }

        .workflow-timeline-item {
            position: relative;
            padding: 0 0 14px 4px;
        }

        .workflow-timeline-item::before {
            content: "";
            position: absolute;
            left: -23px;
            top: 4px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #2563eb;
            border: 2px solid #fff;
            box-shadow: 0 0 0 1px #2563eb;
        }

        .workflow-info {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 12px;
            background: #fff;
        }
    </style>
}

<script src="/js/pages/leave-request.js?v=@DateTime.Now.Ticks"></script>
