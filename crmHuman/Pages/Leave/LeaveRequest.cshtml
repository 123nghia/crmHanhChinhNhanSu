@page
@model crmHuman.Pages.Leave.LeaveRequestModel
@{
    ViewData["Title"] = Model.TitlePage;
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Nghỉ phép</li>
        </ol>
    </nav>
</div>

<section class="section">
    @if (Model.UserData?.RoleCode == "4" && Model.LeaveBalance != null)
    {
        var allowedLeave = Model.LeaveBalance.AllowedLeaveDays ?? 0m;
        var carryOverLeave = Model.LeaveBalance.CarryOverLeaveDays ?? 0m;
        var expiredLeave = Model.LeaveBalance.ExpiredLeaveDays ?? 0m;
        var usedLeave = Model.LeaveBalance.UsedLeaveDays ?? 0m;
        var remainingLeave = Model.LeaveBalance.RemainingLeaveDays ?? (allowedLeave + carryOverLeave - expiredLeave - usedLeave);
        <div class="row mb-3">
            <div class="col-lg-12">
                <div class="card leave-balance-card">
                    <div class="card-body">
                        <h5 class="card-title">Thông tin phép của bạn</h5>
                        <div class="row text-center">
                            <div class="col-md col-6">
                                <div class="leave-balance-label">Phép năm 2026</div>
                                <div class="leave-balance-value">@($"{allowedLeave:0.#}")</div>
                            </div>
                            <div class="col-md col-6">
                                <div class="leave-balance-label">Phép tồn năm cũ</div>
                                <div class="leave-balance-value">@($"{carryOverLeave:0.#}")</div>
                            </div>
                            <div class="col-md col-6">
                                <div class="leave-balance-label">Phép hết hạn</div>
                                <div class="leave-balance-value">@($"{expiredLeave:0.#}")</div>
                            </div>
                            <div class="col-md col-6">
                                <div class="leave-balance-label">Đã sử dụng</div>
                                <div class="leave-balance-value">@($"{usedLeave:0.#}")</div>
                            </div>
                            <div class="col-md col-12">
                                <div class="leave-balance-label">Còn lại</div>
                                <div class="leave-balance-value">@($"{remainingLeave:0.#}")</div>
                            </div>
                        </div>
                        <div class="text-muted small mt-2">
                            Công thức: Phép năm + phép tồn năm cũ - phép hết hạn - đã sử dụng.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between mt-3 mb-2">
                        <h5 class="card-title">Lịch sử đơn nghỉ phép</h5>
                        <div class="d-flex gap-2">
                            <form method="post" asp-page-handler="Export">
                                <button type="submit" class="btn btn-outline-success">Xuất file</button>
                            </form>
                            @if (Model.Permision.Add ?? false)
                            {
                                <button type="button" class="btn btn-primary" onclick="openAddLeave()">Đăng ký nghỉ phép</button>
                            }
                        </div>
                    </div>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Người tạo</th>
                                <th>Ngày tạo</th>
                                <th>Loại nghỉ</th>
                                <th>Từ ngày</th>
                                <th>Đến ngày</th>
                                <th class="text-center">Số ngày</th>
                                <th>Người nhận bàn giao</th>
                                <th>Lý do</th>
                                <th class="text-center">Trạng thái</th>
                                <th>Người phê duyệt cuối</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var item in Model.LeaveList.Data)
                            {
                                i++;
                                var info = item as dynamic;
                                <tr>
                                    <td>@i</td>
                                    <td>@info.EmployeeName</td>
                                    <td>@info.CreateAt.ToString("dd/MM/yyyy")</td>
                                    <td>@info.LeaveTypeName</td>
                                    <td>@info.FromDate.ToString("dd/MM/yyyy")</td>
                                    <td>@info.ToDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">@info.NumDays</td>
                                    <td>@info.HandoverEmployeeName</td>
                                    <td>@info.Reason</td>
                                    <td class="text-center">
                                        @if (info.Status == 0)
                                        {
                                            <span class="badge bg-warning text-dark">Chờ quản lý trực tiếp phê duyệt</span>
                                        }
                                        else if (info.Status == 1)
                                        {
                                            <span class="badge bg-info text-dark">Chờ HCNS phê duyệt</span>
                                        }
                                        else if (info.Status == 2)
                                        {
                                            <span class="badge bg-primary">Chờ BGĐ phê duyệt</span>
                                        }
                                        else if (info.Status == 3)
                                        {
                                            <span class="badge bg-success">Đã phê duyệt</span>
                                        }
                                        else if (info.Status == 4)
                                        {
                                            <span class="badge bg-success">Đã phê duyệt (HCNS duyệt thay)</span>
                                        }
                                        else if (info.Status == 5)
                                        {
                                            <span class="badge bg-danger">Từ chối</span>
                                        }
                                        else if (info.Status == 6)
                                        {
                                            <span class="badge bg-secondary">Đã hủy</span>
                                        }
                                    </td>
                                    <td>@info.ApproverName</td>
                                    <td>
                                        @if (info.Status == 0 && (Model.Permision.Edit ?? false))
                                        {
                                            <a href="javascript:void(0)" onclick="openEditLeave(@info.Id)" class="me-2" title="Chỉnh sửa"><i class="bi bi-pencil-square"></i></a>
                                        }
                                        <a href="javascript:void(0)" onclick="viewWorkflowDetail(@info.Id)" class="me-2 text-info" title="Workflow detail"><i class="bi bi-diagram-3"></i></a>
                                        @if ((info.Status == 0 || info.Status == 1 || info.Status == 2) && (Model.Permision.Delete ?? false))
                                        {
                                            <a href="javascript:void(0)" onclick="deleteLeave(@info.Id)" class="text-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (i == 0)
                            {
                                <tr>
                                    <td colspan="12" class="text-center">Không có dữ liệu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="leaveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="leaveModalTitle">Đăng ký nghỉ phép</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="leaveForm">
                    <input type="hidden" id="leaveId" value="0" />
                    <div class="mb-3">
                        <label class="form-label">Loại nghỉ</label>
                        <select class="form-select" id="leaveType" required>
                            @foreach (var t in Model.LeaveTypes)
                            {
                                <option value="@t.Code">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Từ ngày</label>
                            <input type="date" class="form-control" id="fromDate" required onchange="calculateDays()" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Đến ngày</label>
                            <input type="date" class="form-control" id="toDate" required onchange="calculateDays()" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số ngày nghỉ</label>
                        <input type="number" step="0.5" class="form-control" id="numDays" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Người nhận bàn giao công việc</label>
                        <select class="form-select" id="handoverEmployeeId">
                            <option value="">-- Chọn người nhận bàn giao --</option>
                            @foreach (var emp in Model.EmployeeList)
                            {
                                <option value="@emp.Id">@emp.FullName (@emp.UserName)@(string.IsNullOrWhiteSpace(emp.RoleLabel) ? string.Empty : $" - {emp.RoleLabel}")</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lý do</label>
                        <textarea class="form-control" id="reason" rows="3" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="leaveSaveButton" onclick="saveLeave()">Lưu lại</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Lịch sử xử lý đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Người xử lý</th>
                                <th>Hành động</th>
                                <th>Ghi chú/Lý do</th>
                            </tr>
                        </thead>
                        <tbody id="historyContent">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="workflowModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content workflow-detail-modal">
            <div class="modal-header">
                <div>
                    <div class="text-muted small" id="workflowRequestCode">LEAVE</div>
                    <h5 class="modal-title mb-0" id="workflowTitle">Workflow detail</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="workflowHeader" class="workflow-header-grid mb-3"></div>
                <div id="workflowActionArea" class="workflow-action-area mb-3"></div>
                <div class="row g-3">
                    <div class="col-lg-7">
                        <h6 class="fw-bold">Timeline</h6>
                        <div id="workflowTimeline" class="workflow-timeline"></div>
                    </div>
                    <div class="col-lg-5">
                        <h6 class="fw-bold">Business info</h6>
                        <div id="workflowBusinessInfo" class="workflow-info"></div>
                        <h6 class="fw-bold mt-3">Audit / sync</h6>
                        <div id="workflowAuditInfo" class="workflow-info"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .leave-balance-card {
            border: 1px solid #e5e7eb;
        }

        .leave-balance-label {
            color: #6c757d;
            font-size: 0.85rem;
        }

        .leave-balance-value {
            color: #1b4fb0;
            font-size: 1.4rem;
            font-weight: 700;
        }
        .workflow-header-grid {
            display: grid;
            gap: 10px;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        }
        .workflow-kpi {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 10px 12px;
            background: #fff;
        }
        .workflow-kpi-label {
            color: #6b7280;
            font-size: 12px;
        }
        .workflow-kpi-value {
            color: #111827;
            font-weight: 700;
        }
        .workflow-action-area {
            border: 1px solid #dbeafe;
            border-radius: 8px;
            padding: 12px;
            background: #eff6ff;
        }
        .workflow-timeline {
            border-left: 3px solid #d1d5db;
            padding-left: 14px;
        }
        .workflow-timeline-item {
            position: relative;
            padding: 0 0 14px 4px;
        }
        .workflow-timeline-item::before {
            content: "";
            position: absolute;
            left: -23px;
            top: 4px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #2563eb;
            border: 2px solid #fff;
            box-shadow: 0 0 0 1px #2563eb;
        }
        .workflow-info {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 12px;
            background: #fff;
        }
    </style>
}

<script src="/js/pages/leave-request.js?v=@DateTime.Now.Ticks"></script>
