@page
@model crmHuman.Pages.Candidate.ProfileModel
@{
    ViewData["Title"] = "Candidate Profile";
    var candidate = Model.Candidate;
}

<div class="pagetitle">
    <h1>Thông tin cá nhân</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/Candidate/Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active">Thông tin cá nhân</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Cập nhật thông tin</h5>
                    <form id="candidateProfileForm" class="row g-3" novalidate>
                        <div class="col-12">
                            <label class="form-label text-muted">Tên đăng nhập (Không thể thay đổi)</label>
                            <input type="text" value="@candidate.UserName" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Họ và tên</label>
                            <input type="text" value="@candidate.Name" name="fullName" id="txtFullName" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Ngày sinh</label>
                            <input type="date" value="@(candidate.Dob?.ToString("yyyy-MM-dd") ?? string.Empty)" name="dob" id="dob" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Số điện thoại</label>
                            <input type="text" value="@candidate.Phone" name="txtPhone" id="txtPhone" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Email</label>
                            <input type="text" value="@candidate.Email" name="txtEmail" id="txtEmail" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Số CCCD</label>
                            <input type="text" value="@candidate.NationalId" name="NationalId" id="txtNationalId" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Địa chỉ</label>
                            <input type="text" value="@candidate.Address" name="Address" id="txtAddress" class="form-control" />
                        </div>
                        <div class="col-12">
                            @{
                                Html.RenderPartial("ControlForm/FileInputCs", new
                                {
                                    ValueControl = candidate.CVLink,
                                    NameControl = "inputCvlinkName",
                                    IdControl = "inputCvlink",
                                    Lable = "CV file"
                                });
                            }
                        </div>
                        <div class="col-12">
                            <button type="button" onclick="saveCandidateProfile()" class="btn btn-primary px-4">Lưu thay đổi</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-body">
                    <h5 class="card-title text-danger"><i class="bi bi-shield-lock me-2"></i>Đổi mật khẩu</h5>
                    <form id="changePasswordForm" class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Mật khẩu mới</label>
                            <input type="password" id="txtNewPassword" class="form-control" placeholder="Nhập mật khẩu mới" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Xác nhận mật khẩu</label>
                            <input type="password" id="txtConfirmPassword" class="form-control" placeholder="Xác nhận lại mật khẩu mới" />
                        </div>
                        <div class="col-12">
                            <button type="button" onclick="changeCandidatePassword()" class="btn btn-outline-danger">Cập nhật mật khẩu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function saveCandidateProfile() {
            var txtFullName = getValueControl("txtFullName");
            var dobInput = getValueControl("dob");
            var phoneNumber = getValueControl("txtPhone");
            var emailText = getValueControl("txtEmail");
            var nationalIdInput = getValueControl("txtNationalId");
            var addressInput = getValueControl("txtAddress");
            var cvLinkInput = getValueControl("inputCvlink");

            var bodyRequest = {
                Name: txtFullName,
                Dob: dobInput,
                Phone: phoneNumber,
                Email: emailText,
                NationalId: nationalIdInput,
                Address: addressInput,
                CVLink: cvLinkInput
            };

            $.ajax({
                headers: {
                    "RequestVerificationToken":
                        $('input[name="__RequestVerificationToken"]').val()
                },
                type: "POST",
                datatype: "JSON",
                url: '/Candidate/Profile?handler=Update',
                data: bodyRequest,
                success: function (data) {
                    if (data && data.success) {
                        Swal.fire({
                            icon: "success",
                            title: "Saved",
                            text: "Profile updated."
                        });
                        return;
                    }
                    Swal.fire({
                        icon: "error",
                        title: "Update failed",
                        text: "Please check your data."
                    });
                },
                error: function (jqXHR, exception) {
                    showError(jqXHR);
                }
            });
        }
        function changeCandidatePassword() {
            var newPass = $("#txtNewPassword").val();
            var confirmPass = $("#txtConfirmPassword").val();

            if (!newPass) {
                Swal.fire("Lỗi", "Vui lòng nhập mật khẩu mới", "error");
                return;
            }

            if (newPass !== confirmPass) {
                Swal.fire("Lỗi", "Mật khẩu xác nhận không khớp", "error");
                return;
            }

            $.ajax({
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                type: "POST",
                url: '/Candidate/Profile?handler=ChangePassword',
                data: { password: newPass },
                success: function (data) {
                    if (data && data.success) {
                        Swal.fire("Thành công", "Mật khẩu đã được thay đổi.", "success");
                        $("#txtNewPassword").val("");
                        $("#txtConfirmPassword").val("");
                        return;
                    }
                    Swal.fire("Lỗi", "Không thể đổi mật khẩu. Vui lòng thử lại.", "error");
                },
                error: function (jqXHR) {
                    showError(jqXHR);
                }
            });
        }
    </script>
}
