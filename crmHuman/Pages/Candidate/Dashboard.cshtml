@page
@model crmHuman.Pages.Candidate.DashboardModel
@{
    ViewData["Title"] = "Candidate Dashboard";
    var candidate = Model.Candidate;
    var scheduleItems = (Model.ScheduleList?.Data ?? new List<object>()).Cast<dynamic>().ToList();
    dynamic nextSchedule = null;
    // Only show interview alerts if candidate is still in the "Applying/Interviewing" phase (Status < 92)
    if (candidate.Status < 92 || candidate.Status == null)
    {
        foreach (var item in scheduleItems)
        {
            var s = item as dynamic;
            // Only show truly upcoming (Status 1 = Scheduled) and not yet resulted
            if (s.Status == 1 && (s.InterviewResult == null || s.InterviewResult == 0 || s.InterviewResult == 3))
            {
                nextSchedule = s;
                break;
            }
        }
    }
}

<div class="pagetitle">
    <h1>Bảng điều khiển</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Bảng điều khiển</li>
        </ol>
    </nav>
</div>

@if (nextSchedule != null)
{
    var scheduleDate = DateTime.Now; // Defualt fallback
    bool isUrgent = false;
    // Assuming nextSchedule has a raw DateTime property or we can try parsing. 
    // For now let's just show it prominently.
    <div class="row">
        <div class="col-12">
            <div class="alert alert-warning border-0 shadow-sm mb-4 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <strong class="d-block">Bạn có lịch phỏng vấn sắp tới!</strong>
                    Thời gian: <span class="fw-bold">@nextSchedule.ScheduleDateDisplay</span> tại <span class="fw-bold">@(string.IsNullOrWhiteSpace(nextSchedule.AddressInfo) ? "Địa điểm sẽ được cập nhật" : nextSchedule.AddressInfo)</span>
                </div>
                <div class="ms-auto">
                    <a href="#interviewHistory" class="btn btn-warning btn-sm fw-bold">Xem chi tiết</a>
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card bg-primary-light border-0 shadow-sm mb-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold"><i class="bi bi-lightning-fill me-2"></i>Thao tác nhanh</h5>
                    <div>
                        <a href="/Candidate/Profile" class="btn btn-primary btn-sm me-2">
                            <i class="bi bi-pencil-square me-1"></i> Cập nhật thông tin
                        </a>
                        <a href="/Candidate/Documents" class="btn btn-success btn-sm">
                            <i class="bi bi-file-earmark-plus me-1"></i> Bổ sung hồ sơ
                        </a>
                    </div>
                </div>
                <div class="mt-2 small text-muted">
                    Vui lòng hoàn thiện hồ sơ để quá trình ứng tuyển diễn ra thuận lợi nhất.
                </div>
            </div>
        </div>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-4">
            <div class="card info-card status-card">
                <div class="card-body">
                    <h5 class="card-title">Trạng thái ứng tuyển</h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-primary-light text-primary">
                            <i class="bi bi-clipboard-check"></i>
                        </div>
                        <div class="ps-3">
                            <h6 class="status-prominent">@(string.IsNullOrEmpty(Model.StatusText) ? "Chờ cập nhật" : Model.StatusText)</h6>
                            @if ((candidate.Status == 92 || candidate.Status == 93) && candidate.ExpectedOnboardDate.HasValue)
                            {
                                <div class="text-success small fw-bold">
                                    <i class="bi bi-calendar-check me-1"></i>
                                    Ngày nhận việc: @candidate.ExpectedOnboardDate.Value.ToString("dd/MM/yyyy")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card info-card @(nextSchedule != null ? "interview-active" : "")">
                <div class="card-body">
                    <h5 class="card-title">Lịch phỏng vấn sắp tới</h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center @(nextSchedule != null ? "bg-warning-light text-warning" : "bg-light text-secondary")">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                        <div class="ps-3">
                            @if (nextSchedule != null)
                            {
                                <h6 class="text-warning">@nextSchedule.ScheduleDateDisplay</h6>
                                <div class="text-muted small">
                                    <i class="bi bi-geo-alt me-1"></i> @(string.IsNullOrWhiteSpace(nextSchedule.AddressInfo) ? "Địa điểm sẽ được cập nhật" : nextSchedule.AddressInfo)
                                </div>
                            }
                            else
                            {
                                <h6>Chưa có lịch</h6>
                                <span class="text-muted small">Vui lòng chờ thông báo</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card info-card profile-card">
                <div class="card-body">
                    <h5 class="card-title">Thông tin cá nhân</h5>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-primary-light text-primary">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="ps-3">
                            <h6>@candidate.Name</h6>
                            <span class="text-muted small">@candidate.UserName</span>
                        </div>
                    </div>
                    <div class="pt-2 small text-muted">
                        <div>SĐT: @candidate.Phone</div>
                        <div>Email: @candidate.Email</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row" id="interviewHistory">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Lịch sử phỏng vấn</h5>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Ngày</th>
                                    <th>Địa điểm</th>
                                    <th>Ghi chú</th>
                                    <th>Kết quả</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (scheduleItems.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-muted">Chưa có lịch phỏng vấn nào.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in scheduleItems)
                                    {
                                        var schedule = item as dynamic;
                                        <tr>
                                            <td>@schedule.ScheduleDateDisplay</td>
                                            <td>@schedule.AddressInfo</td>
                                            <td>@schedule.Noted</td>
                                            <td>@(schedule.InterviewResult == 1 ? "Đạt" : schedule.InterviewResult == 2 ? "Không đạt" : schedule.InterviewResult == 3 ? "Đang chờ" : "Chưa có kết quả")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title">Thông báo (@Model.UnreadNotificationCount chưa đọc)</h5>
                        @if (Model.UnreadNotificationCount > 0)
                        {
                            <form method="post" asp-page-handler="MarkAllRead" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Đánh dấu đã đọc</button>
                            </form>
                        }
                    </div>
                    <ul class="list-group list-group-flush">
                        @if (Model.Notifications.Count == 0)
                        {
                            <li class="list-group-item text-muted">Chưa có thông báo nào.</li>
                        }
                        else
                        {
                            foreach (var notif in Model.Notifications)
                            {
                                var isUnread = !notif.IsRead;
                                <li class="list-group-item @(isUnread ? "fw-bold alert-light" : "")">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(notif.Link))
                                            {
                                                <a href="@notif.Link">@notif.Message</a>
                                            }
                                            else
                                            {
                                                @notif.Message
                                            }
                                        </div>
                                        <small class="text-muted">@notif.CreateAt.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
