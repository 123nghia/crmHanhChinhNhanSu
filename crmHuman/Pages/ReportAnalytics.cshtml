@page
@model ReportAnalyticsModel
@{
    ViewData["Title"] = Model.TitlePage;
}
<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Báo cáo</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Tổng nhân viên</h5>
                    <p class="card-text">@Model.Summary.TotalEmployees</p>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Tổng hợp đồng</h5>
                    <p class="card-text">@Model.Summary.TotalContracts</p>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Hợp đồng sắp hết hạn (@Model.ExpiringDays ngày)</h5>
                    <p class="card-text">@Model.Summary.ExpiringContracts</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Yêu cầu nghỉ phép chờ duyệt</h5>
                    <p class="card-text">@Model.Summary.PendingLeaveRequests</p>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Yêu cầu hôm nay</h5>
                    <p class="card-text">@Model.Summary.TotalRequestsToday</p>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Tổng truy cập hôm nay</h5>
                    <p class="card-text">@Model.Summary.TotalVisitsToday</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Thống kê hợp đồng theo trạng thái</h5>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Trạng thái</th>
                                <th>Số lượng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ContractStatusCounts != null && Model.ContractStatusCounts.Count > 0)
                            {
                                foreach (var item in Model.ContractStatusCounts)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrWhiteSpace(item.Status) ? "(Trống)" : item.Status)</td>
                                        <td>@item.Total</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2">Chưa có dữ liệu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
