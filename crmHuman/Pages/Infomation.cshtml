@page
@model InfomationModel
@{
    ViewData["Title"] = "Thông tin";

    var userCurrent = Model.UserProfile;
    var avatarPath = string.IsNullOrWhiteSpace(userCurrent.AvatarFile) ? "/assets/img/profile-img.jpg" : userCurrent.AvatarFile;
    var dobText = userCurrent.Dob?.ToString("dd/MM/yyyy") ?? string.Empty;
    var onboardText = userCurrent.Onboard?.ToString("dd/MM/yyyy") ?? string.Empty;

    var activeTab = (Request.Query["tab"].ToString() ?? string.Empty).Trim().ToLowerInvariant();
    var isMailSignatureTab = activeTab == "mail-signature";
    var isProfileSettingsTab = activeTab == "profile-settings";
    var isChangePasswordTab = activeTab == "change-password";
    var isOverviewTab = !isMailSignatureTab && !isProfileSettingsTab && !isChangePasswordTab;
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0)">Thông tin</a></li>
            <li class="breadcrumb-item active">@userCurrent.FullName</li>
        </ol>
    </nav>
</div>

<section class="section profile">
    <div class="row">
        <div class="card">
            <div class="card-body pt-3">
                <ul class="nav nav-tabs nav-tabs-bordered">
                    <li class="nav-item">
                        <button class="nav-link @(isOverviewTab ? "active" : string.Empty)" data-bs-toggle="tab" data-bs-target="#profile-overview" type="button">Thông tin</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(isProfileSettingsTab ? "active" : string.Empty)" data-bs-toggle="tab" data-bs-target="#profile-settings" type="button">Cá nhân hóa</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(isMailSignatureTab ? "active" : string.Empty)" data-bs-toggle="tab" data-bs-target="#profile-mail-signature" type="button">Chữ ký mail</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(isChangePasswordTab ? "active" : string.Empty)" data-bs-toggle="tab" data-bs-target="#profile-change-password" type="button">Đổi mật khẩu</button>
                    </li>
                </ul>

                <div class="tab-content pt-2">
                    <div class="tab-pane fade profile-overview @(isOverviewTab ? "show active" : string.Empty)" id="profile-overview">
                        <h5 class="card-title">Thông tin cá nhân</h5>

                        @if (TempData["AvatarSaved"] != null)
                        {
                            var saved = TempData["AvatarSaved"]?.ToString();
                            if (saved == "1")
                            {
                                <div class="alert alert-success">Đã cập nhật ảnh đại diện.</div>
                            }
                            else
                            {
                                <div class="alert alert-danger">Không thể cập nhật ảnh đại diện.</div>
                            }
                        }

                        @if (TempData["AvatarError"] != null)
                        {
                            var err = TempData["AvatarError"]?.ToString();
                            if (err == "missing")
                            {
                                <div class="alert alert-danger">Vui lòng chọn ảnh đại diện.</div>
                            }
                            else if (err == "size")
                            {
                                <div class="alert alert-danger">Ảnh đại diện quá lớn (tối đa 2MB).</div>
                            }
                            else if (err == "type")
                            {
                                <div class="alert alert-danger">Chỉ hỗ trợ PNG, JPG, JPEG, GIF hoặc WEBP.</div>
                            }
                            else
                            {
                                <div class="alert alert-danger">Không thể cập nhật ảnh đại diện.</div>
                            }
                        }

                        <div class="row align-items-start g-4 mb-4">
                            <div class="col-lg-3 col-md-4 text-center">
                                <img src="@avatarPath" alt="Ảnh đại diện" class="rounded-circle border shadow-sm" style="width: 140px; height: 140px; object-fit: cover;" asp-append-version="true">
                            </div>
                            <div class="col-lg-9 col-md-8">
                                <form method="post" asp-page-handler="UpdateAvatar" enctype="multipart/form-data" class="row g-3">
                                    <div class="col-12 form-group">
                                        <label class="form-label" for="AvatarFileUpload">Ảnh đại diện</label>
                                        <input type="file" asp-for="AvatarFileUpload" class="form-control" accept=".png,.jpg,.jpeg,.gif,.webp,image/png,image/jpeg,image/gif,image/webp">
                                        <small class="text-muted">Bạn có thể tự tải ảnh lên. Hỗ trợ PNG/JPG/JPEG/GIF/WEBP, tối đa 2MB.</small>
                                    </div>
                                    <div class="col-12">
                                        <button class="btn btn-primary" type="submit">Cập nhật ảnh đại diện</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Họ và tên</div>
                            <div class="col-lg-9 col-md-8">@userCurrent.FullName</div>
                        </div>
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Ngày sinh</div>
                            <div class="col-lg-9 col-md-8">@dobText</div>
                        </div>
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Số điện thoại</div>
                            <div class="col-lg-9 col-md-8">@userCurrent.Phone</div>
                        </div>
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Email công ty</div>
                            <div class="col-lg-9 col-md-8">@userCurrent.Email</div>
                        </div>

                        <h5 class="card-title pt-3">Thông tin công việc</h5>
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Mã nhân viên</div>
                            <div class="col-lg-9 col-md-8">@userCurrent.UserName</div>
                        </div>
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Ngày onboard</div>
                            <div class="col-lg-9 col-md-8">@onboardText</div>
                        </div>
                    </div>

                    <div class="tab-pane fade pt-3 @(isProfileSettingsTab ? "show active" : string.Empty)" id="profile-settings">
                        <h5 class="card-title">Cá nhân hóa giao diện</h5>

                        @if (TempData["ThemeSaved"] != null)
                        {
                            var saved = TempData["ThemeSaved"]?.ToString();
                            if (saved == "1")
                            {
                                <div class="alert alert-success">Đã lưu cài đặt giao diện.</div>
                            }
                            else
                            {
                                <div class="alert alert-danger">Không thể lưu cài đặt giao diện.</div>
                            }
                        }

                        <form method="post" asp-page-handler="SaveTheme" class="row g-3">
                            <div class="col-md-4 form-group">
                                <label class="form-label" for="ThemeForm_PrimaryColor">Màu chủ đạo</label>
                                <input type="color" class="form-control form-control-color" asp-for="ThemeForm.PrimaryColor">
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="form-label" for="ThemeForm_ButtonColor">Màu nút</label>
                                <input type="color" class="form-control form-control-color" asp-for="ThemeForm.ButtonColor">
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="form-label" for="ThemeForm_BackgroundColor">Màu nền</label>
                                <input type="color" class="form-control form-control-color" asp-for="ThemeForm.BackgroundColor">
                            </div>
                            <div class="col-12">
                                <button class="btn btn-primary" type="submit">Lưu cài đặt</button>
                            </div>
                        </form>
                    </div>

                    <div class="tab-pane fade pt-3 @(isMailSignatureTab ? "show active" : string.Empty)" id="profile-mail-signature">
                        <h5 class="card-title">Chữ ký mail cá nhân</h5>

                        @if (TempData["MailSignatureSaved"] != null)
                        {
                            var saved = TempData["MailSignatureSaved"]?.ToString();
                            if (saved == "1")
                            {
                                <div class="alert alert-success">Đã lưu chữ ký mail của bạn.</div>
                            }
                            else
                            {
                                <div class="alert alert-danger">Không thể lưu chữ ký mail.</div>
                            }
                        }

                        <div class="alert alert-info">
                            Khi bạn gửi mail từ hệ thống, SMTP vẫn dùng cấu hình admin. Tuy nhiên sender hiển thị và chữ ký sẽ ưu tiên theo tài khoản đang đăng nhập.
                        </div>

                        <form method="post" asp-page-handler="SaveMailSignature" class="row g-3" id="mailSignatureForm">
                            <div class="col-12 form-group">
                                <label class="form-label" for="mailSignature">Nội dung chữ ký</label>
                                <textarea id="mailSignature" name="mailSignature" class="form-control" rows="14">@userCurrent.MailSignature</textarea>
                                <small class="text-muted">Bạn có thể soạn trực tiếp bằng thanh công cụ như Word, hỗ trợ định dạng cơ bản, chèn link, bảng và xem HTML khi cần.</small>
                            </div>
                            <div class="col-12">
                                <button class="btn btn-primary" type="submit">Lưu chữ ký mail</button>
                            </div>
                        </form>
                    </div>

                    <div class="tab-pane fade pt-3 @(isChangePasswordTab ? "show active" : string.Empty)" id="profile-change-password">
                        <form id="updateChangePassword">
                            <div class="row mb-3 form-group">
                                <label for="newPassword" class="col-md-4 col-lg-3 col-form-label">Mật khẩu mới</label>
                                <div class="col-md-8 col-lg-9">
                                    <input name="newpassword" type="password" class="form-control" id="txtnewPassword">
                                </div>
                            </div>

                            <div class="row mb-3 form-group">
                                <label for="renewPassword" class="col-md-4 col-lg-3 col-form-label">Nhập lại mật khẩu</label>
                                <div class="col-md-8 col-lg-9">
                                    <input name="renewpassword" type="password" class="form-control" id="txtrenewPassword">
                                </div>
                            </div>

                            <div class="text-center">
                                <button class="btn btn-primary" onclick="changePassword()">Thay đổi mật khẩu</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/vendor/tinymce/tinymce.min.js" asp-append-version="true"></script>
    <script>
        window.mailSignatureEditorOptions = {
            selector: '#mailSignature',
            formSelector: '#mailSignatureForm',
            tabSelector: 'button[data-bs-target="#profile-mail-signature"]',
            baseUrl: '@Url.Content("~/assets/vendor/tinymce")',
            uploadUrl: '@Url.Page("/Infomation", "UploadMailSignatureImage")'
        };
    </script>
    <script src="~/js/pages/infomation.js" asp-append-version="true"></script>
}
