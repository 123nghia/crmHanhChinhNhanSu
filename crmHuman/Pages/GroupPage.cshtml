@page
@model GroupPageModel
@{
    ViewData["Title"] = Model.TitlePage;   
}
<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/GroupPage">Nhóm</a></li>
            <li class="breadcrumb-item active">Danh sách</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
            
                    @{
                        Html.RenderPartial("formSearch/searchForm2", Model);
                    }

                   
                    <table class="table  table-striped">
                        <thead>
                            <tr>
                                @foreach (var item in Model.TableColumnText)
                                {
                                    <th>
                                        @item
                                    </th>
                                }     
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var itemData in Model.DataAll.Data)
                            {
                                var itemInfo = itemData as dynamic;
                                var datetimeCreate = @itemInfo.CreateAt.ToString("dd/MM/yyyy");
                                var datetimeUpdate = "";
                                if (@itemInfo.UpdateAt != null)
                                {
                                    datetimeUpdate = @itemInfo.UpdateAt.ToString("dd/MM/yyyy");
                                }
                                i++;
                                <tr>
                                    <td>@i</td>
                                    <td><a href="javascript:void(0)" onclick="openFormGroupEdit(@itemInfo.Id)">@itemInfo.Code</a></td>
                                    <td>@itemInfo.Name</td>
                                    <td>@itemInfo.ManagerName</td>
                                    <td>@Model.GetNameStatus(itemInfo.IsActive) </td>
                                    <td>@datetimeCreate</td>
                                    <td>@datetimeUpdate</td>
                                    <td>
                                        <a href="javascript:void(0)" onclick="confirmDelete(@itemInfo.Id,'GroupPage')">
                                        <i class="bi bi-trash-fill">
    
                                    </i>
                                    </a>

                                    <a href="javascript:void(0)" onclick="openPageMember(@itemInfo.Id)">
                                     <i class="bi bi-arrow-up-circle-fill"></i>
                                     </a>
                                        
                                </td>
                                </tr>
                            }
                      
                            
                            
                        </tbody>
                    </table>
                    @{
                        Html.RenderPartial("formSearch/pagination", Model);
                    }
                        
                    
                </div>
            </div>

        </div>
    </div>
</section>

<div class="modal fade" id="formModal" tabindex="-1" >
    <div class="modal-dialog  modal-dialog-centered modal-lg" >
        <div class="modal-content" id="contentModal">
        </div>
    </div>
</div><!-- End Large Modal-->

<div class="modal fade" id="formDataMember" tabindex="-1">
    <div class="modal-dialog  modal-dialog-centered modal-lg">
        <div class="modal-content" id="dataMemberList">
        </div>
    </div>
</div><!-- End Large Modal-->
