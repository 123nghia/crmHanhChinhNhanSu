@page
@model crmHuman.Pages.SupportRequest.RequestModel
@{
    ViewData["Title"] = Model.TitlePage;
    var tooltipIcon = "ms-1 bi bi-info-circle text-muted";
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chu</a></li>
            <li class="breadcrumb-item active">Yeu cau ho tro</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Tao yeu cau moi</h5>

                    @if (!string.IsNullOrWhiteSpace(TempData["ErrorMessage"] as string))
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(TempData["SuccessMessage"] as string))
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    <form method="post" enctype="multipart/form-data" asp-page-handler="Create">
                        <div class="mb-3">
                            <label class="form-label">
                                Tieu de
                                <span data-bs-toggle="tooltip" title="Dat tieu de ngan gon, mo ta dung su co de bo phan tiep nhan nhin la hieu van de.">
                                    <i class="@tooltipIcon"></i>
                                </span>
                            </label>
                            <input asp-for="FormModel.Title" class="form-control" maxlength="250" placeholder="VD: May in phong HCNS bi ket giay" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Bo phan xu ly
                                <span data-bs-toggle="tooltip" title="He thong se uu tien giao cho team lead cua bo phan nay. Neu khong co team lead thi se tu dong chon mot nhan su dang hoat dong.">
                                    <i class="@tooltipIcon"></i>
                                </span>
                            </label>
                            <select asp-for="FormModel.TargetDepartmentCode" class="form-select">
                                <option value="">-- Chon bo phan --</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    <option value="@dept.Code">@dept.Name</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Noi dung
                                <span data-bs-toggle="tooltip" title="Mo ta ro hien tuong loi, muc do anh huong, thoi diem xay ra va cach da thu xu ly neu co.">
                                    <i class="@tooltipIcon"></i>
                                </span>
                            </label>
                            <textarea asp-for="FormModel.Content" class="form-control" rows="5" placeholder="Mo ta chi tiet van de can ho tro"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Hinh anh minh hoa
                                <span data-bs-toggle="tooltip" title="Co the tai len anh chup loi, man hinh, may moc hoac tai lieu lien quan de bo phan xu ly de hinh dung hon.">
                                    <i class="@tooltipIcon"></i>
                                </span>
                            </label>
                            <input asp-for="AttachmentFiles" type="file" class="form-control" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" />
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">Gui yeu cau</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Danh sach yeu cau cua toi</h5>

                    <form method="get" class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label class="form-label">Tu khoa</label>
                            <input type="text" name="token" value="@Model.Token" class="form-control" placeholder="Tim theo tieu de, noi dung" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Bo phan</label>
                            <select name="targetDepartmentCode" class="form-select">
                                <option value="">-- Tat ca --</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    if (Model.TargetDepartmentCode == dept.Code)
                                    {
                                        <option value="@dept.Code" selected>@dept.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@dept.Code">@dept.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Trang thai</label>
                            <select name="status" class="form-select">
                                <option value="">Tat ca</option>
                                @for (var status = 0; status <= 3; status++)
                                {
                                    if (Model.Status == status)
                                    {
                                        <option value="@status" selected>@crmHuman.Pages.SupportRequest.RequestModel.GetStatusText(status)</option>
                                    }
                                    else
                                    {
                                        <option value="@status">@crmHuman.Pages.SupportRequest.RequestModel.GetStatusText(status)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-outline-primary w-100">Tim</button>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>
                                        Tieu de
                                        <span data-bs-toggle="tooltip" title="Ten ngan gon cua yeu cau ho tro.">
                                            <i class="@tooltipIcon"></i>
                                        </span>
                                    </th>
                                    <th>Bo phan xu ly</th>
                                    <th>Nguoi duoc giao</th>
                                    <th>
                                        Trang thai
                                        <span data-bs-toggle="tooltip" title="Moi tao: da assign. Dang xu ly: bo phan da tiep nhan. Hoan thanh/Da huy: yeu cau da dong.">
                                            <i class="@tooltipIcon"></i>
                                        </span>
                                    </th>
                                    <th>Ghi chu</th>
                                    <th>Thao tac</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var index = 0;
                                }
                                @foreach (var row in Model.RequestList.Data)
                                {
                                    index++;
                                    var item = row as VS.Human.Rep.Model.SupportRequestIndexModel;
                                    if (item == null)
                                    {
                                        continue;
                                    }

                                    <tr>
                                        <td>@index</td>
                                        <td>
                                            <div class="fw-semibold">@item.Title</div>
                                            <div class="small text-muted">@item.Content</div>
                                            @if ((item.Attachments?.Count ?? 0) > 0)
                                            {
                                                <div class="mt-1 small">
                                                    @foreach (var file in item.Attachments)
                                                    {
                                                        <a class="me-2" href="@file.FilePath" target="_blank">@file.FileName</a>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td>@item.TargetDepartmentText</td>
                                        <td>@item.AssignedToName</td>
                                        <td>
                                            <span class="badge @crmHuman.Pages.SupportRequest.RequestModel.GetStatusClass(item.Status)"
                                                  data-bs-toggle="tooltip"
                                                  title="@crmHuman.Pages.SupportRequest.RequestModel.GetStatusTooltip(item.Status)">
                                                @crmHuman.Pages.SupportRequest.RequestModel.GetStatusText(item.Status)
                                            </span>
                                        </td>
                                        <td>@item.ProcessorComment</td>
                                        <td>
                                            @if (item.Status != 2)
                                            {
                                                <form method="post" asp-page-handler="Delete" class="d-inline">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xoa</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (index == 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">Chua co yeu cau nao.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.forEach(function (tooltipTriggerEl) {
            new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
</script>
