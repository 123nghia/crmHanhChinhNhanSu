@page
@model crmHuman.Pages.SupportRequest.RequestModel
@{
    ViewData["Title"] = Model.TitlePage;
    var tooltipIcon = "ms-1 bi bi-info-circle text-muted";
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Yêu cầu hỗ trợ</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Tạo yêu cầu mới</h5>

                    @if (!string.IsNullOrWhiteSpace(TempData["ErrorMessage"] as string))
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(TempData["SuccessMessage"] as string))
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    <form method="post" enctype="multipart/form-data" asp-page-handler="Create">
                        <div class="mb-3">
                            <label class="form-label">
                                Tiêu đề
                                <span data-bs-toggle="tooltip" title="Đặt tiêu đề ngắn gọn, mô tả đúng sự cố để bộ phận tiếp nhận nhìn là hiểu vấn đề.">
                                    <i class="@tooltipIcon"></i>
                                </span>
                            </label>
                            <input asp-for="FormModel.Title" class="form-control" maxlength="250" placeholder="VD: Máy in phòng HCNS bị kẹt giấy" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Bộ phận xử lý
                                <span data-bs-toggle="tooltip" title="Hệ thống sẽ ưu tiên giao cho team lead của bộ phận này. Nếu không có team lead thì sẽ tự động chọn một nhân sự đang hoạt động.">
                                    <i class="@tooltipIcon"></i>
                                </span>
                            </label>
                            <select asp-for="FormModel.TargetDepartmentCode" class="form-select">
                                <option value="">-- Chọn bộ phận --</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    <option value="@dept.Code">@dept.Name</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Nội dung
                                <span data-bs-toggle="tooltip" title="Mô tả rõ hiện tượng lỗi, mức độ ảnh hưởng, thời điểm xảy ra và cách đã thử xử lý nếu có.">
                                    <i class="@tooltipIcon"></i>
                                </span>
                            </label>
                            <textarea asp-for="FormModel.Content" class="form-control" rows="5" placeholder="Mô tả chi tiết vấn đề cần hỗ trợ"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Hình ảnh minh họa
                                <span data-bs-toggle="tooltip" title="Có thể tải lên ảnh chụp lỗi, màn hình, máy móc hoặc tài liệu liên quan để bộ phận xử lý dễ hình dung hơn.">
                                    <i class="@tooltipIcon"></i>
                                </span>
                            </label>
                            <input asp-for="AttachmentFiles" type="file" class="form-control" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" />
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">Gửi yêu cầu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Danh sách yêu cầu của tôi</h5>

                    <form method="get" class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label class="form-label">Từ khóa</label>
                            <input type="text" name="token" value="@Model.Token" class="form-control" placeholder="Tìm theo tiêu đề, nội dung" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Bộ phận</label>
                            <select name="targetDepartmentCode" class="form-select">
                                <option value="">-- Tất cả --</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    if (Model.TargetDepartmentCode == dept.Code)
                                    {
                                        <option value="@dept.Code" selected>@dept.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@dept.Code">@dept.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Trạng thái</label>
                            <select name="status" class="form-select">
                                <option value="">Tất cả</option>
                                @for (var status = 0; status <= 3; status++)
                                {
                                    if (Model.Status == status)
                                    {
                                        <option value="@status" selected>@crmHuman.Pages.SupportRequest.RequestModel.GetStatusText(status)</option>
                                    }
                                    else
                                    {
                                        <option value="@status">@crmHuman.Pages.SupportRequest.RequestModel.GetStatusText(status)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-outline-primary w-100">Tìm</button>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>
                                        Tiêu đề
                                        <span data-bs-toggle="tooltip" title="Tên ngắn gọn của yêu cầu hỗ trợ.">
                                            <i class="@tooltipIcon"></i>
                                        </span>
                                    </th>
                                    <th>Bộ phận xử lý</th>
                                    <th>Người được giao</th>
                                    <th>
                                        Trạng thái
                                        <span data-bs-toggle="tooltip" title="Mới tạo: đã assign. Đang xử lý: bộ phận đã tiếp nhận. Hoàn thành/Đã hủy: yêu cầu đã đóng.">
                                            <i class="@tooltipIcon"></i>
                                        </span>
                                    </th>
                                    <th>Ghi chú</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var index = 0;
                                }
                                @foreach (var row in Model.RequestList.Data)
                                {
                                    index++;
                                    var item = row as VS.Human.Rep.Model.SupportRequestIndexModel;
                                    if (item == null)
                                    {
                                        continue;
                                    }

                                    <tr>
                                        <td>@index</td>
                                        <td>
                                            <div class="fw-semibold">@item.Title</div>
                                            <div class="small text-muted">@item.Content</div>
                                            @if ((item.Attachments?.Count ?? 0) > 0)
                                            {
                                                <div class="mt-1 small">
                                                    @foreach (var file in item.Attachments)
                                                    {
                                                        <a class="me-2" href="@file.FilePath" target="_blank">@file.FileName</a>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td>@item.TargetDepartmentText</td>
                                        <td>@item.AssignedToName</td>
                                        <td>
                                            <span class="badge @crmHuman.Pages.SupportRequest.RequestModel.GetStatusClass(item.Status)"
                                                  data-bs-toggle="tooltip"
                                                  title="@crmHuman.Pages.SupportRequest.RequestModel.GetStatusTooltip(item.Status)">
                                                @crmHuman.Pages.SupportRequest.RequestModel.GetStatusText(item.Status)
                                            </span>
                                        </td>
                                        <td>@item.ProcessorComment</td>
                                        <td>
                                            @if (item.Status != 2)
                                            {
                                                <form method="post" asp-page-handler="Delete" class="d-inline">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (index == 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">Chưa có yêu cầu nào.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.forEach(function (tooltipTriggerEl) {
            new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
</script>
