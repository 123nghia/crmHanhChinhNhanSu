@page
@model crmHuman.Pages.SupportRequest.ProcessingModel
@{
    ViewData["Title"] = Model.TitlePage;
    var tooltipIcon = "ms-1 bi bi-info-circle text-muted";
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Xử lý yêu cầu hỗ trợ</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Danh sách cần xử lý</h5>

            @if (!string.IsNullOrWhiteSpace(TempData["ErrorMessage"] as string))
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }
            @if (!string.IsNullOrWhiteSpace(TempData["SuccessMessage"] as string))
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            <form method="get" class="row g-3 mb-3">
                <div class="col-md-5">
                    <label class="form-label">Từ khóa</label>
                    <input type="text" name="token" value="@Model.Token" class="form-control" placeholder="Tìm theo tiêu đề, nội dung, người gửi" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Bộ phận</label>
                    <select name="targetDepartmentCode" class="form-select">
                        <option value="">-- Tất cả --</option>
                        @foreach (var dept in Model.Departments)
                        {
                            if (Model.TargetDepartmentCode == dept.Code)
                            {
                                <option value="@dept.Code" selected>@dept.Name</option>
                            }
                            else
                            {
                                <option value="@dept.Code">@dept.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="">Tất cả</option>
                        @for (var status = 0; status <= 3; status++)
                        {
                            if (Model.Status == status)
                            {
                                <option value="@status" selected>@crmHuman.Pages.SupportRequest.ProcessingModel.GetStatusText(status)</option>
                            }
                            else
                            {
                                <option value="@status">@crmHuman.Pages.SupportRequest.ProcessingModel.GetStatusText(status)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-outline-primary w-100">Tìm</button>
                </div>
            </form>

            @foreach (var row in Model.RequestList.Data)
            {
                var item = row as VS.Human.Rep.Model.SupportRequestIndexModel;
                if (item == null)
                {
                    continue;
                }

                <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <div class="fw-semibold fs-5">@item.Title</div>
                            <div class="text-muted small">Người gửi: @item.RequesterName | Bộ phận gửi: @item.RequesterDepartmentText</div>
                            <div class="text-muted small">Bộ phận xử lý: @item.TargetDepartmentText | Người được giao: @item.AssignedToName</div>
                        </div>
                        <div>
                            <span class="badge @crmHuman.Pages.SupportRequest.ProcessingModel.GetStatusClass(item.Status)"
                                  data-bs-toggle="tooltip"
                                  title="@crmHuman.Pages.SupportRequest.ProcessingModel.GetStatusTooltip(item.Status)">
                                @crmHuman.Pages.SupportRequest.ProcessingModel.GetStatusText(item.Status)
                            </span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label mb-1">
                            Nội dung sự cố
                            <span data-bs-toggle="tooltip" title="Mô tả gốc do nhân viên gửi lên, dùng để tham chiếu khi tiếp nhận và cập nhật kết quả.">
                                <i class="@tooltipIcon"></i>
                            </span>
                        </label>
                        <div class="p-3 bg-light rounded">@item.Content</div>
                    </div>

                    @if ((item.Attachments?.Count ?? 0) > 0)
                    {
                        <div class="mt-3">
                            <label class="form-label mb-1">Tệp đính kèm</label>
                            <div>
                                @foreach (var file in item.Attachments)
                                {
                                    <a class="me-3" href="@file.FilePath" target="_blank">@file.FileName</a>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(item.ProcessorComment))
                    {
                        <div class="mt-3">
                            <label class="form-label mb-1">Ghi chú xử lý hiện tại</label>
                            <div class="p-3 bg-light rounded">@item.ProcessorComment</div>
                        </div>
                    }

                    @if (item.CanProcess && item.Status != 2 && item.Status != 3)
                    {
                        <form method="post" asp-page-handler="UpdateStatus" class="row g-3 mt-2">
                            <input type="hidden" name="UpdateModel.Id" value="@item.Id" />
                            <div class="col-md-3">
                                <label class="form-label">
                                    Trạng thái mới
                                    <span data-bs-toggle="tooltip" title="Đang xử lý: đã tiếp nhận. Hoàn thành: đã xử lý xong. Đã hủy: tạm dừng/không tiếp tục xử lý.">
                                        <i class="@tooltipIcon"></i>
                                    </span>
                                </label>
                                <select name="UpdateModel.Status" class="form-select" required>
                                    <option value="1">Đang xử lý</option>
                                    <option value="2">Hoàn thành</option>
                                    <option value="3">Đã hủy</option>
                                </select>
                            </div>
                            <div class="col-md-7">
                                <label class="form-label">
                                    Ghi chú cập nhật
                                    <span data-bs-toggle="tooltip" title="Nói rõ cách xử lý, kết quả, lý do hủy hoặc thông tin phản hồi cho nhân viên.">
                                        <i class="@tooltipIcon"></i>
                                    </span>
                                </label>
                                <textarea name="UpdateModel.Comment" class="form-control" rows="2" placeholder="Nhập nội dung phản hồi"></textarea>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">Cập nhật</button>
                            </div>
                        </form>
                    }
                </div>
            }

            @if (Model.RequestList.Total <= 0)
            {
                <div class="text-center text-muted py-4">Không có yêu cầu nào cần xử lý.</div>
            }
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.forEach(function (tooltipTriggerEl) {
            new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
</script>
