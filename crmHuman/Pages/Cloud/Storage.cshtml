@page
@model crmHuman.Pages.Cloud.StorageModel
@{
    ViewData["Title"] = Model.TitlePage;
}

<div class="pagetitle">
    <h1><i class="bi bi-cloud-arrow-up-fill me-2"></i>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-page="/Cloud/Storage">Kho tài liệu</a></li>
            @foreach (var bread in Model.Breadcrumbs)
            {
                <li class="breadcrumb-item"><a asp-page="/Cloud/Storage" asp-route-parentId="@bread.Id">@bread.DisplayText</a></li>
            }
        </ol>
    </nav>
</div>

<section class="section cloud-storage">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="card-title m-0">@(Model.Breadcrumbs.LastOrDefault()?.DisplayText ?? "Thư mục gốc")</h5>
                    <div class="actions">
                        <button class="btn btn-primary rounded-pill px-4 shadow-sm me-2" onclick="showUploadModal()">
                            <i class="bi bi-upload me-2"></i> Tải lên
                        </button>
                        <button class="btn btn-outline-primary rounded-pill px-4" onclick="showFolderModal()">
                            <i class="bi bi-folder-plus me-2"></i> Thư mục mới
                        </button>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th style="width: 30%;">Tên</th>
                                    <th>Người tạo</th>
                                    <th>Cập nhật</th>
                                    <th>Quyền truy cập</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Documents?.Data == null || Model.Documents.Total == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="bi bi-inbox display-1 d-block mb-3 opacity-25"></i>
                                                Chưa có tài liệu nào trong thư mục này
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.Documents.Data)
                                    {
                                        var doc = item as VS.Human.Item.DocumentDataIndexModel;

                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (doc.IsFolder)
                                                    {
                                                        <i class="bi bi-folder-fill text-warning fs-3 me-3"></i>
                                                        <a asp-page="/Cloud/Storage" asp-route-parentId="@doc.Id" class="text-dark fw-bold text-decoration-none">@doc.DisplayText</a>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-file-earmark-text-fill text-primary fs-3 me-3"></i>
                                                        <a href="@doc.ValueFile" target="_blank" class="text-dark text-decoration-none">@doc.DisplayText</a>
                                                    }
                                                </div>
                                            </td>
                                            <td>@doc.AuthorName</td>
                                            <td>@(doc.UpdateAt?.ToString("dd/MM/yyyy HH:mm") ?? doc.CreateAt.ToString("dd/MM/yyyy HH:mm"))</td>
                                            <td>
                                                @switch (doc.AccessLevel)
                                                {
                                                    case 0: <span class="badge bg-secondary rounded-pill"><i class="bi bi-lock-fill me-1"></i> Riêng tư</span> break;
                                                    case 1: <span class="badge bg-info text-dark rounded-pill"><i class="bi bi-building me-1"></i> Nội bộ</span> break;
                                                    case 2: <span class="badge bg-primary rounded-pill"><i class="bi bi-person-check-fill me-1"></i> Giới hạn</span> break;
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="dropdown">
                                                    <button class="btn btn-light btn-sm rounded-circle" type="button" data-bs-toggle="dropdown">
                                                        <i class="bi bi-three-dots-vertical"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                                        <li><a class="dropdown-item" href="javascript:void(0)" onclick="showShareModal(@doc.Id, @doc.AccessLevel)"><i class="bi bi-share me-2"></i> Chia sẻ</a></li>
                                                        <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="confirmDelete(@doc.Id)"><i class="bi bi-trash me-2"></i> Xóa</a></li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="folderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Tạo thư mục mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-bold">Tên thư mục</label>
                    <input type="text" id="folderName" class="form-control" placeholder="Nhập tên thư mục...">
                </div>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="createFolder()">Lưu lại</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Tải lên tài liệu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="upload-area border-2 border-dashed rounded-3 p-5 mb-3 cursor-pointer" onclick="document.getElementById('fileInput').click()">
                    <i class="bi bi-cloud-upload display-3 text-primary opacity-50 mb-3"></i>
                    <p class="m-0">Kéo thả file hoặc click để chọn file</p>
                    <input type="file" id="fileInput" class="d-none" onchange="handleFileSelect(this)">
                </div>
                <div id="selectedFileName" class="fw-bold text-primary"></div>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="btnDoUpload" onclick="uploadFile()" disabled>Bắt đầu tải</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="shareModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Cài đặt chia sẻ</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="shareDocId">
                <div class="mb-4">
                    <label class="form-label fw-bold mb-3">Chế độ truy cập</label>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="access-option text-center p-3 border rounded-3 cursor-pointer" onclick="selectAccess(0)">
                                <i class="bi bi-lock-fill fs-2 d-block mb-2 text-secondary"></i>
                                <span class="fw-bold">Riêng tư</span>
                                <small class="d-block text-muted">Chỉ mình bạn</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="access-option text-center p-3 border rounded-3 cursor-pointer" onclick="selectAccess(1)">
                                <i class="bi bi-building fs-2 d-block mb-2 text-info"></i>
                                <span class="fw-bold">Nội bộ</span>
                                <small class="d-block text-muted">Tất cả nhân viên</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="access-option text-center p-3 border rounded-3 cursor-pointer" onclick="selectAccess(2)">
                                <i class="bi bi-person-check-fill fs-2 d-block mb-2 text-primary"></i>
                                <span class="fw-bold">Giới hạn</span>
                                <small class="d-block text-muted">Những người được chọn</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="restrictedSection" class="d-none">
                    <label class="form-label fw-bold mb-2">Thêm người được quyền xem</label>
                    <div class="input-group mb-3">
                        <select id="userSelect" class="form-select select2">
                            <option value="">Chọn nhân viên...</option>
                            @foreach (var emp in Model.AllEmployees.Data)
                            {
                                var e = emp as VS.Human.Item.EmployeeIndexModel;
                                <option value="@e.Id">@e.FullName (@e.UserName)</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary" onclick="addShareUser()">Thêm</button>
                    </div>
                    <div id="shareList" class="d-flex flex-wrap gap-2"></div>
                </div>

                <div class="mt-4 pt-4 border-top">
                    <label class="form-label fw-bold">Link chia sẻ</label>
                    <div class="input-group">
                        <input type="text" id="shareLinkInput" class="form-control bg-light" readonly>
                        <button class="btn btn-outline-primary" onclick="copyShareLink()"><i class="bi bi-file-earmark-spreadsheet me-1"></i> Copy link</button>
                    </div>
                    <small class="text-muted mt-2 d-block">Người có link vẫn cần đăng nhập hệ thống để xem.</small>
                </div>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-primary rounded-pill px-5" data-bs-dismiss="modal">Xong</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/pages/cloud-storage.js"></script>
    <style>
        .cursor-pointer { cursor: pointer; }
        .upload-area:hover { background-color: #f8f9fa; border-color: #0d6efd !important; }
        .access-option:hover { background-color: #f8f9fa; transform: translateY(-3px); transition: all 0.2s; }
        .access-option.active { border-color: #0d6efd !important; background-color: #f0f7ff; }
    </style>
}
