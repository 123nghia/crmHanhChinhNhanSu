@page
@model SettingModel
@{
    ViewData["Title"] = "Thông tin";

    var userCurrent = Model.UserProfile;
    var dateText = "";
    if (userCurrent.Dob != null)
    {
        dateText = userCurrent.Dob.Value.ToString("dd/MM/yyyy");
    }

    var arrayRol = new List<crmHuman.Model.SelectDisplay>()
    {
        new Model.SelectDisplay() { Code = "1", Name = "Admin" },
        new Model.SelectDisplay() { Code = "2", Name = "TC" },
        new Model.SelectDisplay() { Code = "9", Name = "HCNS" },
        new Model.SelectDisplay() { Code = "3", Name = "TL" },
        new Model.SelectDisplay() { Code = "4", Name = "Marketing" },
        new Model.SelectDisplay() { Code = "6", Name = "Trưởng CTV" }
    };

    string getNameArrol(string roleCode)
    {
        if (roleCode == "1")
        {
            return "Admin";
        }
        if (roleCode == "2")
        {
            return "TC";
        }
        if (roleCode == "9")
        {
            return "HCNS";
        }
        if (roleCode == "3")
        {
            return "Trưởng nhóm";
        }
        return "";
    }
}

<div class="pagetitle">
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0)">Cài đặt</a></li>
        </ol>
    </nav>
</div>

<section class="section profile">
    <div class="row">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Cá nhân hóa giao diện</h5>

                @if (TempData["ThemeSaved"] != null)
                {
                    var saved = TempData["ThemeSaved"]?.ToString();
                    if (saved == "1")
                    {
                        <div class="alert alert-success">Đã lưu cài đặt giao diện.</div>
                    }
                    else
                    {
                        <div class="alert alert-danger">Không thể lưu cài đặt giao diện.</div>
                    }
                }

                <form method="post" asp-page-handler="SaveTheme" class="row g-3">
                    <div class="col-md-4 form-group">
                        <label class="form-label" for="ThemeForm_PrimaryColor">Màu chủ đạo</label>
                        <input type="color" class="form-control form-control-color" asp-for="ThemeForm.PrimaryColor">
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="form-label" for="ThemeForm_ButtonColor">Màu nút</label>
                        <input type="color" class="form-control form-control-color" asp-for="ThemeForm.ButtonColor">
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="form-label" for="ThemeForm_BackgroundColor">Màu nền</label>
                        <input type="color" class="form-control form-control-color" asp-for="ThemeForm.BackgroundColor">
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary" type="submit">Lưu cài đặt</button>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.UserData?.RoleCode == "1")
        {
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Logo hệ thống</h5>

                    @if (TempData["LogoSaved"] != null)
                    {
                        var saved = TempData["LogoSaved"]?.ToString();
                        if (saved == "1")
                        {
                            <div class="alert alert-success">Đã cập nhật logo.</div>
                        }
                        else
                        {
                            <div class="alert alert-danger">Không thể cập nhật logo.</div>
                        }
                    }

                    @if (TempData["LogoError"] != null)
                    {
                        var err = TempData["LogoError"]?.ToString();
                        if (err == "missing")
                        {
                            <div class="alert alert-danger">Vui lòng chọn file logo.</div>
                        }
                        else if (err == "size")
                        {
                            <div class="alert alert-danger">Logo quá lớn (tối đa 2MB).</div>
                        }
                        else if (err == "type")
                        {
                            <div class="alert alert-danger">Chỉ hỗ trợ PNG/JPG.</div>
                        }
                        else
                        {
                            <div class="alert alert-danger">Không thể cập nhật logo.</div>
                        }
                    }

                    <div class="mb-3">
                        <img src="@Model.LogoPath" alt="logo" style="max-height:80px;">
                    </div>

                    <form method="post" asp-page-handler="UpdateLogo" enctype="multipart/form-data" class="row g-3">
                        <div class="col-12 form-group">
                            <label class="form-label" for="LogoFile">Chọn logo (png/jpg, &lt;= 2MB)</label>
                            <input type="file" asp-for="LogoFile" class="form-control" accept=".png,.jpg,.jpeg">
                        </div>
                        <div class="col-12">
                            <button class="btn btn-primary" type="submit">Cập nhật logo</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</section>
