@page
@model IndexModel
@using global::System.Collections.Generic
@using global::System.Linq
@{
    ViewData["Title"] = "Trang chủ";

    var showFilters = Model.HasViewPermission("Candidate") || Model.HasViewPermission("Report");
    var showLeaveSummary = Model.HasViewPermission("LeaveRequest") || Model.HasViewPermission("LeaveBalance") || Model.HasViewPermission("LeaveApproval");
    var showLeaveApproval = Model.HasApprovePermission("LeaveApproval");
    var showLeaveCompany = Model.HasViewPermission("LeaveApproval") || Model.HasViewPermission("LeaveBalance");
    var leaveMonthTitle = Model.LeaveMonthTitle;
    var leaveMonthSub = Model.LeaveMonthSubtitle;
    var showRecruitmentStats = Model.HasViewPermission("Candidate") || Model.HasViewPermission("Job");
    var showOrderOverview = Model.HasViewPermission("Candidate");
    var showActivity = Model.UserData?.RoleCode != "4" && showOrderOverview;
    var showExport = Model.HasViewPermission("Report");
    var showMyLeave = Model.UserData?.RoleCode == "4" && Model.HasViewPermission("LeaveRequest");
    var showExtendedStats = Model.ShowExtendedStats;
    var showOnlineCount = Model.ShowOnlineCount;
    var extendedStats = Model.ExtendedStats;
    var itemdashboard = Model.InfoDashboard;
    var leaveStats = Model.LeaveSummary;
    var roleCode = Model.UserData?.RoleCode ?? string.Empty;
    var isExecutiveDashboard = roleCode == "1" || roleCode == "8" || roleCode == "9";
    var isManagerDashboard = roleCode == "3";
    var isMemberDashboard = roleCode == "4";
    var leftColumnClass = showActivity ? "col-lg-8" : "col-12";
    var upcomingInterviews = Model.UpcomingInterviews?.Data;
    var showUpcomingInterviews = (Model.UserData?.RoleCode != "CANDIDATE" && Model.UpcomingInterviews?.Total > 0);
    var hasActionTasks = Model.ActionCenter?.MyTasks?.Any() == true;
    var hasWorkflowHealth = Model.ActionCenter?.WorkflowHealth?.Any() == true;
    var hasSystemIssues = Model.ActionCenter?.SystemIssues?.Any() == true;
    var hasActionWorkspace = showLeaveApproval || hasActionTasks || hasWorkflowHealth || hasSystemIssues;
    var hasRecruitmentWorkspace = showFilters || showRecruitmentStats || showUpcomingInterviews || showActivity;
    var hasPeopleWorkspace = showLeaveSummary || showLeaveCompany || showOnlineCount || showExtendedStats || showMyLeave;
    var hasInternalNews = Model.HasViewPermission("InternalNews");
    var showPeopleBeforeRecruitment = isExecutiveDashboard || isManagerDashboard;
    var heroKicker = "TRUNG TÂM ĐIỀU HÀNH";
    var heroTitle = "Điều hành nhanh, ít bỏ sót hơn";
    var heroSubtitle = "Tập trung thông báo mới, phê duyệt, lịch sắp tới và các điểm cần xử lý ngay trên một màn hình.";
    var primaryActionHref = isMemberDashboard ? "/Leave/LeaveRequest" : showLeaveApproval ? "/Leave/LeaveApproval" : "/Notifications";
    var primaryActionText = isMemberDashboard ? "Mở nghỉ phép" : showLeaveApproval ? "Mở hộp duyệt" : "Mở trung tâm";
    var secondaryActionHref = string.Equals(primaryActionHref, "/Notifications", global::System.StringComparison.OrdinalIgnoreCase)
        ? (showRecruitmentStats ? "/Candidate" : showLeaveSummary ? "/Leave/LeaveRequest" : null)
        : "/Notifications";
    var secondaryActionText = string.IsNullOrWhiteSpace(secondaryActionHref)
        ? null
        : string.Equals(secondaryActionHref, "/Notifications", global::System.StringComparison.OrdinalIgnoreCase)
            ? "Thông báo"
            : showRecruitmentStats ? "Tuyển dụng" : "Nghỉ phép";
    var actionCenterHref = showLeaveApproval ? "/Leave/LeaveApproval" : "/Notifications";
    var actionCenterText = showLeaveApproval ? "Mở hộp duyệt" : "Mở trung tâm";
    var capabilityLabels = new List<string>();

    if (hasActionWorkspace)
    {
        capabilityLabels.Add("Phê duyệt");
    }

    if (hasPeopleWorkspace)
    {
        capabilityLabels.Add(isMemberDashboard ? "Cá nhân" : "Nhân sự");
    }

    if (hasRecruitmentWorkspace)
    {
        capabilityLabels.Add("Tuyển dụng");
    }

    if (hasInternalNews)
    {
        capabilityLabels.Add("Nội bộ");
    }

    if (isExecutiveDashboard)
    {
        heroKicker = "BẢNG ĐIỀU HÀNH TOÀN HỆ THỐNG";
        heroTitle = "Theo dõi vận hành nhân sự trên cùng một trục";
        heroSubtitle = "Ưu tiên việc chờ duyệt, tình trạng nhân sự, tuyển dụng và điểm nghẽn hệ thống theo góc nhìn điều hành.";
    }
    else if (isManagerDashboard)
    {
        heroKicker = "ĐIỀU PHỐI NHÓM";
        heroTitle = "Nắm việc của nhóm trước khi phát sinh chậm trễ";
        heroSubtitle = "Tập trung vào luồng duyệt, nghỉ phép của nhóm, lịch phỏng vấn và các đầu việc cần phản hồi trong ngày.";
    }
    else if (isMemberDashboard)
    {
        heroKicker = "KHÔNG GIAN CÁ NHÂN";
        heroTitle = "Xử lý việc cá nhân nhanh và rõ ràng hơn";
        heroSubtitle = "Theo dõi phép, thông báo và các việc cần phản hồi của riêng bạn mà không bị lẫn với màn điều hành.";
    }
    else if (hasRecruitmentWorkspace)
    {
        heroKicker = "TRUNG TÂM TUYỂN DỤNG";
        heroTitle = "Theo dõi pipeline tuyển dụng theo nhịp làm việc";
        heroSubtitle = "Giữ các số liệu CV, lịch phỏng vấn, cuộc gọi và thông báo liên quan trong cùng một bố cục thao tác.";
    }

    Func<int?, string> getRoundText = value =>
    {
        switch (value)
        {
            case 1: return "HR";
            case 2: return "Kỹ thuật";
            case 3: return "Vòng cuối";
            case 0: return "Khác";
            default: return "";
        }
    };

    Func<int?, string> getStatusText = value =>
    {
        switch (value)
        {
            case 0: return "Nháp";
            case 1: return "Đã lên lịch";
            case 2: return "Hoàn tất";
            case 3: return "Đã hủy";
            case 4: return "Vắng mặt";
            default: return "";
        }
    };

    Func<int?, string> getModeText = value =>
    {
        switch (value)
        {
            case 1: return "Trực tiếp";
            case 2: return "Trực tuyến";
            default: return "";
        }
    };
}


@*    <main id="main" class="main"> *@

<div class="pagetitle"> 
    <h1>Bảng điều khiển</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Bảng điều khiển</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

@await Html.PartialAsync("/Pages/Shared/_DashboardRoleLayout.cshtml", Model)

@if (false)
{
<section class="section dashboard">
    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card admin-workspace-hero">
                <div class="card-body">
                    <div class="admin-workspace-hero-head">
                        <div>
                            <span class="admin-workspace-kicker">TRUNG TÂM ĐIỀU HÀNH</span>
                            <h5 class="admin-workspace-title mb-2">Điều hành nhanh, ít bỏ sót hơn</h5>
                            <p class="admin-workspace-subtitle mb-0">Tập trung thông báo mới, phê duyệt, lịch sắp tới và các điểm cần xử lý ngay trên một màn hình.</p>
                        </div>
                        <div class="admin-workspace-actions">
                            <a class="btn btn-primary" href="/Notifications">Mở trung tâm</a>
                            @if (showLeaveApproval)
                            {
                                <a class="btn btn-outline-primary" href="/Leave/LeaveApproval">Hộp duyệt</a>
                            }
                        </div>
                    </div>
                    <div class="admin-workspace-grid">
                        <a class="workspace-stat-card" href="/Notifications">
                            <span class="workspace-stat-label">Thông báo mới</span>
                            <strong>@Model.UnreadNotificationCount</strong>
                            <small>@(Model.UnreadNotificationCount > 0 ? "Cần xem ngay" : "Đã xử lý hết")</small>
                        </a>
                        @if (showLeaveApproval)
                        {
                            <a class="workspace-stat-card" href="/Leave/LeaveApproval">
                                <span class="workspace-stat-label">Chờ tôi duyệt</span>
                                <strong>@(leaveStats?.PendingApproval ?? 0)</strong>
                                <small>Mở hộp duyệt</small>
                            </a>
                        }
                        else if (showLeaveSummary)
                        {
                            <a class="workspace-stat-card" href="/Leave/LeaveRequest">
                                <span class="workspace-stat-label">Quỹ phép còn lại</span>
                                <strong>@(leaveStats?.RemainingLeave ?? 0)</strong>
                                <small>Ngày phép năm @DateTime.Now.Year</small>
                            </a>
                        }

                        @if (showUpcomingInterviews)
                        {
                            <a class="workspace-stat-card" href="/ScheduleInterview">
                                <span class="workspace-stat-label">Lịch phỏng vấn sắp tới</span>
                                <strong>@(Model.UpcomingInterviews?.Total ?? 0)</strong>
                                <small>Theo dõi trong ngày</small>
                            </a>
                        }
                        else if (showRecruitmentStats)
                        {
                            <a class="workspace-stat-card" href="/Candidate">
                                <span class="workspace-stat-label">Ứng viên đang theo dõi</span>
                                <strong>@(itemdashboard?.totalCV ?? 0)</strong>
                                <small>@(itemdashboard?.totalOnboard ?? 0) nhận việc</small>
                            </a>
                        }

                        @if (showOnlineCount)
                        {
                            <a class="workspace-stat-card" href="/Employee">
                                <span class="workspace-stat-label">Người dùng đang online</span>
                                <strong>@Model.UserDataGlobal.GetCountUserOnline()</strong>
                                <small>@Model.GlobalData.TotalUser tổng người dùng</small>
                            </a>
                        }
                        else if (Model.HasViewPermission("InternalNews"))
                        {
                            <a class="workspace-stat-card" href="/InternalNews">
                                <span class="workspace-stat-label">Tin nội bộ</span>
                                <strong>Mở</strong>
                                <small>Xem và đăng thông báo</small>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card action-center-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
                        <div>
                            <h5 class="card-title mb-0">Trung tâm xử lý</h5>
                            <div class="text-muted small">Việc cần xử lý, điểm nghẽn và lỗi vận hành đang ảnh hưởng workflow.</div>
                        </div>
                        <a class="btn btn-sm btn-primary" href="/Leave/LeaveApproval">Mở hộp duyệt</a>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-lg-3 col-md-6">
                            <a class="action-tile" href="/Leave/LeaveApproval">
                                <span class="action-tile-label">Chờ tôi xử lý</span>
                                <strong>@(Model.ActionCenter?.MyTasks?.Count ?? 0)</strong>
                                <small>@((Model.ActionCenter?.MyTasks?.Count(x => x.IsOverdue) ?? 0)) quá hạn</small>
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a class="action-tile" href="/Leave/LeaveApproval?overdue=1">
                                <span class="action-tile-label">Sắp/đã quá SLA</span>
                                <strong>@(Model.ActionCenter?.WorkflowHealth?.Sum(x => x.OverdueCount) ?? 0)</strong>
                                <small>theo Quản lý / HCNS / BGD</small>
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a class="action-tile" href="/Leave/LeaveApproval?issue=attendance-sync">
                                <span class="action-tile-label">Sự cố hệ thống</span>
                                <strong>@(Model.ActionCenter?.SystemIssues?.Sum(x => x.Count) ?? 0)</strong>
                                <small>mail / đồng bộ chấm công</small>
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a class="action-tile" href="/Candidate">
                                <span class="action-tile-label">Cuộc gọi hôm nay</span>
                                <strong>@(Model.TelephonyDashboard?.TotalToday ?? 0)</strong>
                                <small>@(Model.TelephonyDashboard?.SuccessToday ?? 0) thành công / @(Model.TelephonyDashboard?.FailedToday ?? 0) thất bại</small>
                            </a>
                        </div>
                    </div>
                    @if (Model.ActionCenter?.MyTasks?.Any() == true)
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Yêu cầu</th>
                                        <th>Bước xử lý</th>
                                        <th>Người phụ trách</th>
                                        <th>Thời gian chờ</th>
                                        <th>SLA</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var task in Model.ActionCenter.MyTasks.Take(6))
                                    {
                                        <tr class="@(task.IsOverdue ? "table-warning" : "")">
                                            <td>
                                                <div class="fw-semibold">@task.RequestCode</div>
                                                <div class="text-muted small">@task.Title</div>
                                            </td>
                                            <td>@task.CurrentStep</td>
                                            <td>@(task.CurrentOwnerName ?? "--")</td>
                                            <td>@task.WaitingHours h</td>
                                            <td>
                                                @if (task.IsOverdue)
                                                {
                                                    <span class="badge bg-danger">QUÁ HẠN</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">ĐÚNG HẠN</span>
                                                }
                                            </td>
                                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="@task.Url">Xử lý</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <div class="row g-3 mt-1">
                        <div class="col-lg-6">
                            <div class="mini-panel">
                                <div class="fw-semibold mb-2">Tình trạng luồng duyệt</div>
                                @foreach (var item in Model.ActionCenter?.WorkflowHealth ?? new List<VS.Human.Rep.Model.WorkflowHealthItem>())
                                {
                                    <div class="d-flex justify-content-between small py-1">
                                        <span>@item.StepName</span>
                                        <span>@item.PendingCount đang chờ / @item.OverdueCount quá hạn</span>
                                    </div>
                                }
                                @if (Model.ActionCenter?.WorkflowHealth?.Any() != true)
                                {
                                    <div class="text-muted small">Không có điểm nghẽn chờ xử lý.</div>
                                }
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mini-panel">
                                <div class="fw-semibold mb-2">Diễn biến gần đây</div>
                                @foreach (var item in Model.ActionCenter?.RecentTimeline?.Take(5) ?? new List<VS.Human.Rep.Model.WorkflowTimelineEvent>())
                                {
                                    <div class="small py-1">
                                        <span class="fw-semibold">@item.EventCode</span>
                                        <span class="text-muted">@item.EventTitle</span>
                                    </div>
                                }
                                @if (Model.ActionCenter?.RecentTimeline?.Any() != true)
                                {
                                    <div class="text-muted small">Dòng thời gian sẽ hiển thị khi có sự kiện quy trình mới.</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        @if (showFilters)
        {
            <div class="col-12">
                <div class="card dashboard-filter-card">
                    <div class="card-body">
                        <div class="dashboard-section-head">
                            <div>
                                <h5 class="card-title mb-1">Bộ lọc điều hành</h5>
                                <div class="text-muted small">Lọc nhanh theo thời gian, nhóm và thành viên để xem số liệu cần dùng ngay.</div>
