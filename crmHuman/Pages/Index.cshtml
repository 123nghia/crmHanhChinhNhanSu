                                                <i class="bi bi-people"></i>
                                            </div>
                                            <div class="ps-3">
                                                <h6>@(leaveStats?.ApprovedMonth ?? 0) lượt</h6>
                                                <span class="text-muted small pt-2 ps-1">@leaveMonthSub</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
