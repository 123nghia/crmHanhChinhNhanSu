                                                <span class="text-success small pt-1 fw-bold">@Model.GlobalData.TotalUser</span>
                                                <span class="text-muted small pt-2 ps-1">Tổng người dùng</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (showRecruitmentStats)
                        {
                            <!-- Recruitment Stats for Admin/HCNS -->
                            <div class="col-xxl-4 col-md-6">
                            <div class="card info-card sales-card">
                                <div class="card-body">
                                    <h5 class="card-title">Số lượng CV</h5>
                                    <div class="d-flex align-items-center">
                                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                            <i class="bi bi-file-earmark-person"></i>
                                        </div>
                                        <div class="ps-3">
                                                <h6>@itemdashboard.totalCVInput</h6>
                                        </div>
                                    </div>
                                </div> 
                            </div>
                        </div>
                        <div class="col-xxl-4 col-md-6">
                            <div class="card info-card sales-card">



                                <div class="card-body">

                                    <h5 class="card-title">Số lượng ứng tuyển </h5>
