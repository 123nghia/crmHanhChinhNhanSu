@page
@model IndexModel
@using global::System.Linq
@{
    ViewData["Title"] = "Home page";

    var showFilters = Model.HasViewPermission("Candidate") || Model.HasViewPermission("Report");
    var showLeaveSummary = Model.HasViewPermission("LeaveRequest") || Model.HasViewPermission("LeaveBalance") || Model.HasViewPermission("LeaveApproval");
    var showLeaveApproval = Model.HasApprovePermission("LeaveApproval");
    var showLeaveCompany = Model.HasViewPermission("LeaveApproval") || Model.HasViewPermission("LeaveBalance");
    var isEmployeeLeaveView = Model.UserData?.RoleCode == "2";
    var leaveMonthTitle = isEmployeeLeaveView ? "Nghỉ phép tháng này của bạn" : "Nghỉ phép tháng này";
    var leaveMonthSub = isEmployeeLeaveView ? "bản thân" : "toàn công ty";
    var showRecruitmentStats = Model.HasViewPermission("Candidate") || Model.HasViewPermission("Job");
    var showOrderOverview = Model.HasViewPermission("Candidate");
    var showActivity = Model.UserData?.RoleCode != "4" && showOrderOverview;
    var showExport = Model.HasViewPermission("Report");
    var showMyLeave = Model.UserData?.RoleCode == "4" && Model.HasViewPermission("LeaveRequest");
    var showExtendedStats = Model.UserData?.RoleCode != "2";
    var extendedStats = Model.ExtendedStats;
    var leftColumnClass = showActivity ? "col-lg-8" : "col-12";

    var upcomingInterviews = Model.UpcomingInterviews?.Data;
    var showUpcomingInterviews = (Model.UserData?.RoleCode != "CANDIDATE" && Model.UpcomingInterviews?.Total > 0);

    Func<int?, string> getRoundText = value =>
    {
        switch (value)
        {
            case 1: return "HR";
            case 2: return "Technical";
            case 3: return "Final";
            case 0: return "Khác";
            default: return "";
        }
    };

    Func<int?, string> getStatusText = value =>
    {
        switch (value)
        {
            case 0: return "Draft";
            case 1: return "Scheduled";
            case 2: return "Done";
            case 3: return "Canceled";
            case 4: return "No-show";
            default: return "";
        }
    };

    Func<int?, string> getModeText = value =>
    {
        switch (value)
        {
            case 1: return "Offline";
            case 2: return "Online";
            default: return "";
        }
    };
}


@*    <main id="main" class="main"> *@

<div class="pagetitle"> 
    <h1>Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section dashboard">
    
    <div class="row">
        @if (showFilters)
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <form class="row" method="get" action="/">

                <div class="col-md-2">
                    <label class="form-label">Từ Ngày</label>
                    <input value="@Model.RequestPage.FromText" id="fromDate" type="date" name="from" class="form-control">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Đến ngày</label>
                    <input value="@Model.RequestPage.ToText"  id ="toDate" type="date" name="to" class="form-control">
                </div>


                 @if(Model.Permision.SearchGrop == true)
    {
                    @if (Model.RequestPage.RoleCode == "3")
           {
            <div class="col-md-2" style="display: none;">
                            <label class="form-label">Nhóm</label>
                            <select id ="cbgroup" name="groupId"  class="form-select" aria-label="">
                                <option value="tat-ca">Tất cả</option>
                            

                            </select>
                        </div>
           }
           else 
           {
                <div class="col-md-2">
                            <label class="form-label">Nhóm</label>
                            <select id ="cbgroup" name="groupId"  class="form-select" aria-label="">
                                <option value="tat-ca">Tất cả</option>
                            

                            </select>
                        </div>
           }


            <div class="col-md-3">
                <label class="form-label">Thành viên</label>
                <select id ="cbmember" name="memberId" class="form-select" aria-label="">
                    <option selected>Tất cả</option>
                
                </select>
            </div>
    }



                <div class="col-12 text-end">
                    @if (showExport)
                    {
                        <button type="button" onclick="exportFileDashboard()" class="btn btn-primary">Xuất file</button>
                    }
                    <button type="submit" class="btn btn-primary">Tìm kiém</button>
                </div>



                        </form>
                    </div>
                </div>
            </div>
        }
        
        <!-- Left side columns -->
            <div class="@leftColumnClass">
                    <div class="row">

                        <!-- Sales Card -->
                        @{
                            var itemdashboard = Model.InfoDashboard;
                            var leaveStats = Model.LeaveSummary;
                        }
                        
                        <!-- Role-based Leave Cards -->
                        @if (showLeaveSummary)
                        {
                            <div class="col-xxl-4 col-md-6">
                            <div class="card info-card revenue-card">
                                <div class="card-body">
                                    <h5 class="card-title">Quỹ phép còn lại</h5>
                                    <div class="d-flex align-items-center">
                                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                            <i class="bi bi-calendar-check"></i>
                                        </div>
                                        <div class="ps-3">
                                            <h6>@(leaveStats?.RemainingLeave ?? 0) ngày</h6>
                                            <span class="text-muted small pt-2 ps-1">năm @DateTime.Now.Year</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            </div>
                        }

                        @if (showLeaveApproval)
                        {
                            <div class="col-xxl-4 col-md-6">
                                <div class="card info-card sales-card">
                                    <div class="card-body">
                                        <h5 class="card-title">Chờ tôi duyệt</h5>
                                        <div class="d-flex align-items-center">
                                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="bi bi-person-check"></i>
                                            </div>
                                            <div class="ps-3">
                                                <h6>@(leaveStats?.PendingApproval ?? 0) đơn</h6>
                                                <a href="/Leave/LeaveApproval" class="text-primary small pt-1 fw-bold">Xử lý ngay</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (showLeaveCompany)
                        {
                            <div class="col-xxl-4 col-md-6">
                                <div class="card info-card customers-card">
                                    <div class="card-body">
                                        <h5 class="card-title">@leaveMonthTitle</h5>
                                        <div class="d-flex align-items-center">
                                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="bi bi-people"></i>
                                            </div>
                                            <div class="ps-3">
                                                <h6>@(leaveStats?.ApprovedMonth ?? 0) lượt</h6>
                                                <span class="text-muted small pt-2 ps-1">@leaveMonthSub</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (showRecruitmentStats)
                        {
                            <!-- Recruitment Stats for Admin/HCNS -->
                            <div class="col-xxl-4 col-md-6">
                            <div class="card info-card sales-card">
                                <div class="card-body">
                                    <h5 class="card-title">Số lượng CV</h5>
                                    <div class="d-flex align-items-center">
                                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                            <i class="bi bi-file-earmark-person"></i>
                                        </div>
                                        <div class="ps-3">
                                                <h6>@itemdashboard.totalCVInput</h6>
                                        </div>
                                    </div>
                                </div> 
                            </div>
                        </div>
                        <div class="col-xxl-4 col-md-6">
                            <div class="card info-card sales-card">



                                <div class="card-body">

                                    <h5 class="card-title">Số lượng ứng tuyển </h5>
                                    <div class="d-flex align-items-center">
                                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                            <i class="bi bi-cart"></i>
                                        </div>
                                        <div class="ps-3">
                                                <h6>@itemdashboard.totalCV</h6>
                                            <!-- <span class="text-success small pt-1 fw-bold">12%</span> <span class="text-muted small pt-2 ps-1">increase</span> -->

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    
                        <div class="col-xxl-4 col-xl-12">

                            <div class="card info-card customers-card">



                                <div class="card-body">

                                    <h5 class="card-title">Ứng viên Onboard </h5>
                                    <div class="d-flex align-items-center">
                                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                            <i class="bi bi-people"></i>
                                        </div>
                                        <div class="ps-3">
                                            <h6>@itemdashboard.totalOnboard</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        }
                    
                        


                        @if (showExtendedStats)
                        {
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <h5 class="card-title">Thống kê nhân sự</h5>
                                        @if (extendedStats.ContractStats != null && extendedStats.ContractStats.Count > 0)
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-sm">
                                                    <thead>
                                                        <tr>
                                                            <th>HĐLĐ</th>
                                                            <th>Số lượng</th>
                                                            <th>Tỷ lệ</th>
                                                            <th>Chi tiết</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var group in extendedStats.ContractStats)
                                                        {
                                                            <tr>
                                                                <td>@group.Title</td>
                                                                <td>@group.Value</td>
                                                                <td>@($"{group.Percent:0.#}%")</td>
                                                                <td>
                                                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                                                            data-bs-toggle="modal" data-bs-target="#@($"modal-{group.Key}")">
                                                                        Xem
                                                                    </button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted">Chưa có dữ liệu hợp đồng.</div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="col-xxl-4 col-md-6">
                                <div class="card info-card sales-card">
                                    <div class="card-body">
                                        <h5 class="card-title">HĐLĐ sắp đến hạn</h5>
                                        <div class="d-flex align-items-center">
                                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="bi bi-calendar2-week"></i>
                                            </div>
                                            <div class="ps-3">
                                                <h6>@extendedStats.ExpiringContracts.Value</h6>
                                                <span class="text-muted small pt-1">@($"{extendedStats.ExpiringContracts.Percent:0.#}%") nhân sự</span>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" data-bs-toggle="modal" data-bs-target="#modal-expiring-contracts">
                                            Xem chi tiết
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xxl-4 col-md-6">
                                <div class="card info-card sales-card">
                                    <div class="card-body">
                                        <h5 class="card-title">Ứng viên</h5>
                                        <div class="d-flex align-items-center">
                                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="bi bi-people"></i>
                                            </div>
                                            <div class="ps-3">
                                                <h6>@extendedStats.CandidateTotal.Value</h6>
                                                <span class="text-muted small pt-1">PV đạt: @extendedStats.CandidatePass.Value (@($"{extendedStats.CandidatePass.Percent:0.#}%"))</span>
                                            </div>
                                        </div>
                                        <div class="mt-2 d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modal-candidate-total">Tất cả</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modal-candidate-pass">PV đạt</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xxl-4 col-md-6">
                                <div class="card info-card customers-card">
                                    <div class="card-body">
                                        <h5 class="card-title">Ngày phép trong tháng</h5>
                                        <div class="d-flex align-items-center">
                                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="bi bi-calendar-check"></i>
                                            </div>
                                            <div class="ps-3">
                                                <h6>@extendedStats.LeaveMonth.Value @extendedStats.LeaveMonth.Unit</h6>
                                                <span class="text-muted small pt-1">Duyệt: @($"{extendedStats.LeaveMonth.Percent:0.#}%")</span>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" data-bs-toggle="modal" data-bs-target="#modal-leave-month">
                                            Xem chi tiết
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xxl-4 col-md-6">
                                <div class="card info-card customers-card">
                                    <div class="card-body">
                                        <h5 class="card-title">Tình trạng nhân sự</h5>
                                        <div class="ps-1 small">
                                            <div>
                                                Đang làm việc:
                                                <a href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#modal-employee-working">
                                                    @extendedStats.EmployeeWorking.Value (@($"{extendedStats.EmployeeWorking.Percent:0.#}%"))
                                                </a>
                                            </div>
                                            <div>
                                                Nghỉ việc:
                                                <a href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#modal-employee-resigned">
                                                    @extendedStats.EmployeeResigned.Value (@($"{extendedStats.EmployeeResigned.Percent:0.#}%"))
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xxl-4 col-md-6">
                                <div class="card info-card revenue-card">
                                    <div class="card-body">
                                        <h5 class="card-title">Nhân viên chính thức</h5>
                                        <div class="d-flex align-items-center">
                                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="bi bi-person-badge"></i>
                                            </div>
                                            <div class="ps-3">
                                                <h6>@extendedStats.OfficialEmployees.Value</h6>
                                                <span class="text-muted small pt-1">@($"{extendedStats.OfficialEmployees.Percent:0.#}%") tổng nhân sự</span>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" data-bs-toggle="modal" data-bs-target="#modal-employee-official">
                                            Xem chi tiết
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (showMyLeave)
                        {
                            <!-- Personal Dashboard for Members -->
                            <div class="col-12">
                                <div class="card recent-sales overflow-auto">
                                    <div class="card-body">
                                        <h5 class="card-title">Đơn nghỉ phép của tôi</h5>
                                        <div class="table-responsive">
                                            <table class="table table-borderless">
                                                <thead>
                                                    <tr>
                                                        <th>Loại phép</th>
                                                        <th>Từ ngày</th>
                                                        <th>Đến ngày</th>
                                                        <th>Số ngày</th>
                                                        <th>Trạng thái</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="myLeaveList">
                                                    <tr>
                                                        <td colspan="5" class="text-center">Đang tải dữ liệu...</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="text-center mt-3">
                                            <a href="/Leave/LeaveRequest" class="btn btn-sm btn-outline-primary">Quản lý phép cá nhân</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (showUpcomingInterviews)
                        {
                            <div class="col-12">
                                <div class="card recent-sales overflow-auto">
                                    <div class="card-body">
                                        <h5 class="card-title">@((Model.UserData?.RoleCode == "1") ? "Tất cả lịch phỏng vấn sắp tới" : "Lịch phỏng vấn của tôi")</h5>
                                        <div class="table-responsive">
                                            <table class="table table-borderless">
                                                <thead>
                                                    <tr>
                                                        <th>Ứng viên</th>
                                                        <th>Vị trí</th>
                                                        <th>Vòng</th>
                                                        <th>Thời gian</th>
                                                        <th>Hình thức</th>
                                                        <th>Trạng thái</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in upcomingInterviews)
                                                    {
                                                        var itemInfo = item as dynamic;
                                                        var scheduleDate = itemInfo?.ScheduleDate != null ? ((DateTime)itemInfo.ScheduleDate).ToString("dd/MM/yyyy HH:mm") : "--";
                                                        <tr>
                                                            <td>
                                                                <a href="/CandidateDetail?id=@itemInfo.RelId" class="text-primary fw-bold">@itemInfo.CandidateFullName</a>
                                                            </td>
                                                            <td>@itemInfo.PositionText</td>
                                                            <td>@getRoundText(itemInfo.Type)</td>
                                                            <td>@scheduleDate</td>
                                                            <td><span class="badge @(itemInfo.InterviewMode == 2 ? "bg-info" : "bg-secondary")">@getModeText(itemInfo.InterviewMode)</span></td>
                                                            <td><span class="badge bg-success">@getStatusText(itemInfo.Status)</span></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="text-center mt-3">
                                            <a href="/ScheduleInterview" class="btn btn-sm btn-outline-primary">Xem tất cả lịch phỏng vấn</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
            </div><!-- End Left side columns -->
                @if (showActivity)
                {
                    <!-- Right side columns -->
                    <div class="col-lg-4">

                    <!-- Recent Activity -->
                    <div class="card">
                        <div class="filter">
                            <a class="icon" href="#" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                <li class="dropdown-header text-start">
                                    <h6>Filter</h6>
                                </li>

                                <li><a class="dropdown-item" href="#">Hôm nay</a></li>
                                <li><a class="dropdown-item" href="#">Thàng này</a></li>
                             
                            </ul>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title">Hoạt đông gần đây </h5>

                            <div class="activity">
                        @if (Model.TopImpact != null && Model.TopImpact.Data != null)
                        {
                            @foreach (var item in Model.TopImpact.Data)
                        {
                            var itemImpact = item as dynamic;
                     
                            <div class="activity-item d-flex">
                                <div class="activite-label">@itemImpact.CreateAt</div>
                                <i class='bi bi-circle-fill activity-badge text-success align-self-start'></i>
                                <div class="activity-content">
                                    Đơn hàng @itemImpact.OrderCode đã được cập nhật bởi @itemImpact.CreatedByName
                                    Trạng thái: @itemImpact.StatusName 
                                   
                                </div>
                            </div>

                        

                            }
                        }
                        
                               

                               
                            </div>

                        </div>
                    </div><!-- End Recent Activity -->
                   
                 
                  
                    

                    </div><!-- End Right side columns -->
                }

            </div>
        </section>

    @* </main> *@
 

 
@if (showExtendedStats)
{
    @foreach (var group in extendedStats.ContractStats)
    {
        <div class="modal fade" id="@($"modal-{group.Key}")" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Chi tiết HĐLĐ - @group.Title</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @if (group.Details != null && group.Details.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Nhân viên</th>
                                            <th>Thông tin</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in group.Details)
                                        {
                                            <tr>
                                                <td>@item.Name</td>
                                                <td>@(string.IsNullOrWhiteSpace(item.SubText) ? "--" : item.SubText)</td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(item.Url))
                                                    {
                                                        <a class="btn btn-sm btn-outline-primary" href="@item.Url">Xem</a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">Không có dữ liệu.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="modal fade" id="modal-expiring-contracts" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">HĐLĐ sắp đến hạn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (extendedStats.ExpiringContracts.Details != null && extendedStats.ExpiringContracts.Details.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Nhân viên</th>
                                        <th>Hết hạn</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in extendedStats.ExpiringContracts.Details)
                                    {
                                        <tr>
                                            <td>@item.Name</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.SubText) ? "--" : item.SubText)</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(item.Url))
                                                {
                                                    <a class="btn btn-sm btn-outline-primary" href="@item.Url">Xem</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">Không có dữ liệu.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modal-candidate-total" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Tổng số ứng viên</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (extendedStats.CandidateTotal.Details != null && extendedStats.CandidateTotal.Details.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Ứng viên</th>
                                        <th>Vị trí</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in extendedStats.CandidateTotal.Details)
                                    {
                                        <tr>
                                            <td>@item.Name</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.SubText) ? "--" : item.SubText)</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(item.Url))
                                                {
                                                    <a class="btn btn-sm btn-outline-primary" href="@item.Url">Xem</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">Không có dữ liệu.</div>
                    }
                </div>
            </div>
        </div>
    </div>

