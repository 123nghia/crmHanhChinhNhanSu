<script>
   var groupSearch = "@Model.RequestPage.GroupId";
   var memberSearch = "@Model.RequestPage.MemberId";
   
   
   var roleCode = "@Model.UserData.RoleCode";
   var canLoadMyLeave = @showMyLeave.ToString().ToLowerInvariant();
   var extraSearchRequest  = {groupSearch,memberSearch};

   if (canLoadMyLeave) {
       // Fetch personal leave list for member dashboard
       fetch('/Leave/LeaveRequest?handler=LeaveList&limit=5')
           .then(res => res.json())
           .then(data => {
               let html = '';
               if (data.data && data.data.length > 0) {
                   data.data.forEach(item => {
                       html += `<tr>
                           <td>${item.leaveTypeName}</td>
                           <td>${moment(item.fromDate).format('DD/MM/YYYY')}</td>
                           <td>${moment(item.toDate).format('DD/MM/YYYY')}</td>
                           <td>${item.numDays}</td>
                           <td><span class="badge ${getStatusBadgeClass(item.status)}">${getStatusText(item.status)}</span></td>
                       </tr>`;
                   });
               } else {
                   html = '<tr><td colspan="5" class="text-center">Chưa có đơn nghỉ phép nào</td></tr>';
               }
               var target = document.getElementById('myLeaveList');
               if (target) {
                   target.innerHTML = html;
               }
           });
   }

   function getStatusBadgeClass(status) {
       switch (status) {
           case 0: return 'bg-warning text-dark';
           case 1: return 'bg-info text-dark';
           case 2: return 'bg-primary';
           case 3: return 'bg-success';
           case 4: return 'bg-success';
           case 5: return 'bg-danger';
           case 6: return 'bg-secondary';
           default: return 'bg-light text-dark';
       }
   }

   function getStatusText(status) {
       switch (status) {
           case 0: return 'Chờ Lead duyệt';
           case 1: return 'Chờ HCNS duyệt';
           case 2: return 'Chờ BGĐ duyệt';
           case 3: return 'Đã duyệt';
           case 4: return 'HCNS duyệt thay';
           case 5: return 'Từ chối';
           case 6: return 'Đã hủy';
           default: return 'Không xác định';
       }
   }

</script>


