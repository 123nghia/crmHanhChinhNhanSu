                    }
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                    </div>
                </div>



                        </form>
                    </div>
                </div>
            </div>
        }
        
        <!-- Left side columns -->
            <div class="@leftColumnClass">
                    <div class="row">

                        <!-- Sales Card -->
                        <!-- Role-based Leave Cards -->
