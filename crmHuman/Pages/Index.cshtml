@page
@model IndexModel
@using global::System.Linq
@{
    ViewData["Title"] = "Home page";

    var showFilters = Model.HasViewPermission("Candidate") || Model.HasViewPermission("Report");
    var showLeaveSummary = Model.HasViewPermission("LeaveRequest") || Model.HasViewPermission("LeaveBalance") || Model.HasViewPermission("LeaveApproval");
    var showLeaveApproval = Model.HasApprovePermission("LeaveApproval");
    var showLeaveCompany = Model.HasViewPermission("LeaveApproval") || Model.HasViewPermission("LeaveBalance");
    var leaveMonthTitle = Model.LeaveMonthTitle;
    var leaveMonthSub = Model.LeaveMonthSubtitle;
    var showRecruitmentStats = Model.HasViewPermission("Candidate") || Model.HasViewPermission("Job");
    var showOrderOverview = Model.HasViewPermission("Candidate");
    var showActivity = Model.UserData?.RoleCode != "4" && showOrderOverview;
    var showExport = Model.HasViewPermission("Report");
    var showMyLeave = Model.UserData?.RoleCode == "4" && Model.HasViewPermission("LeaveRequest");
    var showExtendedStats = Model.ShowExtendedStats;
    var showOnlineCount = Model.ShowOnlineCount;
    var extendedStats = Model.ExtendedStats;
    var itemdashboard = Model.InfoDashboard;
    var leaveStats = Model.LeaveSummary;
    var leftColumnClass = showActivity ? "col-lg-8" : "col-12";

    var upcomingInterviews = Model.UpcomingInterviews?.Data;
    var showUpcomingInterviews = (Model.UserData?.RoleCode != "CANDIDATE" && Model.UpcomingInterviews?.Total > 0);

    Func<int?, string> getRoundText = value =>
    {
        switch (value)
        {
            case 1: return "HR";
            case 2: return "Technical";
            case 3: return "Final";
            case 0: return "Khác";
            default: return "";
        }
    };

    Func<int?, string> getStatusText = value =>
    {
        switch (value)
        {
            case 0: return "Draft";
            case 1: return "Scheduled";
            case 2: return "Done";
            case 3: return "Canceled";
            case 4: return "No-show";
            default: return "";
        }
    };

    Func<int?, string> getModeText = value =>
    {
        switch (value)
        {
            case 1: return "Offline";
            case 2: return "Online";
            default: return "";
        }
    };
}


@*    <main id="main" class="main"> *@

<div class="pagetitle"> 
    <h1>Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section dashboard">
    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card admin-workspace-hero">
                <div class="card-body">
                    <div class="admin-workspace-hero-head">
                        <div>
                            <span class="admin-workspace-kicker">ADMIN WORKSPACE</span>
                            <h5 class="admin-workspace-title mb-2">Dieu hanh nhanh, it bo sot hon</h5>
                            <p class="admin-workspace-subtitle mb-0">Tap trung thong bao moi, approval, lich sap toi va cac diem can xu ly ngay tren mot man hinh.</p>
                        </div>
                        <div class="admin-workspace-actions">
                            <a class="btn btn-primary" href="/Notifications">Mo trung tam</a>
                            @if (showLeaveApproval)
                            {
                                <a class="btn btn-outline-primary" href="/Leave/LeaveApproval">Approval inbox</a>
                            }
                        </div>
                    </div>
                    <div class="admin-workspace-grid">
                        <a class="workspace-stat-card" href="/Notifications">
                            <span class="workspace-stat-label">Thong bao moi</span>
                            <strong>@Model.UnreadNotificationCount</strong>
                            <small>@(Model.UnreadNotificationCount > 0 ? "Can xem ngay" : "Da xu ly het")</small>
                        </a>
                        @if (showLeaveApproval)
                        {
                            <a class="workspace-stat-card" href="/Leave/LeaveApproval">
                                <span class="workspace-stat-label">Cho toi duyet</span>
                                <strong>@(leaveStats?.PendingApproval ?? 0)</strong>
                                <small>Mo approval inbox</small>
                            </a>
                        }
                        else if (showLeaveSummary)
                        {
                            <a class="workspace-stat-card" href="/Leave/LeaveRequest">
                                <span class="workspace-stat-label">Quy phep con lai</span>
                                <strong>@(leaveStats?.RemainingLeave ?? 0)</strong>
                                <small>Ngay phep nam @DateTime.Now.Year</small>
                            </a>
                        }

                        @if (showUpcomingInterviews)
                        {
                            <a class="workspace-stat-card" href="/ScheduleInterview">
                                <span class="workspace-stat-label">Lich phong van sap toi</span>
                                <strong>@(Model.UpcomingInterviews?.Total ?? 0)</strong>
                                <small>Theo doi trong ngay</small>
                            </a>
                        }
                        else if (showRecruitmentStats)
                        {
                            <a class="workspace-stat-card" href="/Candidate">
                                <span class="workspace-stat-label">Ung vien dang theo doi</span>
                                <strong>@(itemdashboard?.totalCV ?? 0)</strong>
                                <small>@(itemdashboard?.totalOnboard ?? 0) onboard</small>
                            </a>
                        }

                        @if (showOnlineCount)
                        {
                            <a class="workspace-stat-card" href="/Employee">
                                <span class="workspace-stat-label">User dang online</span>
                                <strong>@Model.UserDataGlobal.GetCountUserOnline()</strong>
                                <small>@Model.GlobalData.TotalUser tong user</small>
                            </a>
                        }
                        else if (Model.HasViewPermission("InternalNews"))
                        {
                            <a class="workspace-stat-card" href="/InternalNews">
                                <span class="workspace-stat-label">Tin noi bo</span>
                                <strong>Mo</strong>
                                <small>Xem va dang thong bao</small>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card action-center-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
                        <div>
                            <h5 class="card-title mb-0">Action Center</h5>
                            <div class="text-muted small">Viec can xu ly, bottleneck va loi van hanh dang anh huong workflow.</div>
                        </div>
                        <a class="btn btn-sm btn-primary" href="/Leave/LeaveApproval">Mo approval inbox</a>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-lg-3 col-md-6">
                            <a class="action-tile" href="/Leave/LeaveApproval">
                                <span class="action-tile-label">Cho toi xu ly</span>
                                <strong>@(Model.ActionCenter?.MyTasks?.Count ?? 0)</strong>
                                <small>@((Model.ActionCenter?.MyTasks?.Count(x => x.IsOverdue) ?? 0)) overdue</small>
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a class="action-tile" href="/Leave/LeaveApproval?overdue=1">
                                <span class="action-tile-label">Sap/da qua SLA</span>
                                <strong>@(Model.ActionCenter?.WorkflowHealth?.Sum(x => x.OverdueCount) ?? 0)</strong>
                                <small>theo Manager / HCNS / BGD</small>
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a class="action-tile" href="/Leave/LeaveApproval?issue=attendance-sync">
                                <span class="action-tile-label">System issues</span>
                                <strong>@(Model.ActionCenter?.SystemIssues?.Sum(x => x.Count) ?? 0)</strong>
                                <small>mail / attendance sync</small>
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a class="action-tile" href="/Candidate">
                                <span class="action-tile-label">Calls today</span>
                                <strong>@(Model.TelephonyDashboard?.TotalToday ?? 0)</strong>
                                <small>@(Model.TelephonyDashboard?.SuccessToday ?? 0) success / @(Model.TelephonyDashboard?.FailedToday ?? 0) failed</small>
                            </a>
                        </div>
                    </div>
                    @if (Model.ActionCenter?.MyTasks?.Any() == true)
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Request</th>
                                        <th>Step</th>
                                        <th>Owner</th>
                                        <th>Waiting</th>
                                        <th>SLA</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var task in Model.ActionCenter.MyTasks.Take(6))
                                    {
                                        <tr class="@(task.IsOverdue ? "table-warning" : "")">
                                            <td>
                                                <div class="fw-semibold">@task.RequestCode</div>
                                                <div class="text-muted small">@task.Title</div>
                                            </td>
                                            <td>@task.CurrentStep</td>
                                            <td>@(task.CurrentOwnerName ?? "--")</td>
                                            <td>@task.WaitingHours h</td>
                                            <td>
                                                @if (task.IsOverdue)
                                                {
                                                    <span class="badge bg-danger">OVERDUE</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">ON TRACK</span>
                                                }
                                            </td>
                                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="@task.Url">Xu ly</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <div class="row g-3 mt-1">
                        <div class="col-lg-6">
                            <div class="mini-panel">
                                <div class="fw-semibold mb-2">Workflow health</div>
                                @foreach (var item in Model.ActionCenter?.WorkflowHealth ?? new List<VS.Human.Rep.Model.WorkflowHealthItem>())
                                {
                                    <div class="d-flex justify-content-between small py-1">
                                        <span>@item.StepName</span>
                                        <span>@item.PendingCount pending / @item.OverdueCount overdue</span>
                                    </div>
                                }
                                @if (Model.ActionCenter?.WorkflowHealth?.Any() != true)
                                {
                                    <div class="text-muted small">No pending workflow bottleneck.</div>
                                }
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mini-panel">
                                <div class="fw-semibold mb-2">Recent timeline</div>
                                @foreach (var item in Model.ActionCenter?.RecentTimeline?.Take(5) ?? new List<VS.Human.Rep.Model.WorkflowTimelineEvent>())
                                {
                                    <div class="small py-1">
                                        <span class="fw-semibold">@item.EventCode</span>
                                        <span class="text-muted">@item.EventTitle</span>
                                    </div>
                                }
                                @if (Model.ActionCenter?.RecentTimeline?.Any() != true)
                                {
                                    <div class="text-muted small">Timeline will appear after new workflow events.</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        @if (showFilters)
        {
            <div class="col-12">
                <div class="card dashboard-filter-card">
                    <div class="card-body">
                        <div class="dashboard-section-head">
                            <div>
                                <h5 class="card-title mb-1">Bo loc dieu hanh</h5>
                                <div class="text-muted small">Loc nhanh theo thoi gian, nhom va thanh vien de xem so lieu can dung ngay.</div>
                            </div>
                        </div>
                        <form class="row g-3 align-items-end" method="get" action="/">

                <div class="col-md-2">
                    <label class="form-label">Từ Ngày</label>
                    <input value="@Model.RequestPage.FromText" id="fromDate" type="date" name="from" class="form-control">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Đến ngày</label>
                    <input value="@Model.RequestPage.ToText"  id ="toDate" type="date" name="to" class="form-control">
                </div>


                 @if(Model.Permision.SearchGrop == true)
    {
                    @if (Model.RequestPage.RoleCode == "3")
           {
            <div class="col-md-2" style="display: none;">
                            <label class="form-label">Nhóm</label>
                            <select id ="cbgroup" name="groupId"  class="form-select" aria-label="">
                                <option value="tat-ca">Tất cả</option>
                            

                            </select>
                        </div>
           }
           else 
           {
                <div class="col-md-2">
                            <label class="form-label">Nhóm</label>
                            <select id ="cbgroup" name="groupId"  class="form-select" aria-label="">
                                <option value="tat-ca">Tất cả</option>
                            

                            </select>
                        </div>
           }


            <div class="col-md-3">
                <label class="form-label">Thành viên</label>
                <select id ="cbmember" name="memberId" class="form-select" aria-label="">
                    <option selected>Tất cả</option>
                
                </select>
            </div>
    }



                <div class="col-12">
                    <div class="dashboard-filter-actions">
                    @if (showExport)
                    {
                        <button type="button" onclick="exportFileDashboard()" class="btn btn-outline-primary">Xuat file</button>
                    }
                    <button type="submit" class="btn btn-primary">Tim kiem</button>
                    </div>
                </div>



                        </form>
                    </div>
                </div>
            </div>
        }
        
        <!-- Left side columns -->
            <div class="@leftColumnClass">
                    <div class="row">

                        <!-- Sales Card -->
                        <!-- Role-based Leave Cards -->
                        @if (showLeaveSummary)
                        {
                            <div class="col-xxl-4 col-md-6">
                            <div class="card info-card revenue-card">
                                <div class="card-body">
                                    <h5 class="card-title">Quỹ phép còn lại</h5>
                                    <div class="d-flex align-items-center">
                                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                            <i class="bi bi-calendar-check"></i>
                                        </div>
                                        <div class="ps-3">
                                            <h6>@(leaveStats?.RemainingLeave ?? 0) ngày</h6>
                                            <span class="text-muted small pt-2 ps-1">năm @DateTime.Now.Year</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            </div>
                        }

                        @if (showLeaveApproval)
                        {
                            <div class="col-xxl-4 col-md-6">
                                <div class="card info-card sales-card">
                                    <div class="card-body">
                                        <h5 class="card-title">Chờ tôi duyệt</h5>
                                        <div class="d-flex align-items-center">
                                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="bi bi-person-check"></i>
                                            </div>
                                            <div class="ps-3">
                                                <h6>@(leaveStats?.PendingApproval ?? 0) đơn</h6>
                                                <a href="/Leave/LeaveApproval" class="text-primary small pt-1 fw-bold">Xử lý ngay</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (showLeaveCompany)
                        {
                            <div class="col-xxl-4 col-md-6">
                                <div class="card info-card customers-card">
                                    <div class="card-body">
                                        <h5 class="card-title">@leaveMonthTitle</h5>
                                        <div class="d-flex align-items-center">
                                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="bi bi-people"></i>
                                            </div>
                                            <div class="ps-3">
                                                <h6>@(leaveStats?.ApprovedMonth ?? 0) lượt</h6>
                                                <span class="text-muted small pt-2 ps-1">@leaveMonthSub</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (showOnlineCount)
                        {
                            <div class="col-xxl-4 col-md-6">
                                <div class="card info-card sales-card">
                                    <div class="card-body">
                                        <h5 class="card-title">User đang online</h5>
                                        <div class="d-flex align-items-center">
                                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="bi bi-people"></i>
                                            </div>
                                            <div class="ps-3">
                                                <h6>@Model.UserDataGlobal.GetCountUserOnline()</h6>
                                                <span class="text-success small pt-1 fw-bold">@Model.GlobalData.TotalUser</span>
                                                <span class="text-muted small pt-2 ps-1">Tổng User</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (showRecruitmentStats)
                        {
                            <!-- Recruitment Stats for Admin/HCNS -->
                            <div class="col-xxl-4 col-md-6">
                            <div class="card info-card sales-card">
                                <div class="card-body">
                                    <h5 class="card-title">Số lượng CV</h5>
                                    <div class="d-flex align-items-center">
                                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                            <i class="bi bi-file-earmark-person"></i>
                                        </div>
                                        <div class="ps-3">
                                                <h6>@itemdashboard.totalCVInput</h6>
                                        </div>
                                    </div>
                                </div> 
                            </div>
                        </div>
                        <div class="col-xxl-4 col-md-6">
                            <div class="card info-card sales-card">



                                <div class="card-body">

                                    <h5 class="card-title">Số lượng ứng tuyển </h5>
                                    <div class="d-flex align-items-center">
                                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                            <i class="bi bi-cart"></i>
                                        </div>
                                        <div class="ps-3">
                                                <h6>@itemdashboard.totalCV</h6>
                                            <!-- <span class="text-success small pt-1 fw-bold">12%</span> <span class="text-muted small pt-2 ps-1">increase</span> -->

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    
                        <div class="col-xxl-4 col-xl-12">

                            <div class="card info-card customers-card">



                                <div class="card-body">

                                    <h5 class="card-title">Ứng viên Onboard </h5>
                                    <div class="d-flex align-items-center">
                                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                            <i class="bi bi-people"></i>
                                        </div>
                                        <div class="ps-3">
                                            <h6>@itemdashboard.totalOnboard</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        }
                    
                        <div class="col-12">
                            <div class="card dashboard-notification-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 dashboard-section-head">
                                        <div>
                                            <h5 class="card-title mb-1">Thong bao noi bo</h5>
                                            <div class="text-muted small">@Model.UnreadNotificationCount chua doc, uu tien hien thi viec can xu ly truoc.</div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (Model.UnreadNotificationCount > 0)
                                            {
                                                <form method="post" asp-page-handler="MarkAllRead" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">Danh dau da doc</button>
                                                </form>
                                            }
                                            <a href="/Notifications" class="btn btn-sm btn-primary">Mo trung tam</a>
                                        </div>
                                    </div>

                                    <ul class="list-group list-group-flush mt-3 dashboard-notification-list">
                                        @if (Model.Notifications.Count == 0)
                                        {
                                            <li class="list-group-item text-muted dashboard-notification-empty">Chua co thong bao nao.</li>
                                        }
                                        else
                                        {
                                            foreach (var notif in Model.Notifications)
                                            {
                                                var isActionRequired = string.Equals(notif.Category, "ACTION_REQUIRED", global::System.StringComparison.OrdinalIgnoreCase);
                                                var isInternalNews = string.Equals(notif.RelatedEntityType, "INTERNAL_NEWS", global::System.StringComparison.OrdinalIgnoreCase)
                                                    || (!string.IsNullOrWhiteSpace(notif.Link) && notif.Link.StartsWith("/InternalNews", global::System.StringComparison.OrdinalIgnoreCase));
                                                var badgeClass = isActionRequired ? "bg-danger" : isInternalNews ? "bg-info text-dark" : "bg-secondary";
                                                var badgeText = isActionRequired ? "Can xu ly" : isInternalNews ? "Tin noi bo" : "Thong bao";
                                                var itemClass = notif.IsRead ? string.Empty : "dashboard-notification-item-unread";
                                                <li class="list-group-item dashboard-notification-item @itemClass">
                                                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                                        <div class="dashboard-notification-body">
                                                            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                                                                <span class="badge @badgeClass">@badgeText</span>
                                                                <small class="text-muted">@notif.CreateAt.ToString("dd/MM/yyyy HH:mm")</small>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(notif.Link))
                                                            {
                                                                <a href="/Notifications?handler=Open&id=@notif.Id" class="dashboard-notification-link">@notif.Message</a>
                                                            }
                                                            else
                                                            {
                                                                @notif.Message
                                                            }
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(notif.Link))
                                                        {
                                                            <a class="btn btn-sm btn-outline-primary" href="/Notifications?handler=Open&id=@notif.Id">Mo</a>
                                                        }
                                                    </div>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>


                        @if (showExtendedStats)
                        {
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <h5 class="card-title">Thống kê nhân sự</h5>
                                        @if (extendedStats.ContractStats != null && extendedStats.ContractStats.Count > 0)
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-sm">
                                                    <thead>
                                                        <tr>
                                                            <th>HĐLĐ</th>
                                                            <th>Số lượng</th>
                                                            <th>Tỷ lệ</th>
                                                            <th>Chi tiết</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var group in extendedStats.ContractStats)
                                                        {
                                                            <tr>
                                                                <td>@group.Title</td>
                                                                <td>@group.Value</td>
                                                                <td>@($"{group.Percent:0.#}%")</td>
                                                                <td>
                                                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                                                            data-bs-toggle="modal" data-bs-target="#@($"modal-{group.Key}")">
                                                                        Xem
                                                                    </button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted">Chưa có dữ liệu hợp đồng.</div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="col-xxl-4 col-md-6">
                                <div class="card info-card sales-card">
                                    <div class="card-body">
                                        <h5 class="card-title">HĐLĐ sắp đến hạn</h5>
                                        <div class="d-flex align-items-center">
                                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="bi bi-calendar2-week"></i>
                                            </div>
                                            <div class="ps-3">
                                                <h6>@extendedStats.ExpiringContracts.Value</h6>
                                                <span class="text-muted small pt-1">@($"{extendedStats.ExpiringContracts.Percent:0.#}%") nhân sự</span>
                                            </div>
                                        </div>
