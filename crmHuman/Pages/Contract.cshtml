@page
@model ContractModel
@{
    ViewData["Title"] = Model.TitlePage;
}
<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Hợp đồng lao động</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <form class="row g-3" method="get" action="/Contract">
                        <div class="col-md-4">
                            <label class="form-label">Từ ngày</label>
                            <input value="@Model.RequestSearch.FromText" type="date" name="from" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Đến ngày</label>
                            <input value="@Model.RequestSearch.ToText" type="date" name="to" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Từ khóa</label>
                            <input type="text" value="@Model.RequestSearch.Token" name="token" class="form-control" placeholder="Tên nhân viên / username">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Loại hợp đồng</label>
                            <select name="contractTypeCode" class="form-select">
                                <option value="">Tất cả</option>
                                @foreach (var item in Model.ContractTypes)
                                {
                                    if (item.Code == Model.RequestSearch.ContractTypeCode)
                                    {
                                        <option selected value="@item.Code">@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Code">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Nhân viên</label>
                            <select name="employeeId" class="form-select">
                                <option value="">Tất cả</option>
                                @foreach (var emp in Model.EmployeeList.Data)
                                {
                                    var empItem = emp as dynamic;
                                    if (Model.RequestSearch.EmployeeId.HasValue && Model.RequestSearch.EmployeeId.Value == empItem.Id)
                                    {
                                        <option selected value="@empItem.Id">@empItem.UserName - @empItem.FullName</option>
                                    }
                                    else
                                    {
                                        <option value="@empItem.Id">@empItem.UserName - @empItem.FullName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Trạng thái</label>
                            <input type="text" list="contractStatusList" value="@Model.RequestSearch.Status" name="status" class="form-control" placeholder="Tất cả">
                            <datalist id="contractStatusList">
                                @foreach (var status in Model.StatusSuggestions)
                                {
                                    <option value="@status"></option>
                                }
                            </datalist>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                            @if (Model.Permision.Add == true)
                            {
                                <button type="button" class="btn btn-primary" onclick="openFormContract(-1)">Thêm mới</button>
                            }
                        </div>
                    </form>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                @foreach (var item in Model.TableColumnText)
                                {
                                    <th>@item</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var itemData in Model.DataAll.Data)
                            {
                                var itemInfo = itemData as dynamic;
                                var updateText = "";
                                var hrSignedAtText = "";
                                var hrSignedByText = "";
                                var signedAtText = "";
                                var signedByText = "";
                                var isHrSigned = itemInfo.IsHrSigned != null && itemInfo.IsHrSigned == true;
                                var isSignedInternal = itemInfo.IsSignedInternal != null && itemInfo.IsSignedInternal == true;
                                var canSignHr =
                                    !isHrSigned &&
                                    !isSignedInternal &&
                                    !string.IsNullOrWhiteSpace(itemInfo.FileUrl) &&
                                    (Model.UserData.RoleCode == "1" || Model.UserData.RoleCode == "9");
                                var canSignEmployee =
                                    isHrSigned &&
                                    !isSignedInternal &&
                                    !string.IsNullOrWhiteSpace(itemInfo.FileUrl) &&
                                    Model.UserData.UserId == itemInfo.EmployeeId;
                                if (itemInfo.UpdateAt != null)
                                {
                                    updateText = itemInfo.UpdateAt.ToString("dd/MM/yyyy");
                                }
                                if (itemInfo.HrSignedAt != null)
                                {
                                    hrSignedAtText = itemInfo.HrSignedAt.ToString("dd/MM/yyyy HH:mm");
                                }
                                if (!string.IsNullOrWhiteSpace(itemInfo.HrSignedByUserName))
                                {
                                    hrSignedByText = itemInfo.HrSignedByUserName;
                                    if (!string.IsNullOrWhiteSpace(itemInfo.HrSignedByFullName))
                                    {
                                        hrSignedByText += " - " + itemInfo.HrSignedByFullName;
                                    }
                                }
                                if (itemInfo.SignedAt != null)
                                {
                                    signedAtText = itemInfo.SignedAt.ToString("dd/MM/yyyy HH:mm");
                                }
                                if (!string.IsNullOrWhiteSpace(itemInfo.SignedByUserName))
                                {
                                    signedByText = itemInfo.SignedByUserName;
                                    if (!string.IsNullOrWhiteSpace(itemInfo.SignedByFullName))
                                    {
                                        signedByText += " - " + itemInfo.SignedByFullName;
                                    }
                                }
                                i++;
                                <tr>
                                    <td>@i</td>
                                    <td>@itemInfo.UserName - @itemInfo.FullName</td>
                                    <td>@itemInfo.ContractTypeName</td>
                                    <td>@itemInfo.StartDateDisplay</td>
                                    <td>@itemInfo.EndDateDisplay</td>
                                    <td>@itemInfo.Status</td>
                                    <td>
                                        @if (isHrSigned)
                                        {
                                            <span class="badge bg-success">HR đã ký</span>
                                            @if (!string.IsNullOrWhiteSpace(hrSignedAtText))
                                            {
                                                <div class="small text-muted">@hrSignedAtText</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(hrSignedByText))
                                            {
                                                <div class="small text-muted">@hrSignedByText</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">HR chưa ký</span>
                                        }
                                        <div class="mt-1">
                                            @if (isSignedInternal)
                                            {
                                                <span class="badge bg-success">NV đã ký</span>
                                                @if (!string.IsNullOrWhiteSpace(signedAtText))
                                                {
                                                    <div class="small text-muted">@signedAtText</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(signedByText))
                                                {
                                                    <div class="small text-muted">@signedByText</div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">NV chưa ký</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(itemInfo.FileUrl))
                                        {
                                            <a href="@itemInfo.FileUrl" target="_blank">Tải về</a>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>@updateText</td>
                                    <td>
                                        @if (Model.Permision.Edit == true)
                                        {
                                            <a href="javascript:void(0)" onclick="openFormContract(@itemInfo.Id)">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        }
                                        @if (Model.Permision.Delete == true)
                                        {
                                            <a href="javascript:void(0)" onclick="confirmDelete(@itemInfo.Id, 'Contract')">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        }
                                        @if (canSignHr)
                                        {
                                            <a href="javascript:void(0)" onclick="openSignContract(@itemInfo.Id)" title="Ký HR">
                                                <i class="bi bi-pen-fill"></i>
                                            </a>
                                        }
                                        @if (canSignEmployee)
                                        {
                                            <a href="javascript:void(0)" onclick="openSignContract(@itemInfo.Id)" title="Ký nhân viên">
                                                <i class="bi bi-pen-fill"></i>
                                            </a>
                                        }
                                        <a href="javascript:void(0)" onclick="openContractHistory(@itemInfo.Id)">
                                            <i class="bi bi-clock-history"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @{ Html.RenderPartial("formSearch/pagination", Model); }
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="formModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="contentModal"></div>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="historyModalContent"></div>
    </div>
</div>
