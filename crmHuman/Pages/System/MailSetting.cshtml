@section Scripts {
    <script>
        let templateEditorInitialized = false;
        let templateEditorRange = null;
        let signatureEditorInitialized = false;
        let signatureEditorRange = null;

        function getRequestVerificationToken() {
            var tokenField = document.getElementsByName('__RequestVerificationToken')[0];
            return tokenField ? tokenField.value : '';
        }

        function pickEditorImageFile() {
            return new Promise(function (resolve) {
                var picker = document.createElement('input');
                picker.type = 'file';
                picker.accept = 'image/*';
                picker.addEventListener('change', function () {
                    resolve(picker.files && picker.files[0] ? picker.files[0] : null);
                });
                picker.click();
            });
        }

        function uploadEditorImage(file) {
            return new Promise(function (resolve, reject) {
                if (!file) {
                    reject('Chua chon anh.');
                    return;
                }

                var formData = new FormData();
                formData.append('file', file, file.name || 'mail-image.png');

                fetch('?handler=UploadEditorImage', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getRequestVerificationToken()
                    },
                    body: formData
                })
                .then(function (response) {
                    return response.json()
                        .catch(function () {
                            return {};
                        })
                        .then(function (data) {
                            if (!response.ok) {
                                throw new Error(data && data.error ? data.error : ('Upload failed: ' + response.status));
                            }

                            if (!data || !data.location) {
                                throw new Error('Upload response is missing image URL.');
                            }

                            resolve(data.location);
                        });
                })
                .catch(function (error) {
                    reject(error && error.message ? error.message : error);
                });
            });
        }

        function buildEditorImageHtml(location, altText) {
            return '<img src="' + escapeHtml(location) + '" alt="' + escapeHtml(altText || 'Mail image') + '" style="max-width:100%;height:auto;" />';
        }

        document.addEventListener('DOMContentLoaded', function () {
            initializeTemplateEditor();
            initializeSignatureEditor();
            renderSignaturePreview('hr');
            renderSignaturePreview('employee');
        });

        function getTemplateVisualEditor() {
            return document.getElementById('tplBodyEditor');
        }

        function getTemplateHtmlEditor() {
            return document.getElementById('tplBodyHtml');
        }

        function initializeTemplateEditor() {
            if (templateEditorInitialized) {
                return;
            }

            var editor = getTemplateVisualEditor();
            var htmlEditor = getTemplateHtmlEditor();
            if (!editor || !htmlEditor) {
                return;
            }

            ['keyup', 'mouseup', 'focus', 'blur'].forEach(function (eventName) {
                editor.addEventListener(eventName, saveTemplateEditorSelection);
            });

            editor.addEventListener('input', function () {
                syncTemplateHtmlFromVisual();
            });

            htmlEditor.addEventListener('input', function () {
                if (!htmlEditor.classList.contains('d-none')) {
                    syncTemplateVisualFromHtml(htmlEditor.value);
                }
            });

            editor.addEventListener('paste', handleTemplateEditorPaste);

            document.addEventListener('selectionchange', function () {
                if (isSelectionInsideTemplateEditor()) {
                    saveTemplateEditorSelection();
                }
            });

            templateEditorInitialized = true;
            syncTemplateVisualFromHtml('');
            setTemplateEditorMode('visual');
        }

        function isSelectionInsideTemplateEditor() {
            var editor = getTemplateVisualEditor();
            var selection = window.getSelection();
            if (!editor || !selection || selection.rangeCount === 0) {
                return false;
            }

            return editor.contains(selection.getRangeAt(0).commonAncestorContainer);
        }

        function saveTemplateEditorSelection() {
            var editor = getTemplateVisualEditor();
            var selection = window.getSelection();
            if (!editor || !selection || selection.rangeCount === 0) {
                return;
            }

            var range = selection.getRangeAt(0);
            if (editor.contains(range.commonAncestorContainer)) {
                templateEditorRange = range.cloneRange();
            }
        }

        function restoreTemplateEditorSelection() {
            if (!templateEditorRange) {
                return false;
            }

            var selection = window.getSelection();
            if (!selection) {
                return false;
            }

            selection.removeAllRanges();
            selection.addRange(templateEditorRange);
            return true;
        }

        function moveTemplateCaretToEnd() {
            var editor = getTemplateVisualEditor();
            if (!editor) {
                return;
            }

            var range = document.createRange();
            range.selectNodeContents(editor);
            range.collapse(false);

            var selection = window.getSelection();
            if (!selection) {
                return;
            }

            selection.removeAllRanges();
            selection.addRange(range);
            templateEditorRange = range.cloneRange();
        }

        function focusTemplateEditor() {
            var editor = getTemplateVisualEditor();
            if (!editor || editor.classList.contains('d-none')) {
                return;
            }

            editor.focus();
            if (!restoreTemplateEditorSelection()) {
                moveTemplateCaretToEnd();
            }
