@page
@model crmHuman.Pages.System.MailSettingModel
@using VS.Human.Rep.Model
@{
    Layout = "_Layout";
}

<div class="card">
    <div class="card-body">
        @Html.AntiForgeryToken()
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h5 class="card-title mb-0">@Model.TitlePage</h5>
            <a class="btn btn-outline-secondary btn-sm" href="/System/MailHistory">Xem mail đã gửi</a>
        </div>

        <ul class="nav nav-tabs" id="mailSettingTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="smtp-tab" data-bs-toggle="tab" data-bs-target="#smtpTab" type="button" role="tab">SMTP</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="template-tab" data-bs-toggle="tab" data-bs-target="#templateTab" type="button" role="tab">Templates</button>
            </li>
        </ul>

        <div class="tab-content pt-3" id="mailSettingTabContent">
            <div class="tab-pane fade show active" id="smtpTab" role="tabpanel">
                <input type="hidden" id="settingId" value="@Model.Setting?.Id" />
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">SMTP Host</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="smtpHost" value="@Model.Setting?.SmtpHost" />
                    </div>
                    <label class="col-sm-2 col-form-label">SMTP Port</label>
                    <div class="col-sm-4">
                        <input type="number" class="form-control" id="smtpPort" value="@Model.Setting?.SmtpPort" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">User</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="smtpUser" value="@Model.Setting?.SmtpUser" />
                    </div>
                    <label class="col-sm-2 col-form-label">Password</label>
                    <div class="col-sm-4">
                        <input type="password" class="form-control" id="smtpPassword" placeholder="Leave blank to keep current" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">SMTP ghi chú</label>
                    <div class="col-sm-10">
                        <div class="form-text mt-2">
                            SMTP server dung chung cho toan he thong. Ben duoi la cau hinh mac dinh/fallback cho template.
                            Neu nguoi dang gui co email va chu ky rieng trong ho so ca nhan, he thong se uu tien dung thong tin nguoi do lam sender hien thi.
                            Neu mail server chi cho phep gui tu dung dia chi/xac thuc, can cau hinh send-as/alias phu hop cho tai khoan SMTP admin.
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-xl-4 col-md-6">
                        <div class="card border shadow-sm h-100">
                            <div class="card-header bg-light fw-semibold">Mail nhân sự mặc định</div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label">From Email</label>
                                    <input type="text" class="form-control" id="hrFromEmail" value="@(Model.Setting?.HrFromEmail ?? Model.Setting?.FromEmail)" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">From Name</label>
                                    <input type="text" class="form-control" id="hrFromName" value="@(Model.Setting?.HrFromName ?? Model.Setting?.FromName)" />
                                </div>
                                <textarea class="d-none" id="hrSignature">@(Model.Setting?.HrSignature ?? string.Empty)</textarea>
                                <div class="d-flex gap-2 mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openSignatureSửaor('hr')">Sửa chữ ký</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSignature('hr')">Xóa chữ ký</button>
                                </div>
                                <div class="signature-preview" id="hrSignaturePreview"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6">
                        <div class="card border shadow-sm h-100">
                            <div class="card-header bg-light fw-semibold">Mail nhân viên mặc định</div>
                            <div class="card-body">
                                <div class="small text-muted mb-3">
                                    Được dùng khi người gửi không có email/chữ ký riêng trong hồ sơ cá nhân.
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">From Email</label>
                                    <input type="text" class="form-control" id="employeeFromEmail" value="@Model.Setting?.EmployeeFromEmail" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">From Name</label>
                                    <input type="text" class="form-control" id="employeeFromName" value="@Model.Setting?.EmployeeFromName" />
                                </div>
                                <textarea class="d-none" id="employeeSignature">@(Model.Setting?.EmployeeSignature ?? string.Empty)</textarea>
                                <div class="d-flex gap-2 mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openSignatureSửaor('employee')">Sửa chữ ký</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSignature('employee')">Xóa chữ ký</button>
                                </div>
                                <div class="signature-preview" id="employeeSignaturePreview"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-12">
                        <div class="card border shadow-sm h-100">
                            <div class="card-header bg-light fw-semibold">Mail ứng viên mặc định</div>
                            <div class="card-body">
                                <div class="small text-muted mb-3">
                                    Được dùng cho các template gửi trực tiếp đến ứng viên, ví dụ thư mời phỏng vấn. Hệ thống ưu tiên dùng profile này.
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">From Email</label>
                                    <input type="text" class="form-control" id="candidateFromEmail" value="@(Model.Setting?.CandidateFromEmail ?? Model.Setting?.HrFromEmail ?? Model.Setting?.FromEmail)" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">From Name</label>
                                    <input type="text" class="form-control" id="candidateFromName" value="@(Model.Setting?.CandidateFromName ?? Model.Setting?.HrFromName ?? Model.Setting?.FromName)" />
                                </div>
                                <textarea class="d-none" id="candidateSignature">@(Model.Setting?.CandidateSignature ?? string.Empty)</textarea>
                                <div class="d-flex gap-2 mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openSignatureSửaor('candidate')">Sửa chữ ký</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSignature('candidate')">Xóa chữ ký</button>
                                </div>
                                <div class="signature-preview" id="candidateSignaturePreview"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-2">Enable SSL</div>
                    <div class="col-sm-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="enableSsl" @(Model.Setting?.EnableSsl == true ? "checked" : "") />
                        </div>
                    </div>
                    <div class="col-sm-2">Active</div>
                    <div class="col-sm-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="settingActive" @(Model.Setting?.IsActive == 1 ? "checked" : "") />
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <button type="button" class="btn btn-primary" onclick="saveMailSetting()">Lưu</button>
                </div>
                <hr />
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Email nhận thử</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="testToEmail" placeholder="test@example.com" />
                    </div>
                    <label class="col-sm-2 col-form-label">Template Code</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="testTemplateCode" list="templateCodes" placeholder="LEAVE_CREATE" />
                        <datalist id="templateCodes">
                            @foreach (var item in Model.Templates)
                            {
                                <option value="@item.Code"></option>
                            }
                        </datalist>
                    </div>
                </div>
                <div class="text-end">
                    <button type="button" class="btn btn-outline-secondary" onclick="sendTestMail()">Gửi thử</button>
                </div>
            </div>

            <div class="tab-pane fade" id="templateTab" role="tabpanel">
                <div class="alert alert-secondary small">
                    Tokens leave: {{EmployeeName}}, {{ManagerName}}, {{LeaveType}}, {{FromDate}}, {{ToDate}}, {{TotalDays}}, {{Reason}}, {{RejectReason}}.
                    Tokens interview: {{CandidateName}}, {{AppliedPosition}}, {{InterviewThao tác}}, {{InterviewRound}}, {{ScheduleDate}}, {{InterviewMode}}, {{AddressInfo}}, {{InterviewerName}}, {{RoomName}}, {{Noted}}.
                    Tokens sender: {{SenderName}}, {{SenderEmail}}, {{SenderTypeText}}, {{SenderSignature}}.
                    Hỗ trợ cả {{Token}} và {Token}. Nếu body không có {{SenderSignature}} thì hệ thống sẽ tự động nối chữ ký vào cuối mail.
                    Ảnh/logo trong mail nên được chèn bằng nút ảnh để hệ thống upload và nhúng inline khi gửi. Không nên paste trực tiếp từ Word/Outlook vì dễ sinh đường dẫn file:/// hoặc cid: sẽ bị vỡ ảnh trong mail.
                </div>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Subject</th>
                            <th>Gửi từ</th>
                            <th class="text-center">Active</th>
                            <th class="text-center">CC Manager</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Templates)
                        {
                            <tr data-id="@item.Id"
                                data-code="@item.Code"
                                data-name="@item.Name"
                                data-subject="@item.Subject"
                                data-sendertype="@item.SenderType"
                                data-active="@item.IsActive"
                                data-ccmanager="@item.CcManager"
                                data-ccemails="@item.CcEmails"
                                data-bccemails="@item.BccEmails">
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@item.Subject</td>
                                <td>@EmailSenderTypes.GetDisplayText(item.SenderType)</td>
                                <td class="text-center">@((item.IsActive == 1) ? "Yes" : "No")</td>
                                <td class="text-center">@((item.CcManager) ? "Yes" : "No")</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openTemplate(@item.Id)">Sửa</button>
                                </td>
                            </tr>
                            <textarea class="d-none" id="tpl-body-@item.Id">@item.Body</textarea>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="templateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sửa template</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="tplId" />
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Code</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="tplCode" disabled />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Name</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="tplName" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Subject</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="tplSubject" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Gửi từ</label>
                    <div class="col-sm-9">
                        <select class="form-select" id="tplSenderType">
                            <option value="HR">Mail nhân sự</option>
                            <option value="EMPLOYEE">Mail nhân viên</option>
                            <option value="CANDIDATE">Mail ứng viên</option>
                        </select>
                        <div class="form-text">
                            Chọn profile gửi mail cho template này. Chữ ký của profile được tự động nối vào cuối mail.
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Body</label>
                    <div class="col-sm-9">
                        <div class="template-editor-shell">
                            <div class="template-editor-toolbar">
                                <div class="btn-toolbar gap-2 flex-wrap" role="toolbar">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-primary active" id="tplVisualModeBtn" onclick="setTemplateSửaorMode('visual')">Visual</button>
                                        <button type="button" class="btn btn-outline-primary" id="tplHtmlModeBtn" onclick="setTemplateSửaorMode('html')">HTML</button>
                                    </div>

                                    <select class="form-select form-select-sm template-editor-select template-editor-visual-only" id="tplBlockFormat" onchange="applyBlockFormat(this.value)">
                                        <option value="<p>">Đoạn văn</option>
                                        <option value="<h1>">Tiêu đề 1</option>
                                        <option value="<h2>">Tiêu đề 2</option>
                                        <option value="<h3>">Tiêu đề 3</option>
                                        <option value="<blockquote>">Trích dẫn</option>
                                    </select>

                                    <select class="form-select form-select-sm template-editor-select template-editor-visual-only" id="tplFontFamily" onchange="applyFontName(this.value)">
                                        <option value="Arial">Arial</option>
                                        <option value="Tahoma">Tahoma</option>
                                        <option value="Verdana">Verdana</option>
                                        <option value="Times New Roman">Times New Roman</option>
                                        <option value="Georgia">Georgia</option>
                                        <option value="Courier New">Courier New</option>
                                    </select>

                                    <select class="form-select form-select-sm template-editor-select template-editor-visual-only" id="tplFontSize" onchange="applyFontSize(this.value)">
                                        <option value="2">Nhỏ</option>
                                        <option value="3" selected>Vừa</option>
                                        <option value="4">Hơi lớn</option>
                                        <option value="5">Lớn</option>
                                        <option value="6">Rất lớn</option>
                                    </select>

                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('bold')" title="Đậm"><strong>B</strong></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('italic')" title="Nghiêng"><em>I</em></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('underline')" title="Gạch chân"><u>U</u></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('strikeThrough')" title="Gạch ngang"><s>S</s></button>
                                    </div>

                                    <div class="d-flex align-items-center gap-1 template-editor-visual-only">
                                        <label class="small text-muted mb-0" for="tplTextColor">Chữ</label>
                                        <input type="color" id="tplTextColor" class="form-control form-control-color form-control-color-sm" value="#1f2937" onchange="applyTextColor(this.value)" />
                                    </div>
                                    <div class="d-flex align-items-center gap-1 template-editor-visual-only">
                                        <label class="small text-muted mb-0" for="tplHighlightColor">Nền</label>
                                        <input type="color" id="tplHighlightColor" class="form-control form-control-color form-control-color-sm" value="#fff59d" onchange="applyHighlightColor(this.value)" />
                                    </div>

                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('justifyLeft')" title="Canh trái"><i class="bi bi-text-left"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('justifyCenter')" title="Canh giữa"><i class="bi bi-text-center"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('justifyRight')" title="Canh phải"><i class="bi bi-text-right"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('justifyFull')" title="Canh đều"><i class="bi bi-justify"></i></button>
                                    </div>

                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('insertUnorderedList')" title="Danh sách chấm"><i class="bi bi-list-ul"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('insertOrderedList')" title="Danh sách số"><i class="bi bi-list-ol"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('outdent')" title="Giảm lề"><i class="bi bi-text-indent-right"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('indent')" title="Tăng lề"><i class="bi bi-text-indent-left"></i></button>
                                    </div>

                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary" onclick="insertTemplateLink()" title="Chèn link"><i class="bi bi-link-45deg"></i></button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="insertTemplateImage()" title="Chèn ảnh"><i class="bi bi-image"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('unlink')" title="Bỏ link"><i class="bi bi-link"></i></button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="insertTemplateTable()" title="Chèn bảng"><i class="bi bi-table"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateSửaorCommand('insertHorizontalRule')" title="Đường kẻ ngang"><i class="bi bi-dash-lg"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="clearTemplateFormatting()" title="Xóa định dạng"><i class="bi bi-eraser"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div class="template-editor-token-bar">
                                <span class="template-editor-token-label">Token nhanh:</span>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{EmployeeName}}')">{{EmployeeName}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{ManagerName}}')">{{ManagerName}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{LeaveType}}')">{{LeaveType}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{FromDate}}')">{{FromDate}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{ToDate}}')">{{ToDate}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{TotalDays}}')">{{TotalDays}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{Reason}}')">{{Reason}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{CandidateName}}')">{{CandidateName}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{AppliedPosition}}')">{{AppliedPosition}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{InterviewRound}}')">{{InterviewRound}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{ScheduleDate}}')">{{ScheduleDate}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{AddressInfo}}')">{{AddressInfo}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{InterviewerName}}')">{{InterviewerName}}</button>
                            </div>

                            <div id="tplBodySửaor" class="template-editor-canvas" contenteditable="true"></div>
                            <textarea class="form-control d-none template-editor-html" id="tplBodyHtml" rows="14" spellcheck="false"></textarea>
                        </div>
                        <div class="form-text">
                            Hỗ trợ soạn nội dung kiểu Word, dán từ Word/Google Docs, đổi font chữ và chuyển qua HTML khi cần.
                            Nền uu tien font email-safe: Arial, Tahoma, Verdana, Times New Roman, Georgia, Courier New.
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">CC Manager</label>
                    <div class="col-sm-9">
                        <input class="form-check-input" type="checkbox" id="tplCcManager" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">CC Emails</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="tplCcEmails" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">BCC Emails</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="tplBccEmails" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Active</label>
                    <div class="col-sm-9">
                        <input class="form-check-input" type="checkbox" id="tplIsActive" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="saveTemplate()">Lưu</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="signatureModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="signatureModalTitle">Sửa chữ ký</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="signatureTargetType" />
                <div class="template-editor-shell">
                    <div class="template-editor-toolbar">
                        <div class="btn-toolbar gap-2 flex-wrap" role="toolbar">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary active" id="sigVisualModeBtn" onclick="setSignatureSửaorMode('visual')">Visual</button>
                                <button type="button" class="btn btn-outline-primary" id="sigHtmlModeBtn" onclick="setSignatureSửaorMode('html')">HTML</button>
                            </div>

                            <select class="form-select form-select-sm template-editor-select signature-editor-visual-only" id="sigBlockFormat" onchange="applySignatureBlockFormat(this.value)">
                                <option value="<p>">Đoạn văn</option>
                                <option value="<h1>">Tiêu đề 1</option>
                                <option value="<h2>">Tiêu đề 2</option>
                                <option value="<h3>">Tiêu đề 3</option>
                                <option value="<blockquote>">Trích dẫn</option>
                            </select>

                            <select class="form-select form-select-sm template-editor-select signature-editor-visual-only" id="sigFontFamily" onchange="applySignatureFontName(this.value)">
                                <option value="Arial">Arial</option>
                                <option value="Tahoma">Tahoma</option>
                                <option value="Verdana">Verdana</option>
                                <option value="Times New Roman">Times New Roman</option>
                                <option value="Georgia">Georgia</option>
                                <option value="Courier New">Courier New</option>
                            </select>

                            <select class="form-select form-select-sm template-editor-select signature-editor-visual-only" id="sigFontSize" onchange="applySignatureFontSize(this.value)">
                                <option value="2">Nhỏ</option>
                                <option value="3" selected>Vừa</option>
                                <option value="4">Hơi lớn</option>
                                <option value="5">Lớn</option>
                                <option value="6">Rất lớn</option>
                            </select>

                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('bold')" title="Đậm"><strong>B</strong></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('italic')" title="Nghiêng"><em>I</em></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('underline')" title="Gạch chân"><u>U</u></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('strikeThrough')" title="Gạch ngang"><s>S</s></button>
                            </div>

                            <div class="d-flex align-items-center gap-1 signature-editor-visual-only">
                                <label class="small text-muted mb-0" for="sigTextColor">Chữ</label>
                                <input type="color" id="sigTextColor" class="form-control form-control-color form-control-color-sm" value="#1f2937" onchange="applySignatureTextColor(this.value)" />
                            </div>
                            <div class="d-flex align-items-center gap-1 signature-editor-visual-only">
                                <label class="small text-muted mb-0" for="sigHighlightColor">Nền</label>
                                <input type="color" id="sigHighlightColor" class="form-control form-control-color form-control-color-sm" value="#fff59d" onchange="applySignatureHighlightColor(this.value)" />
                            </div>

                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('justifyLeft')" title="Canh trái"><i class="bi bi-text-left"></i></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('justifyCenter')" title="Canh giữa"><i class="bi bi-text-center"></i></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('justifyRight')" title="Canh phải"><i class="bi bi-text-right"></i></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('justifyFull')" title="Canh đều"><i class="bi bi-justify"></i></button>
                            </div>

                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('insertUnorderedList')" title="Danh sách chấm"><i class="bi bi-list-ul"></i></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('insertOrderedList')" title="Danh sách số"><i class="bi bi-list-ol"></i></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('outdent')" title="Giảm lề"><i class="bi bi-text-indent-right"></i></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('indent')" title="Tăng lề"><i class="bi bi-text-indent-left"></i></button>
                            </div>

                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-secondary" onclick="insertSignatureLink()" title="Chèn link"><i class="bi bi-link-45deg"></i></button>
                                <button type="button" class="btn btn-outline-secondary" onclick="insertSignatureImage()" title="Chèn ảnh"><i class="bi bi-image"></i></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('unlink')" title="Bỏ link"><i class="bi bi-link"></i></button>
                                <button type="button" class="btn btn-outline-secondary" onclick="insertSignatureTable()" title="Chèn bảng"><i class="bi bi-table"></i></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureSửaorCommand('insertHorizontalRule')" title="Đường kẻ ngang"><i class="bi bi-dash-lg"></i></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="clearSignatureFormatting()" title="Xóa định dạng"><i class="bi bi-eraser"></i></button>
                            </div>
                        </div>
                    </div>

                    <div class="template-editor-token-bar">
                        <span class="template-editor-token-label">Token nhanh:</span>
                        <button type="button" class="btn btn-sm btn-outline-info" onclick="insertSignatureToken('{{SenderName}}')">{{SenderName}}</button>
                        <button type="button" class="btn btn-sm btn-outline-info" onclick="insertSignatureToken('{{SenderEmail}}')">{{SenderEmail}}</button>
                        <button type="button" class="btn btn-sm btn-outline-info" onclick="insertSignatureToken('{{SenderTypeText}}')">{{SenderTypeText}}</button>
                    </div>

                    <div id="signatureBodySửaor" class="template-editor-canvas" contenteditable="true"></div>
                    <textarea class="form-control d-none template-editor-html" id="signatureBodyHtml" rows="14" spellcheck="false"></textarea>
                </div>
                <div class="form-text mt-2">
                    Có thể đặt logo/link trong chữ ký. Nếu dùng ảnh, nên sử dụng URL công khai thay vì dán image base64 quá lớn.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="saveSignatureSửaor()">Lưu chữ ký</button>
            </div>
        </div>
    </div>
</div>

<style>
    .template-editor-shell {
        border: 1px solid #ced4da;
        border-radius: 0.5rem;
        overflow: hidden;
        background: #fff;
    }

    .template-editor-toolbar {
        padding: 0.75rem;
        border-bottom: 1px solid #e5e7eb;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    }

    .template-editor-select {
        width: auto;
        min-width: 120px;
    }

    .form-control-color-sm {
        width: 2.5rem;
        min-width: 2.5rem;
        height: 2rem;
        padding: 0.15rem;
    }

    .template-editor-token-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
        padding: 0.75rem;
        border-bottom: 1px solid #eef2f7;
        background: #fcfcfd;
    }

    .template-editor-token-label {
        display: inline-flex;
        align-items: center;
        font-size: 0.875rem;
        color: #64748b;
        margin-right: 0.25rem;
    }

    .template-editor-canvas,
    .template-editor-html {
        min-height: 360px;
        max-height: 55vh;
        padding: 1rem;
        overflow-y: auto;
        border: 0;
        border-radius: 0;
    }

    .template-editor-canvas:focus,
    .template-editor-html:focus {
        outline: none;
        box-shadow: none;
    }

    .template-editor-canvas table {
        width: 100%;
        border-collapse: collapse;
    }

    .template-editor-canvas table td,
    .template-editor-canvas table th {
        border: 1px solid #cbd5e1;
        padding: 0.5rem;
    }

    .template-editor-canvas p:last-child {
        margin-bottom: 0;
    }

    .signature-preview {
        min-height: 120px;
        max-height: 220px;
        overflow: auto;
        border: 1px dashed #cbd5e1;
        border-radius: 0.5rem;
        padding: 0.75rem;
        background: #fff;
    }

    .signature-preview.is-empty {
        color: #64748b;
        font-style: italic;
        display: flex;
        align-items: center;
    }
</style>

@section Scripts {
    <script>
        let templateSửaorInitialized = false;
        let templateSửaorRange = null;
        let signatureSửaorInitialized = false;
        let signatureSửaorRange = null;

        function getRequestVerificationToken() {
            var tokenField = document.getElementsByName('__RequestVerificationToken')[0];
            return tokenField ? tokenField.value : '';
        }

        function pickSửaorImageFile() {
            return new Promise(function (resolve) {
                var picker = document.createElement('input');
                picker.type = 'file';
                picker.accept = 'image/*';
                picker.addEventListener('change', function () {
                    resolve(picker.files && picker.files[0] ? picker.files[0] : null);
                });
                picker.click();
            });
        }

        function uploadSửaorImage(file) {
            return new Promise(function (resolve, reject) {
                if (!file) {
                    reject('Chữa chon anh.');
                    return;
                }

                var formData = new FormData();
                formData.append('file', file, file.name || 'mail-image.png');

                fetch('?handler=UploadSửaorImage', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getRequestVerificationToken()
                    },
                    body: formData
                })
                .then(function (response) {
                    return response.json()
                        .catch(function () {
                            return {};
                        })
                        .then(function (data) {
                            if (!response.ok) {
                                throw new Error(data && data.error ? data.error : ('Upload failed: ' + response.status));
                            }

                            if (!data || !data.location) {
                                throw new Error('Upload response is missing image URL.');
                            }

                            resolve(data.location);
                        });
                })
                .catch(function (error) {
                    reject(error && error.message ? error.message : error);
                });
            });
        }

        function buildSửaorImageHtml(location, altText) {
            return '<img src="' + escapeHtml(location) + '" alt="' + escapeHtml(altText || 'Mail image') + '" style="max-width:100%;height:auto;" />';
        }

        document.addEventListener('DOMContentLoaded', function () {
            initializeTemplateSửaor();
            initializeSignatureSửaor();
            renderSignaturePreview('hr');
            renderSignaturePreview('employee');
            renderSignaturePreview('candidate');
        });

        function getTemplateVisualSửaor() {
            return document.getElementById('tplBodySửaor');
        }

        function getTemplateHtmlSửaor() {
            return document.getElementById('tplBodyHtml');
        }

        function initializeTemplateSửaor() {
            if (templateSửaorInitialized) {
                return;
            }

            var editor = getTemplateVisualSửaor();
            var htmlSửaor = getTemplateHtmlSửaor();
            if (!editor || !htmlSửaor) {
                return;
            }

            ['keyup', 'mouseup', 'focus', 'blur'].forEach(function (eventName) {
                editor.addEventListener(eventName, saveTemplateSửaorSelection);
            });

            editor.addEventListener('input', function () {
                syncTemplateHtmlFromVisual();
            });

            htmlSửaor.addEventListener('input', function () {
                if (!htmlSửaor.classList.contains('d-none')) {
                    syncTemplateVisualFromHtml(htmlSửaor.value);
                }
            });

            editor.addEventListener('paste', handleTemplateSửaorPaste);

            document.addEventListener('selectionchange', function () {
                if (isSelectionInsideTemplateSửaor()) {
                    saveTemplateSửaorSelection();
                }
            });

            templateSửaorInitialized = true;
            syncTemplateVisualFromHtml('');
            setTemplateSửaorMode('visual');
        }

        function isSelectionInsideTemplateSửaor() {
            var editor = getTemplateVisualSửaor();
            var selection = window.getSelection();
            if (!editor || !selection || selection.rangeCount === 0) {
                return false;
            }

            return editor.contains(selection.getRangeAt(0).commonAncestorContainer);
        }

        function saveTemplateSửaorSelection() {
            var editor = getTemplateVisualSửaor();
            var selection = window.getSelection();
            if (!editor || !selection || selection.rangeCount === 0) {
                return;
            }

            var range = selection.getRangeAt(0);
            if (editor.contains(range.commonAncestorContainer)) {
                templateSửaorRange = range.cloneRange();
            }
        }

        function restoreTemplateSửaorSelection() {
            if (!templateSửaorRange) {
                return false;
            }

            var selection = window.getSelection();
            if (!selection) {
                return false;
            }

            selection.removeAllRanges();
            selection.addRange(templateSửaorRange);
            return true;
        }

        function moveTemplateCaretToEnd() {
            var editor = getTemplateVisualSửaor();
            if (!editor) {
                return;
            }

            var range = document.createRange();
            range.selectNodeContents(editor);
            range.collapse(false);

            var selection = window.getSelection();
            if (!selection) {
                return;
            }

            selection.removeAllRanges();
            selection.addRange(range);
            templateSửaorRange = range.cloneRange();
        }

        function focusTemplateSửaor() {
            var editor = getTemplateVisualSửaor();
            if (!editor || editor.classList.contains('d-none')) {
                return;
            }

            editor.focus();
            if (!restoreTemplateSửaorSelection()) {
                moveTemplateCaretToEnd();
            }
        }

        function setTemplateSửaorMode(mode) {
            initializeTemplateSửaor();

            var editor = getTemplateVisualSửaor();
            var htmlSửaor = getTemplateHtmlSửaor();
            var visualBtn = document.getElementById('tplVisualModeBtn');
            var htmlBtn = document.getElementById('tplHtmlModeBtn');
            if (!editor || !htmlSửaor || !visualBtn || !htmlBtn) {
                return;
            }

            var isHtmlMode = mode === 'html';
            if (isHtmlMode) {
                syncTemplateHtmlFromVisual();
            } else {
                syncTemplateVisualFromHtml(htmlSửaor.value);
            }

            editor.classList.toggle('d-none', isHtmlMode);
            htmlSửaor.classList.toggle('d-none', !isHtmlMode);
            visualBtn.classList.toggle('active', !isHtmlMode);
            htmlBtn.classList.toggle('active', isHtmlMode);

            document.querySelectorAll('.template-editor-visual-only').forEach(function (element) {
                if (element.tagName === 'BUTTON' || element.tagName === 'SELECT' || element.tagName === 'INPUT') {
                    element.disabled = isHtmlMode;
                }
            });

            if (!isHtmlMode) {
                focusTemplateSửaor();
            } else {
                htmlSửaor.focus();
            }
        }

        function normalizeTemplateBodyHtml(html) {
            if (!html) {
                return '';
            }

            var normalized = html
                .replace(/<div><br><\/div>/gi, '<p></p>')
                .replace(/<div>/gi, '<p>')
                .replace(/<\/div>/gi, '</p>')
                .replace(/&nbsp;(?=<\/p>)/gi, '')
                .trim();

            if (normalized === '<br>' || normalized === '<p></p>') {
                return '';
            }

            return normalized;
        }

        function syncTemplateHtmlFromVisual() {
            var editor = getTemplateVisualSửaor();
            var htmlSửaor = getTemplateHtmlSửaor();
            if (!editor || !htmlSửaor) {
                return '';
            }

            htmlSửaor.value = normalizeTemplateBodyHtml(editor.innerHTML);
            return htmlSửaor.value;
        }

        function syncTemplateVisualFromHtml(html) {
            var editor = getTemplateVisualSửaor();
            if (!editor) {
                return;
            }

            editor.innerHTML = html && html.trim().length > 0 ? html : '<p></p>';
            saveTemplateSửaorSelection();
        }

        function setTemplateBodyValue(html) {
            initializeTemplateSửaor();

            var htmlSửaor = getTemplateHtmlSửaor();
            if (!htmlSửaor) {
                return;
            }

            htmlSửaor.value = html || '';
            syncTemplateVisualFromHtml(htmlSửaor.value);
            setTemplateSửaorMode('visual');
        }

        function getTemplateBodyValue() {
            var htmlSửaor = getTemplateHtmlSửaor();
            if (!htmlSửaor) {
                return '';
            }

            if (htmlSửaor.classList.contains('d-none')) {
                return syncTemplateHtmlFromVisual();
            }

            return normalizeTemplateBodyHtml(htmlSửaor.value);
        }

        function runTemplateSửaorCommand(command, value) {
            var editor = getTemplateVisualSửaor();
            if (!editor || editor.classList.contains('d-none')) {
                return;
            }

            focusTemplateSửaor();
            document.execCommand(command, false, value || null);
            syncTemplateHtmlFromVisual();
            saveTemplateSửaorSelection();
        }

        function applyBlockFormat(value) {
            if (!value) {
                return;
            }

            runTemplateSửaorCommand('formatBlock', value);
        }

        function applyFontName(value) {
            if (!value) {
                return;
            }

            runTemplateSửaorCommand('fontName', value);
        }

        function applyFontSize(value) {
            if (!value) {
                return;
            }

            runTemplateSửaorCommand('fontSize', value);
        }

        function applyTextColor(value) {
            if (!value) {
                return;
            }

            runTemplateSửaorCommand('foreColor', value);
        }

        function applyHighlightColor(value) {
            if (!value) {
                return;
            }

            runTemplateSửaorCommand('hiliteColor', value);
        }

        function escapeHtml(text) {
            return (text || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function insertIntoHtmlTextarea(text) {
            var htmlSửaor = getTemplateHtmlSửaor();
            if (!htmlSửaor) {
                return;
            }

            var start = htmlSửaor.selectionStart || 0;
            var end = htmlSửaor.selectionEnd || 0;
            var currentValue = htmlSửaor.value || '';
            htmlSửaor.value = currentValue.substring(0, start) + text + currentValue.substring(end);
            htmlSửaor.selectionStart = htmlSửaor.selectionEnd = start + text.length;
            htmlSửaor.focus();
            syncTemplateVisualFromHtml(htmlSửaor.value);
        }

        function insertHtmlAtCursor(html) {
            var editor = getTemplateVisualSửaor();
            if (!editor || editor.classList.contains('d-none')) {
                insertIntoHtmlTextarea(html);
                return;
            }

            focusTemplateSửaor();
            document.execCommand('insertHTML', false, html);
            syncTemplateHtmlFromVisual();
            saveTemplateSửaorSelection();
        }

        function insertTemplateToken(token) {
            var htmlSửaor = getTemplateHtmlSửaor();
            if (htmlSửaor && !htmlSửaor.classList.contains('d-none')) {
                insertIntoHtmlTextarea(token);
                return;
            }

            focusTemplateSửaor();
            if (document.queryCommandSupported && document.queryCommandSupported('insertText')) {
                document.execCommand('insertText', false, token);
            } else {
                insertHtmlAtCursor(escapeHtml(token));
            }

            syncTemplateHtmlFromVisual();
            saveTemplateSửaorSelection();
        }

        function insertTemplateLink() {
            var url = prompt('Nhap duong dan link');
            if (!url) {
                return;
            }

            var htmlSửaor = getTemplateHtmlSửaor();
            if (htmlSửaor && !htmlSửaor.classList.contains('d-none')) {
                var linkText = prompt('Nội dung hiển thị', url) || url;
                insertIntoHtmlTextarea('<a href="' + escapeHtml(url) + '" target="_blank">' + escapeHtml(linkText) + '</a>');
                return;
            }

            focusTemplateSửaor();
            var selection = window.getSelection();
            var selectedText = selection && selection.toString ? selection.toString().trim() : '';
            if (!selectedText) {
                selectedText = prompt('Nội dung hiển thị', url) || url;
                document.execCommand('insertText', false, selectedText);
                saveTemplateSửaorSelection();
                focusTemplateSửaor();
            }

            document.execCommand('createLink', false, url);
            syncTemplateHtmlFromVisual();
        }

        function insertTemplateImage() {
            pickSửaorImageFile()
                .then(function (file) {
                    if (!file) {
                        return null;
                    }

                    return uploadSửaorImage(file).then(function (location) {
                        insertHtmlAtCursor(buildSửaorImageHtml(location, file.name || 'Template image'));
                    });
                })
                .catch(function (error) {
                    alert(error);
                });
        }

        function insertTemplateTable() {
            var rows = parseInt(prompt('So dong trong bang', '2') || '0', 10);
            var columns = parseInt(prompt('So cot trong bang', '2') || '0', 10);

            if (rows <= 0 || columns <= 0 || rows > 10 || columns > 10) {
                alert('Chi ho tro bang tu 1 den 10 dong/cot.');
                return;
            }

            var bodyRows = '';
            for (var rowIndex = 0; rowIndex < rows; rowIndex++) {
                var cells = '';
                for (var columnIndex = 0; columnIndex < columns; columnIndex++) {
                    cells += '<td style="border:1px solid #cbd5e1;padding:8px;">&nbsp;</td>';
                }
                bodyRows += '<tr>' + cells + '</tr>';
            }

            insertHtmlAtCursor('<table style="width:100%;border-collapse:collapse;"><tbody>' + bodyRows + '</tbody></table><p></p>');
        }

        function clearTemplateFormatting() {
            runTemplateSửaorCommand('removeFormat');
            runTemplateSửaorCommand('unlink');
        }

        function cleanupPastedHtml(html) {
            try {
                var parser = new DOMParser();
                var doc = parser.parseFromString(html, 'text/html');
                if (!doc || !doc.body) {
                    return html;
                }

                doc.querySelectorAll('meta, link, style, script, xml, o\\:p').forEach(function (node) {
                    node.remove();
                });

                var allowedStyles = [
                    'font-family',
                    'font-size',
                    'color',
                    'background-color',
                    'text-align',
                    'font-weight',
                    'font-style',
                    'text-decoration',
                    'line-height',
                    'margin-left',
                    'padding-left'
                ];

                doc.body.querySelectorAll('*').forEach(function (element) {
                    Array.from(element.attributes).forEach(function (attribute) {
                        var name = attribute.name.toLowerCase();
                        if (name === 'style') {
                            var safeStyles = attribute.value
                                .split(';')
                                .map(function (styleItem) { return styleItem.trim(); })
                                .filter(function (styleItem) {
                                    return allowedStyles.some(function (allowedStyle) {
                                        return styleItem.toLowerCase().startsWith(allowedStyle + ':');
                                    }) && styleItem.toLowerCase().indexOf('mso-') === -1;
                                });

                            if (safeStyles.length > 0) {
                                element.setAttribute('style', safeStyles.join('; '));
                            } else {
                                element.removeAttribute('style');
                            }
                            return;
                        }

                        if (name === 'href' || name === 'src' || name === 'colspan' || name === 'rowspan') {
                            return;
                        }

                        if (name === 'class' || name === 'lang' || name === 'xml:lang' || name.startsWith('data-')) {
                            element.removeAttribute(attribute.name);
                        }
                    });
                });

                return doc.body.innerHTML;
            } catch (error) {
                console.warn('Unable to cleanup pasted HTML', error);
                return html;
            }
        }

        function handleTemplateSửaorPaste(event) {
            var editor = getTemplateVisualSửaor();
            if (!editor || editor.classList.contains('d-none')) {
                return;
            }

            var clipboard = event.clipboardData || window.clipboardData;
            if (!clipboard) {
                return;
            }

            var html = clipboard.getData('text/html');
            var text = clipboard.getData('text/plain');
            if (!html && !text) {
                return;
            }

            event.preventDefault();
            if (html && html.trim().length > 0) {
                insertHtmlAtCursor(cleanupPastedHtml(html));
            } else {
                insertHtmlAtCursor(escapeHtml(text).replace(/\r?\n/g, '<br>'));
            }
        }

        function getSignatureVisualSửaor() {
            return document.getElementById('signatureBodySửaor');
        }

        function getSignatureHtmlSửaor() {
            return document.getElementById('signatureBodyHtml');
        }

        function getSignatureStorageField(targetType) {
            if (targetType === 'employee') {
                return document.getElementById('employeeSignature');
            }

            if (targetType === 'candidate') {
                return document.getElementById('candidateSignature');
            }

            return document.getElementById('hrSignature');
        }

        function getSignaturePreviewField(targetType) {
            if (targetType === 'employee') {
                return document.getElementById('employeeSignaturePreview');
            }

            if (targetType === 'candidate') {
                return document.getElementById('candidateSignaturePreview');
            }

            return document.getElementById('hrSignaturePreview');
        }

        function initializeSignatureSửaor() {
            if (signatureSửaorInitialized) {
                return;
            }

            var editor = getSignatureVisualSửaor();
            var htmlSửaor = getSignatureHtmlSửaor();
            if (!editor || !htmlSửaor) {
                return;
            }

            ['keyup', 'mouseup', 'focus', 'blur'].forEach(function (eventName) {
                editor.addEventListener(eventName, saveSignatureSửaorSelection);
            });

            editor.addEventListener('input', function () {
                syncSignatureHtmlFromVisual();
            });

            htmlSửaor.addEventListener('input', function () {
                if (!htmlSửaor.classList.contains('d-none')) {
                    syncSignatureVisualFromHtml(htmlSửaor.value);
                }
            });

            editor.addEventListener('paste', handleSignatureSửaorPaste);

            document.addEventListener('selectionchange', function () {
                if (isSelectionInsideSignatureSửaor()) {
                    saveSignatureSửaorSelection();
                }
            });

            signatureSửaorInitialized = true;
            syncSignatureVisualFromHtml('');
            setSignatureSửaorMode('visual');
        }

        function isSelectionInsideSignatureSửaor() {
            var editor = getSignatureVisualSửaor();
            var selection = window.getSelection();
            if (!editor || !selection || selection.rangeCount === 0) {
                return false;
            }

            return editor.contains(selection.getRangeAt(0).commonAncestorContainer);
        }

        function saveSignatureSửaorSelection() {
            var editor = getSignatureVisualSửaor();
            var selection = window.getSelection();
            if (!editor || !selection || selection.rangeCount === 0) {
                return;
            }

            var range = selection.getRangeAt(0);
            if (editor.contains(range.commonAncestorContainer)) {
                signatureSửaorRange = range.cloneRange();
            }
        }

        function restoreSignatureSửaorSelection() {
            if (!signatureSửaorRange) {
                return false;
            }

            var selection = window.getSelection();
            if (!selection) {
                return false;
            }

            selection.removeAllRanges();
            selection.addRange(signatureSửaorRange);
            return true;
        }

        function moveSignatureCaretToEnd() {
            var editor = getSignatureVisualSửaor();
            if (!editor) {
                return;
            }

            var range = document.createRange();
            range.selectNodeContents(editor);
            range.collapse(false);

            var selection = window.getSelection();
            if (!selection) {
                return;
            }

            selection.removeAllRanges();
            selection.addRange(range);
            signatureSửaorRange = range.cloneRange();
        }

        function focusSignatureSửaor() {
            var editor = getSignatureVisualSửaor();
            if (!editor || editor.classList.contains('d-none')) {
                return;
            }

            editor.focus();
            if (!restoreSignatureSửaorSelection()) {
                moveSignatureCaretToEnd();
            }
        }

        function setSignatureSửaorMode(mode) {
            initializeSignatureSửaor();

            var editor = getSignatureVisualSửaor();
            var htmlSửaor = getSignatureHtmlSửaor();
            var visualBtn = document.getElementById('sigVisualModeBtn');
            var htmlBtn = document.getElementById('sigHtmlModeBtn');
            if (!editor || !htmlSửaor || !visualBtn || !htmlBtn) {
                return;
            }

            var isHtmlMode = mode === 'html';
            if (isHtmlMode) {
                syncSignatureHtmlFromVisual();
            } else {
                syncSignatureVisualFromHtml(htmlSửaor.value);
            }

            editor.classList.toggle('d-none', isHtmlMode);
            htmlSửaor.classList.toggle('d-none', !isHtmlMode);
            visualBtn.classList.toggle('active', !isHtmlMode);
            htmlBtn.classList.toggle('active', isHtmlMode);

            document.querySelectorAll('.signature-editor-visual-only').forEach(function (element) {
                if (element.tagName === 'BUTTON' || element.tagName === 'SELECT' || element.tagName === 'INPUT') {
                    element.disabled = isHtmlMode;
                }
            });

            if (!isHtmlMode) {
                focusSignatureSửaor();
            } else {
                htmlSửaor.focus();
            }
        }

        function syncSignatureHtmlFromVisual() {
            var editor = getSignatureVisualSửaor();
            var htmlSửaor = getSignatureHtmlSửaor();
            if (!editor || !htmlSửaor) {
                return '';
            }

            htmlSửaor.value = normalizeTemplateBodyHtml(editor.innerHTML);
            return htmlSửaor.value;
        }

        function syncSignatureVisualFromHtml(html) {
            var editor = getSignatureVisualSửaor();
            if (!editor) {
                return;
            }

            editor.innerHTML = html && html.trim().length > 0 ? html : '<p></p>';
            saveSignatureSửaorSelection();
        }

        function setSignatureBodyValue(html) {
            initializeSignatureSửaor();

            var htmlSửaor = getSignatureHtmlSửaor();
            if (!htmlSửaor) {
                return;
            }

            htmlSửaor.value = html || '';
            syncSignatureVisualFromHtml(htmlSửaor.value);
            setSignatureSửaorMode('visual');
        }

        function getSignatureBodyValue() {
            var htmlSửaor = getSignatureHtmlSửaor();
            if (!htmlSửaor) {
                return '';
            }

            if (htmlSửaor.classList.contains('d-none')) {
                return syncSignatureHtmlFromVisual();
            }

            return normalizeTemplateBodyHtml(htmlSửaor.value);
        }

        function runSignatureSửaorCommand(command, value) {
            var editor = getSignatureVisualSửaor();
            if (!editor || editor.classList.contains('d-none')) {
                return;
            }

            focusSignatureSửaor();
            document.execCommand(command, false, value || null);
            syncSignatureHtmlFromVisual();
            saveSignatureSửaorSelection();
        }

        function applySignatureBlockFormat(value) {
            if (!value) {
                return;
            }

            runSignatureSửaorCommand('formatBlock', value);
        }

        function applySignatureFontName(value) {
            if (!value) {
                return;
            }

            runSignatureSửaorCommand('fontName', value);
        }

        function applySignatureFontSize(value) {
            if (!value) {
                return;
            }

            runSignatureSửaorCommand('fontSize', value);
        }

        function applySignatureTextColor(value) {
            if (!value) {
                return;
            }

            runSignatureSửaorCommand('foreColor', value);
        }

        function applySignatureHighlightColor(value) {
            if (!value) {
                return;
            }

            runSignatureSửaorCommand('hiliteColor', value);
        }

        function insertIntoSignatureHtmlTextarea(text) {
            var htmlSửaor = getSignatureHtmlSửaor();
            if (!htmlSửaor) {
                return;
            }

            var start = htmlSửaor.selectionStart || 0;
            var end = htmlSửaor.selectionEnd || 0;
            var currentValue = htmlSửaor.value || '';
            htmlSửaor.value = currentValue.substring(0, start) + text + currentValue.substring(end);
            htmlSửaor.selectionStart = htmlSửaor.selectionEnd = start + text.length;
            htmlSửaor.focus();
            syncSignatureVisualFromHtml(htmlSửaor.value);
        }

        function insertSignatureHtmlAtCursor(html) {
            var editor = getSignatureVisualSửaor();
            if (!editor || editor.classList.contains('d-none')) {
                insertIntoSignatureHtmlTextarea(html);
                return;
            }

            focusSignatureSửaor();
            document.execCommand('insertHTML', false, html);
            syncSignatureHtmlFromVisual();
            saveSignatureSửaorSelection();
        }

        function insertSignatureToken(token) {
            var htmlSửaor = getSignatureHtmlSửaor();
            if (htmlSửaor && !htmlSửaor.classList.contains('d-none')) {
                insertIntoSignatureHtmlTextarea(token);
                return;
            }

            focusSignatureSửaor();
            if (document.queryCommandSupported && document.queryCommandSupported('insertText')) {
                document.execCommand('insertText', false, token);
            } else {
                insertSignatureHtmlAtCursor(escapeHtml(token));
            }

            syncSignatureHtmlFromVisual();
            saveSignatureSửaorSelection();
        }

        function insertSignatureLink() {
            var url = prompt('Nhap duong dan link');
            if (!url) {
                return;
            }

            var htmlSửaor = getSignatureHtmlSửaor();
            if (htmlSửaor && !htmlSửaor.classList.contains('d-none')) {
                var linkText = prompt('Nội dung hiển thị', url) || url;
                insertIntoSignatureHtmlTextarea('<a href="' + escapeHtml(url) + '" target="_blank">' + escapeHtml(linkText) + '</a>');
                return;
            }

            focusSignatureSửaor();
            var selection = window.getSelection();
            var selectedText = selection && selection.toString ? selection.toString().trim() : '';
            if (!selectedText) {
                selectedText = prompt('Nội dung hiển thị', url) || url;
                document.execCommand('insertText', false, selectedText);
                saveSignatureSửaorSelection();
                focusSignatureSửaor();
            }

            document.execCommand('createLink', false, url);
            syncSignatureHtmlFromVisual();
        }

        function insertSignatureImage() {
            pickSửaorImageFile()
                .then(function (file) {
                    if (!file) {
                        return null;
                    }

                    return uploadSửaorImage(file).then(function (location) {
                        insertSignatureHtmlAtCursor(buildSửaorImageHtml(location, file.name || 'Signature image'));
                    });
                })
                .catch(function (error) {
                    alert(error);
                });
        }

        function insertSignatureTable() {
            var rows = parseInt(prompt('So dong trong bang', '2') || '0', 10);
            var columns = parseInt(prompt('So cot trong bang', '2') || '0', 10);

            if (rows <= 0 || columns <= 0 || rows > 10 || columns > 10) {
                alert('Chi ho tro bang tu 1 den 10 dong/cot.');
                return;
            }

            var bodyRows = '';
            for (var rowIndex = 0; rowIndex < rows; rowIndex++) {
                var cells = '';
                for (var columnIndex = 0; columnIndex < columns; columnIndex++) {
                    cells += '<td style="border:1px solid #cbd5e1;padding:8px;">&nbsp;</td>';
                }
                bodyRows += '<tr>' + cells + '</tr>';
            }

            insertSignatureHtmlAtCursor('<table style="width:100%;border-collapse:collapse;"><tbody>' + bodyRows + '</tbody></table><p></p>');
        }

        function clearSignatureFormatting() {
            runSignatureSửaorCommand('removeFormat');
            runSignatureSửaorCommand('unlink');
        }

        function handleSignatureSửaorPaste(event) {
            var editor = getSignatureVisualSửaor();
            if (!editor || editor.classList.contains('d-none')) {
                return;
            }

            var clipboard = event.clipboardData || window.clipboardData;
            if (!clipboard) {
                return;
            }

            var html = clipboard.getData('text/html');
            var text = clipboard.getData('text/plain');
            if (!html && !text) {
                return;
            }

            event.preventDefault();
            if (html && html.trim().length > 0) {
                insertSignatureHtmlAtCursor(cleanupPastedHtml(html));
            } else {
                insertSignatureHtmlAtCursor(escapeHtml(text).replace(/\r?\n/g, '<br>'));
            }
        }

        function renderSignaturePreview(targetType) {
            var storageField = getSignatureStorageField(targetType);
            var previewField = getSignaturePreviewField(targetType);
            if (!storageField || !previewField) {
                return;
            }

            var html = storageField.value || '';
            if (html.trim().length === 0) {
                previewField.innerHTML = 'Chữa co chu ky.';
                previewField.classList.add('is-empty');
                return;
            }

            previewField.innerHTML = html;
            previewField.classList.remove('is-empty');
        }

        function openSignatureSửaor(targetType) {
            initializeSignatureSửaor();

            var storageField = getSignatureStorageField(targetType);
            document.getElementById('signatureTargetType').value = targetType;
            document.getElementById('signatureModalTitle').innerText =
                targetType === 'employee'
                    ? 'Sửa chữ ký mail nhan vien'
                    : (targetType === 'candidate' ? 'Sửa chữ ký mail ung vien' : 'Sửa chữ ký mail nhan su');
            setSignatureBodyValue(storageField ? storageField.value : '');

            var modal = new bootstrap.Modal(document.getElementById('signatureModal'));
            modal.show();
        }

        function saveSignatureSửaor() {
            var targetType = document.getElementById('signatureTargetType').value || 'hr';
            var storageField = getSignatureStorageField(targetType);
            if (!storageField) {
                return;
            }

            storageField.value = getSignatureBodyValue();
            renderSignaturePreview(targetType);

            var modalElement = document.getElementById('signatureModal');
            var modal = bootstrap.Modal.getInstance(modalElement);
            if (modal) {
                modal.hide();
            }
        }

        function clearSignature(targetType) {
            if (!confirm('Bạn có chắc chắn muốn xóa chữ ký này không?')) {
                return;
            }

            var storageField = getSignatureStorageField(targetType);
            if (!storageField) {
                return;
            }

            storageField.value = '';
            renderSignaturePreview(targetType);
        }

        function openTemplate(id) {
            initializeTemplateSửaor();

            var row = document.querySelector("tr[data-id='" + id + "']");
            if (!row) return;

            document.getElementById('tplId').value = id;
            document.getElementById('tplCode').value = row.dataset.code || '';
            document.getElementById('tplName').value = row.dataset.name || '';
            document.getElementById('tplSubject').value = row.dataset.subject || '';
            document.getElementById('tplSenderType').value = row.dataset.sendertype || 'HR';
            document.getElementById('tplCcManager').checked = (row.dataset.ccmanager === 'True' || row.dataset.ccmanager === 'true');
            document.getElementById('tplCcEmails').value = row.dataset.ccemails || '';
            document.getElementById('tplBccEmails').value = row.dataset.bccemails || '';
            document.getElementById('tplIsActive').checked = (row.dataset.active === '1' || row.dataset.active === 'True' || row.dataset.active === 'true');

            var bodyNode = document.getElementById('tpl-body-' + id);
            setTemplateBodyValue(bodyNode ? bodyNode.value : '');

            var modal = new bootstrap.Modal(document.getElementById('templateModal'));
            modal.show();
        }

        function saveMailSetting() {
            var payload = {
                Id: parseInt(document.getElementById('settingId').value || '0'),
                SmtpHost: document.getElementById('smtpHost').value,
                SmtpPort: parseInt(document.getElementById('smtpPort').value || '0'),
                SmtpUser: document.getElementById('smtpUser').value,
                SmtpPassword: document.getElementById('smtpPassword').value,
                FromEmail: document.getElementById('hrFromEmail').value,
                FromName: document.getElementById('hrFromName').value,
                HrFromEmail: document.getElementById('hrFromEmail').value,
                HrFromName: document.getElementById('hrFromName').value,
                HrSignature: document.getElementById('hrSignature').value,
                EmployeeFromEmail: document.getElementById('employeeFromEmail').value,
                EmployeeFromName: document.getElementById('employeeFromName').value,
                EmployeeSignature: document.getElementById('employeeSignature').value,
                CandidateFromEmail: document.getElementById('candidateFromEmail').value,
                CandidateFromName: document.getElementById('candidateFromName').value,
                CandidateSignature: document.getElementById('candidateSignature').value,
                EnableSsl: document.getElementById('enableSsl').checked,
                IsActive: document.getElementById('settingActive').checked ? 1 : 0
            };

            fetch('?handler=LưuSetting', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getRequestVerificationToken()
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                alert(data.success ? 'Lưud' : ('Lưu failed: ' + (data.message || 'Lỗi không xác định')));
            });
        }

        function saveTemplate() {
            var payload = {
                Id: parseInt(document.getElementById('tplId').value || '0'),
                Code: document.getElementById('tplCode').value,
                Name: document.getElementById('tplName').value,
                Subject: document.getElementById('tplSubject').value,
                Body: getTemplateBodyValue(),
                SenderType: document.getElementById('tplSenderType').value,
                CcManager: document.getElementById('tplCcManager').checked,
                CcEmails: document.getElementById('tplCcEmails').value,
                BccEmails: document.getElementById('tplBccEmails').value,
                IsActive: document.getElementById('tplIsActive').checked ? 1 : 0
            };

            fetch('?handler=LưuTemplate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getRequestVerificationToken()
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Lưu failed: ' + (data.message || 'Lỗi không xác định'));
                }
            });
        }

        function sendTestMail() {
            var payload = {
                ToEmail: document.getElementById('testToEmail').value,
                TemplateCode: document.getElementById('testTemplateCode').value
            };

            fetch('?handler=SendTest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getRequestVerificationToken()
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                alert(data.success ? 'Đã gửi mail kiểm thử' : ('Gửi thất bại: ' + (data.message || 'Lỗi không xác định')));
            });
        }
    </script>
}
