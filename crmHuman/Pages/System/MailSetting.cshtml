@page
@model crmHuman.Pages.System.MailSettingModel
@using VS.Human.Rep.Model
@{
    Layout = "_Layout";
}

<div class="card">
    <div class="card-body">
        @Html.AntiForgeryToken()
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h5 class="card-title mb-0">@Model.TitlePage</h5>
            <a class="btn btn-outline-secondary btn-sm" href="/System/MailHistory">Xem mail da gui</a>
        </div>

        <ul class="nav nav-tabs" id="mailSettingTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="smtp-tab" data-bs-toggle="tab" data-bs-target="#smtpTab" type="button" role="tab">SMTP</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="template-tab" data-bs-toggle="tab" data-bs-target="#templateTab" type="button" role="tab">Templates</button>
            </li>
        </ul>

        <div class="tab-content pt-3" id="mailSettingTabContent">
            <div class="tab-pane fade show active" id="smtpTab" role="tabpanel">
                <input type="hidden" id="settingId" value="@Model.Setting?.Id" />
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">SMTP Host</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="smtpHost" value="@Model.Setting?.SmtpHost" />
                    </div>
                    <label class="col-sm-2 col-form-label">SMTP Port</label>
                    <div class="col-sm-4">
                        <input type="number" class="form-control" id="smtpPort" value="@Model.Setting?.SmtpPort" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">User</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="smtpUser" value="@Model.Setting?.SmtpUser" />
                    </div>
                    <label class="col-sm-2 col-form-label">Password</label>
                    <div class="col-sm-4">
                        <input type="password" class="form-control" id="smtpPassword" placeholder="Leave blank to keep current" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">SMTP ghi chu</label>
                    <div class="col-sm-10">
                        <div class="form-text mt-2">
                            SMTP server dung chung cho toan he thong. Ben duoi la cau hinh mac dinh/fallback cho template.
                            Neu nguoi dang gui co email va chu ky rieng trong ho so ca nhan, he thong se uu tien dung thong tin nguoi do lam sender hien thi.
                            Neu mail server chi cho phep gui tu dung dia chi/xac thuc, can cau hinh send-as/alias phu hop cho tai khoan SMTP admin.
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-lg-6">
                        <div class="card border shadow-sm h-100">
                            <div class="card-header bg-light fw-semibold">Mail nhan su mac dinh</div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label">From Email</label>
                                    <input type="text" class="form-control" id="hrFromEmail" value="@(Model.Setting?.HrFromEmail ?? Model.Setting?.FromEmail)" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">From Name</label>
                                    <input type="text" class="form-control" id="hrFromName" value="@(Model.Setting?.HrFromName ?? Model.Setting?.FromName)" />
                                </div>
                                <textarea class="d-none" id="hrSignature">@(Model.Setting?.HrSignature ?? string.Empty)</textarea>
                                <div class="d-flex gap-2 mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openSignatureEditor('hr')">Edit chu ky</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSignature('hr')">Xoa chu ky</button>
                                </div>
                                <div class="signature-preview" id="hrSignaturePreview"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="card border shadow-sm h-100">
                            <div class="card-header bg-light fw-semibold">Mail nhan vien mac dinh</div>
                            <div class="card-body">
                                <div class="small text-muted mb-3">
                                    Duoc dung khi nguoi gui khong co email/chu ky rieng trong ho so ca nhan.
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">From Email</label>
                                    <input type="text" class="form-control" id="employeeFromEmail" value="@Model.Setting?.EmployeeFromEmail" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">From Name</label>
                                    <input type="text" class="form-control" id="employeeFromName" value="@Model.Setting?.EmployeeFromName" />
                                </div>
                                <textarea class="d-none" id="employeeSignature">@(Model.Setting?.EmployeeSignature ?? string.Empty)</textarea>
                                <div class="d-flex gap-2 mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openSignatureEditor('employee')">Edit chu ky</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSignature('employee')">Xoa chu ky</button>
                                </div>
                                <div class="signature-preview" id="employeeSignaturePreview"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-2">Enable SSL</div>
                    <div class="col-sm-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="enableSsl" @(Model.Setting?.EnableSsl == true ? "checked" : "") />
                        </div>
                    </div>
                    <div class="col-sm-2">Active</div>
                    <div class="col-sm-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="settingActive" @(Model.Setting?.IsActive == 1 ? "checked" : "") />
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <button type="button" class="btn btn-primary" onclick="saveMailSetting()">Save</button>
                </div>
                <hr />
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Test To Email</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="testToEmail" placeholder="test@example.com" />
                    </div>
                    <label class="col-sm-2 col-form-label">Template Code</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="testTemplateCode" list="templateCodes" placeholder="LEAVE_CREATE" />
                        <datalist id="templateCodes">
                            @foreach (var item in Model.Templates)
                            {
                                <option value="@item.Code"></option>
                            }
                        </datalist>
                    </div>
                </div>
                <div class="text-end">
                    <button type="button" class="btn btn-outline-secondary" onclick="sendTestMail()">Send Test</button>
                </div>
            </div>

            <div class="tab-pane fade" id="templateTab" role="tabpanel">
                <div class="alert alert-secondary small">
                    Tokens leave: {{EmployeeName}}, {{ManagerName}}, {{LeaveType}}, {{FromDate}}, {{ToDate}}, {{TotalDays}}, {{Reason}}, {{RejectReason}}.
                    Tokens interview: {{CandidateName}}, {{AppliedPosition}}, {{InterviewAction}}, {{InterviewRound}}, {{ScheduleDate}}, {{InterviewMode}}, {{AddressInfo}}, {{InterviewerName}}, {{RoomName}}, {{Noted}}.
                    Tokens sender: {{SenderName}}, {{SenderEmail}}, {{SenderTypeText}}, {{SenderSignature}}.
                    Ho tro ca {{Token}} va {Token}. Neu body khong co {{SenderSignature}} thi he thong se tu dong noi chu ky vao cuoi mail.
                    Anh/logo trong mail nen duoc chen bang nut anh de he thong upload va nhung inline khi gui. Khong nen paste truc tiep tu Word/Outlook vi de sinh duong dan file:/// hoac cid: se bi vo anh trong mail.
                </div>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Subject</th>
                            <th>Gui tu</th>
                            <th class="text-center">Active</th>
                            <th class="text-center">CC Manager</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Templates)
                        {
                            <tr data-id="@item.Id"
                                data-code="@item.Code"
                                data-name="@item.Name"
                                data-subject="@item.Subject"
                                data-sendertype="@item.SenderType"
                                data-active="@item.IsActive"
                                data-ccmanager="@item.CcManager"
                                data-ccemails="@item.CcEmails"
                                data-bccemails="@item.BccEmails">
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@item.Subject</td>
                                <td>@EmailSenderTypes.GetDisplayText(item.SenderType)</td>
                                <td class="text-center">@((item.IsActive == 1) ? "Yes" : "No")</td>
                                <td class="text-center">@((item.CcManager) ? "Yes" : "No")</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openTemplate(@item.Id)">Edit</button>
                                </td>
                            </tr>
                            <textarea class="d-none" id="tpl-body-@item.Id">@item.Body</textarea>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="templateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit template</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="tplId" />
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Code</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="tplCode" disabled />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Name</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="tplName" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Subject</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="tplSubject" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Gui tu</label>
                    <div class="col-sm-9">
                        <select class="form-select" id="tplSenderType">
                            <option value="HR">Mail nhan su</option>
                            <option value="EMPLOYEE">Mail nhan vien</option>
                        </select>
                        <div class="form-text">
                            Chon profile gui mail cho template nay. Chu ky cua profile duoc tu dong noi vao cuoi mail.
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Body</label>
                    <div class="col-sm-9">
                        <div class="template-editor-shell">
                            <div class="template-editor-toolbar">
                                <div class="btn-toolbar gap-2 flex-wrap" role="toolbar">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-primary active" id="tplVisualModeBtn" onclick="setTemplateEditorMode('visual')">Visual</button>
                                        <button type="button" class="btn btn-outline-primary" id="tplHtmlModeBtn" onclick="setTemplateEditorMode('html')">HTML</button>
                                    </div>

                                    <select class="form-select form-select-sm template-editor-select template-editor-visual-only" id="tplBlockFormat" onchange="applyBlockFormat(this.value)">
                                        <option value="<p>">Doan van</option>
                                        <option value="<h1>">Tieu de 1</option>
                                        <option value="<h2>">Tieu de 2</option>
                                        <option value="<h3>">Tieu de 3</option>
                                        <option value="<blockquote>">Trich dan</option>
                                    </select>

                                    <select class="form-select form-select-sm template-editor-select template-editor-visual-only" id="tplFontFamily" onchange="applyFontName(this.value)">
                                        <option value="Arial">Arial</option>
                                        <option value="Tahoma">Tahoma</option>
                                        <option value="Verdana">Verdana</option>
                                        <option value="Times New Roman">Times New Roman</option>
                                        <option value="Georgia">Georgia</option>
                                        <option value="Courier New">Courier New</option>
                                    </select>

                                    <select class="form-select form-select-sm template-editor-select template-editor-visual-only" id="tplFontSize" onchange="applyFontSize(this.value)">
                                        <option value="2">Nho</option>
                                        <option value="3" selected>Vua</option>
                                        <option value="4">Hoi lon</option>
                                        <option value="5">Lon</option>
                                        <option value="6">Rat lon</option>
                                    </select>

                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('bold')" title="Dam"><strong>B</strong></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('italic')" title="Nghieng"><em>I</em></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('underline')" title="Gach chan"><u>U</u></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('strikeThrough')" title="Gach ngang"><s>S</s></button>
                                    </div>

                                    <div class="d-flex align-items-center gap-1 template-editor-visual-only">
                                        <label class="small text-muted mb-0" for="tplTextColor">Chu</label>
                                        <input type="color" id="tplTextColor" class="form-control form-control-color form-control-color-sm" value="#1f2937" onchange="applyTextColor(this.value)" />
                                    </div>
                                    <div class="d-flex align-items-center gap-1 template-editor-visual-only">
                                        <label class="small text-muted mb-0" for="tplHighlightColor">Nen</label>
                                        <input type="color" id="tplHighlightColor" class="form-control form-control-color form-control-color-sm" value="#fff59d" onchange="applyHighlightColor(this.value)" />
                                    </div>

                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('justifyLeft')" title="Can trai"><i class="bi bi-text-left"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('justifyCenter')" title="Can giua"><i class="bi bi-text-center"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('justifyRight')" title="Can phai"><i class="bi bi-text-right"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('justifyFull')" title="Can deu"><i class="bi bi-justify"></i></button>
                                    </div>

                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('insertUnorderedList')" title="Danh sach cham"><i class="bi bi-list-ul"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('insertOrderedList')" title="Danh sach so"><i class="bi bi-list-ol"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('outdent')" title="Giam le"><i class="bi bi-text-indent-right"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('indent')" title="Tang le"><i class="bi bi-text-indent-left"></i></button>
                                    </div>

                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary" onclick="insertTemplateLink()" title="Chen link"><i class="bi bi-link-45deg"></i></button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="insertTemplateImage()" title="Chen anh"><i class="bi bi-image"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('unlink')" title="Bo link"><i class="bi bi-link"></i></button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="insertTemplateTable()" title="Chen bang"><i class="bi bi-table"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="runTemplateEditorCommand('insertHorizontalRule')" title="Duong ke ngang"><i class="bi bi-dash-lg"></i></button>
                                        <button type="button" class="btn btn-outline-secondary template-editor-visual-only" onclick="clearTemplateFormatting()" title="Xoa dinh dang"><i class="bi bi-eraser"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div class="template-editor-token-bar">
                                <span class="template-editor-token-label">Token nhanh:</span>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{EmployeeName}}')">{{EmployeeName}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{ManagerName}}')">{{ManagerName}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{LeaveType}}')">{{LeaveType}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{FromDate}}')">{{FromDate}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{ToDate}}')">{{ToDate}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{TotalDays}}')">{{TotalDays}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{Reason}}')">{{Reason}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{CandidateName}}')">{{CandidateName}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{AppliedPosition}}')">{{AppliedPosition}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{InterviewRound}}')">{{InterviewRound}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{ScheduleDate}}')">{{ScheduleDate}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{AddressInfo}}')">{{AddressInfo}}</button>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="insertTemplateToken('{{InterviewerName}}')">{{InterviewerName}}</button>
                            </div>

                            <div id="tplBodyEditor" class="template-editor-canvas" contenteditable="true"></div>
                            <textarea class="form-control d-none template-editor-html" id="tplBodyHtml" rows="14" spellcheck="false"></textarea>
                        </div>
                        <div class="form-text">
                            Ho tro soan noi dung kieu Word, dan tu Word/Google Docs, doi font chu va chuyen qua HTML khi can.
                            Nen uu tien font email-safe: Arial, Tahoma, Verdana, Times New Roman, Georgia, Courier New.
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">CC Manager</label>
                    <div class="col-sm-9">
                        <input class="form-check-input" type="checkbox" id="tplCcManager" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">CC Emails</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="tplCcEmails" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">BCC Emails</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="tplBccEmails" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Active</label>
                    <div class="col-sm-9">
                        <input class="form-check-input" type="checkbox" id="tplIsActive" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="saveTemplate()">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="signatureModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="signatureModalTitle">Edit chu ky</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="signatureTargetType" />
                <div class="template-editor-shell">
                    <div class="template-editor-toolbar">
                        <div class="btn-toolbar gap-2 flex-wrap" role="toolbar">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary active" id="sigVisualModeBtn" onclick="setSignatureEditorMode('visual')">Visual</button>
                                <button type="button" class="btn btn-outline-primary" id="sigHtmlModeBtn" onclick="setSignatureEditorMode('html')">HTML</button>
                            </div>

                            <select class="form-select form-select-sm template-editor-select signature-editor-visual-only" id="sigBlockFormat" onchange="applySignatureBlockFormat(this.value)">
                                <option value="<p>">Doan van</option>
                                <option value="<h1>">Tieu de 1</option>
                                <option value="<h2>">Tieu de 2</option>
                                <option value="<h3>">Tieu de 3</option>
                                <option value="<blockquote>">Trich dan</option>
                            </select>

                            <select class="form-select form-select-sm template-editor-select signature-editor-visual-only" id="sigFontFamily" onchange="applySignatureFontName(this.value)">
                                <option value="Arial">Arial</option>
                                <option value="Tahoma">Tahoma</option>
                                <option value="Verdana">Verdana</option>
                                <option value="Times New Roman">Times New Roman</option>
                                <option value="Georgia">Georgia</option>
                                <option value="Courier New">Courier New</option>
                            </select>

                            <select class="form-select form-select-sm template-editor-select signature-editor-visual-only" id="sigFontSize" onchange="applySignatureFontSize(this.value)">
                                <option value="2">Nho</option>
                                <option value="3" selected>Vua</option>
                                <option value="4">Hoi lon</option>
                                <option value="5">Lon</option>
                                <option value="6">Rat lon</option>
                            </select>

                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureEditorCommand('bold')" title="Dam"><strong>B</strong></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureEditorCommand('italic')" title="Nghieng"><em>I</em></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureEditorCommand('underline')" title="Gach chan"><u>U</u></button>
                                <button type="button" class="btn btn-outline-secondary signature-editor-visual-only" onclick="runSignatureEditorCommand('strikeThrough')" title="Gach ngang"><s>S</s></button>
                            </div>

                            <div class="d-flex align-items-center gap-1 signature-editor-visual-only">
                                <label class="small text-muted mb-0" for="sigTextColor">Chu</label>
                                <input type="color" id="sigTextColor" class="form-control form-control-color form-control-color-sm" value="#1f2937" onchange="applySignatureTextColor(this.value)" />
                            </div>
                            <div class="d-flex align-items-center gap-1 signature-editor-visual-only">
                                <label class="small text-muted mb-0" for="sigHighlightColor">Nen</label>
                                <input type="color" id="sigHighlightColor" class="form-control form-control-color form-control-color-sm" value="#fff59d" onchange="applySignatureHighlightColor(this.value)" />
                            </div>

                            <div class="btn-group btn-group-sm" role="group">
