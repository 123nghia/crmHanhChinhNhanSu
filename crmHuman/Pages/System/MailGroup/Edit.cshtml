@page
@model crmHuman.Pages.System.MailGroup.EditModel
@{
    ViewData["Title"] = Model.TitlePage;
}

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chu</a></li>
            <li class="breadcrumb-item"><a href="/System/MailGroup">Nhom mail</a></li>
            <li class="breadcrumb-item active">@(Model.IsEditMode ? "Chinh sua" : "Them moi")</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <form method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="FormModel.Id" />
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-lg-6">
                                <label class="form-label" for="FormModel_Name">Ten nhom</label>
                                <input class="form-control" asp-for="FormModel.Name" maxlength="200" required />
                                <span asp-validation-for="FormModel.Name" class="text-danger"></span>
                            </div>
                            <div class="col-lg-6">
                                <label class="form-label" for="FormModel_Description">Mo ta</label>
                                <input class="form-control" asp-for="FormModel.Description" maxlength="1000" />
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="FormModel.IncludeAllCompanyEmails" />
                                    <label class="form-check-label" for="FormModel_IncludeAllCompanyEmails">
                                        Lay toan bo mail cong ty
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="FormModel.IncludeAllPersonalEmails" />
                                    <label class="form-check-label" for="FormModel_IncludeAllPersonalEmails">
                                        Lay toan bo mail ca nhan
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="FormModel.IsBlocked" />
                                    <label class="form-check-label" for="FormModel_IsBlocked">
                                        Block ca nhom mail
                                    </label>
                                </div>
                                <div class="form-text">Tuy chon. Co the bo trong neu chi block tung email.</div>
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-lg-6">
                                <label class="form-label" for="FormModel_ManualRecipientEmails">Danh sach mail thu cong</label>
                                <textarea class="form-control" asp-for="FormModel.ManualRecipientEmails" rows="10" placeholder="Moi dong mot email hoac Display Name <email@domain.com>"></textarea>
                                <div class="form-text">Tuy chon. Danh sach nay duoc gui binh thuong.</div>
                            </div>
                            <div class="col-lg-6">
                                <label class="form-label" for="FormModel_BlockedRecipientEmails">Danh sach mail block</label>
                                <textarea class="form-control" asp-for="FormModel.BlockedRecipientEmails" rows="10" placeholder="Nhap email can loai khoi nhom gui"></textarea>
                                <div class="form-text">Tuy chon, co the de trong. Cac email trong o nay van duoc luu trong nhom nhung se bi bo qua khi gui.</div>
                            </div>
                        </div>

                        <div class="alert alert-light border mt-3">
                            <div class="fw-semibold mb-1">Luu y</div>
                            <div>He thong se hop nhat danh sach mail trong nhom, bo email trung va loai bo email dang block.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Luu</button>
                            <a class="btn btn-outline-secondary" href="/System/MailGroup">Huy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
