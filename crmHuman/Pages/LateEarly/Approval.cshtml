@page
@model crmHuman.Pages.LateEarly.ApprovalModel
@{
    ViewData["Title"] = Model.TitlePage;
    var pendingCount = 0;
    var managerPendingCount = 0;
    var hrPendingCount = 0;
    var boardPendingCount = 0;
    var legacyPendingCount = 0;

    if (Model.RequestList?.Data != null)
    {
        foreach (var item in Model.RequestList.Data)
        {
            var info = item as dynamic;
            if (info == null)
            {
                continue;
            }

            pendingCount++;

            if (info.Status == 0)
            {
                managerPendingCount++;
            }
            else if (info.Status == 1)
            {
                hrPendingCount++;
            }
            else if (info.Status == 2)
            {
                boardPendingCount++;
            }
            else if (info.Status == 3)
            {
                legacyPendingCount++;
            }
        }
    }
}

@Html.AntiForgeryToken()

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Duyệt yêu cầu</li>
        </ol>
    </nav>
</div>

<section class="section admin-page-shell">
    <div class="admin-kpi-strip">
        <div class="admin-kpi-card">
            <span class="admin-kpi-label">Yêu cầu chờ duyệt</span>
            <strong class="admin-kpi-value">@pendingCount</strong>
            <span class="admin-kpi-meta">Tổng đơn đi trễ/về sớm đang mở</span>
        </div>
        <div class="admin-kpi-card">
            <span class="admin-kpi-label">Chờ quản lý</span>
            <strong class="admin-kpi-value">@managerPendingCount</strong>
            <span class="admin-kpi-meta">Các đơn đang ở bước quản lý</span>
        </div>
        <div class="admin-kpi-card">
            <span class="admin-kpi-label">Chờ HCNS/BGĐ</span>
            <strong class="admin-kpi-value">@(hrPendingCount + boardPendingCount)</strong>
            <span class="admin-kpi-meta">Tập trung các bước xử lý trung tâm</span>
        </div>
        <div class="admin-kpi-card">
            <span class="admin-kpi-label">Tồn luồng cũ</span>
            <strong class="admin-kpi-value">@legacyPendingCount</strong>
            <span class="admin-kpi-meta">Các đơn còn ở bước admin cũ</span>
        </div>
    </div>

    <div class="card admin-list-card">
        <div class="card-body">
            <div class="admin-list-header">
                <div class="admin-list-copy">
                    <span class="admin-list-kicker">Chấm công</span>
                    <h5 class="admin-list-title">Danh sách duyệt đi trễ/về sớm</h5>
                    <p class="admin-list-note">Gom mốc giờ vào một cột, rút ngắn lý do hiển thị và giữ thao tác xử lý trong cùng hàng để duyệt nhanh hơn.</p>
                </div>
                <div class="admin-list-meta">
                    <span class="admin-meta-chip">
                        <strong>@pendingCount</strong>
                        <span>yêu cầu đang mở</span>
                    </span>
                    <span class="admin-meta-chip">
                        <strong>@(managerPendingCount + hrPendingCount + boardPendingCount + legacyPendingCount)</strong>
                        <span>yêu cầu cần theo sát</span>
                    </span>
                </div>
            </div>

            <div class="table-responsive admin-table-scroll">
                <table class="table table-striped table-admin-compact">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nhân viên</th>
                            <th>Loại</th>
                            <th>Ngày</th>
                            <th>Khung giờ</th>
                            <th>Lý do</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 0; }
                        @foreach (var item in Model.RequestList.Data)
                        {
                            i++;
                            var info = item as dynamic;
                            <tr>
                                <td class="text-nowrap">@i</td>
                                <td>
                                    <div class="table-primary-text">@info.EmployeeName</div>
                                </td>
                                <td>@(info.RequestType == "LATE" ? "Đi trễ" : "Về sớm")</td>
                                <td class="text-nowrap">@info.RequestDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-nowrap">
                                    <div class="table-primary-text">@info.StartTime.ToString("HH:mm") - @info.EndTime.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div class="table-col-truncate is-wide" title="@info.Reason">@info.Reason</div>
                                </td>
                                <td class="text-center">
                                    @if (info.Status == 0)
                                    {
                                        <span class="badge bg-warning text-dark">Chờ quản lý duyệt</span>
                                    }
                                    else if (info.Status == 1)
                                    {
                                        <span class="badge bg-info text-dark">Chờ HCNS duyệt</span>
                                    }
                                    else if (info.Status == 2)
                                    {
                                        <span class="badge bg-primary">Chờ BGĐ duyệt</span>
                                    }
                                    else if (info.Status == 3)
                                    {
                                        <span class="badge bg-secondary">Chờ Admin duyệt (cũ)</span>
                                    }
                                    else if (info.Status == 4)
                                    {
                                        <span class="badge bg-success">Đã duyệt</span>
                                    }
                                    else if (info.Status == 5)
                                    {
                                        <span class="badge bg-danger">Từ chối</span>
                                    }
                                    else if (info.Status == 6)
                                    {
                                        <span class="badge bg-secondary">Đã hủy</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="table-actions table-actions-compact justify-content-center">
                                        <button class="btn btn-sm btn-outline-primary" onclick="viewLateEarlyHistory(@info.Id)" title="Lịch sử xử lý">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                        @if (info.Status == 0 || info.Status == 1 || info.Status == 2 || info.Status == 3)
                                        {
                                            <button class="btn btn-sm btn-outline-success" onclick="approveLateEarly(@info.Id, 'Agree')">Duyệt</button>
                                            <button class="btn btn-sm btn-outline-danger" onclick="approveLateEarly(@info.Id, 'Reject')">Từ chối</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (i == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center">Không có yêu cầu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="commentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ghi chú duyệt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="approveId" />
                <input type="hidden" id="approveAction" />
                <div class="mb-3">
                    <label class="form-label">Ý kiến phản hồi</label>
                    <textarea class="form-control" id="approveComment" rows="3"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="submitLateEarlyApproval()">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Lịch sử xử lý</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Người xử lý</th>
                                <th>Hành động</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody id="historyContent"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/pages/late-early-approval.js?v=@DateTime.Now.Ticks"></script>
