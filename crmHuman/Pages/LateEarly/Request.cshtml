@page
@model crmHuman.Pages.LateEarly.RequestModel
@{
    ViewData["Title"] = Model.TitlePage;
    var totalRequests = 0;
    var pendingRequests = 0;
    var approvedRequests = 0;
    var closedRequests = 0;

    if (Model.RequestList?.Data != null)
    {
        foreach (var item in Model.RequestList.Data)
        {
            var info = item as dynamic;
            if (info == null)
            {
                continue;
            }

            totalRequests++;
            if (info.Status == 0 || info.Status == 1 || info.Status == 2 || info.Status == 3)
            {
                pendingRequests++;
            }
            else if (info.Status == 4)
            {
                approvedRequests++;
            }
            else if (info.Status == 5 || info.Status == 6)
            {
                closedRequests++;
            }
        }
    }
}

@Html.AntiForgeryToken()

<div class="pagetitle">
    <h1>@Model.TitlePage</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Đi trễ / Về sớm</li>
        </ol>
    </nav>
</div>

<section class="section admin-page-shell late-early-request-shell">
    <div class="admin-kpi-strip">
        <div class="admin-kpi-card">
            <span class="admin-kpi-label">Tổng yêu cầu</span>
            <strong class="admin-kpi-value">@totalRequests</strong>
            <span class="admin-kpi-meta">Tất cả yêu cầu đi trễ/về sớm hiện hiển thị</span>
        </div>
        <div class="admin-kpi-card">
            <span class="admin-kpi-label">Đang chờ duyệt</span>
            <strong class="admin-kpi-value">@pendingRequests</strong>
            <span class="admin-kpi-meta">Bao gồm các bước quản lý, HCNS, BGĐ và luồng cũ</span>
        </div>
        <div class="admin-kpi-card">
            <span class="admin-kpi-label">Đã duyệt</span>
            <strong class="admin-kpi-value">@approvedRequests</strong>
            <span class="admin-kpi-meta">Các yêu cầu đã hoàn tất phê duyệt</span>
        </div>
        <div class="admin-kpi-card">
            <span class="admin-kpi-label">Đã đóng</span>
            <strong class="admin-kpi-value">@closedRequests</strong>
            <span class="admin-kpi-meta">Từ chối hoặc đã hủy</span>
        </div>
    </div>

    <div class="card admin-list-card">
        <div class="card-body">
            <div class="admin-list-header">
                <div class="admin-list-copy">
                    <span class="admin-list-kicker">Yêu cầu cá nhân</span>
                    <h5 class="admin-list-title">Danh sách yêu cầu đi trễ / về sớm</h5>
                </div>
                <div class="admin-list-actions">
                    @if (Model.Permision.Add ?? false)
                    {
                        <button type="button" class="btn btn-primary" onclick="openAddLateEarly()">Tạo yêu cầu</button>
                    }
                </div>
            </div>

            <div class="table-responsive admin-table-scroll">
                <table class="table table-striped table-admin-compact late-early-request-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nhân sự</th>
                            <th>Yêu cầu</th>
                            <th>Lý do</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 0; }
                        @foreach (var item in Model.RequestList.Data)
                        {
                            i++;
                            var info = item as dynamic;
                            var approverName = Convert.ToString(info.ApproverName);
                            <tr>
                                <td class="text-nowrap">@i</td>
                                <td>
                                    <div class="table-stack">
                                        <div class="table-stack-title">@info.EmployeeName</div>
                                        <div class="table-stack-subtitle">Tạo ngày @info.CreateAt.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="table-stack">
                                        <div class="table-stack-title">@(info.RequestType == "LATE" ? "Đi trễ" : "Về sớm")</div>
                                        <div class="table-stack-subtitle">Ngày @info.RequestDate.ToString("dd/MM/yyyy")</div>
                                        <div class="table-stack-meta">
                                            <span class="table-info-chip is-primary">@info.StartTime.ToString("HH:mm") - @info.EndTime.ToString("HH:mm")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="table-reason-block" title="@info.Reason">@info.Reason</div>
                                </td>
                                <td>
                                    <div class="table-status-stack">
                                        @if (info.Status == 0)
                                        {
                                            <span class="badge bg-warning text-dark">Chờ quản lý duyệt</span>
                                        }
                                        else if (info.Status == 1)
                                        {
                                            <span class="badge bg-info text-dark">Chờ HCNS duyệt</span>
                                        }
                                        else if (info.Status == 2)
                                        {
                                            <span class="badge bg-primary">Chờ BGĐ duyệt</span>
                                        }
                                        else if (info.Status == 3)
                                        {
                                            <span class="badge bg-secondary">Chờ Admin duyệt (cũ)</span>
                                        }
                                        else if (info.Status == 4)
                                        {
                                            <span class="badge bg-success">Đã duyệt</span>
                                        }
                                        else if (info.Status == 5)
                                        {
                                            <span class="badge bg-danger">Từ chối</span>
                                        }
                                        else if (info.Status == 6)
                                        {
                                            <span class="badge bg-secondary">Đã hủy</span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(approverName))
                                        {
                                            <span class="table-info-chip">Duyệt cuối: @approverName</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="table-actions table-actions-compact justify-content-center">
                                        @if (info.Status == 0 && (Model.Permision.Edit ?? false))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openEditLateEarly(@info.Id)" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="viewLateEarlyHistory(@info.Id)" title="Lịch sử">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                        @if ((info.Status == 0 || info.Status == 1 || info.Status == 2 || info.Status == 3) && (Model.Permision.Delete ?? false))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteLateEarly(@info.Id)" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (i == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center">Không có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="lateEarlyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="lateEarlyModalTitle">Tạo yêu cầu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="lateEarlyForm">
                    <input type="hidden" id="lateEarlyId" value="0" />
                    <div class="mb-3">
                        <label class="form-label">Loại yêu cầu</label>
                        <select class="form-select" id="requestType" required>
                            <option value="LATE">Đi trễ</option>
                            <option value="EARLY">Về sớm</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ngày</label>
                        <input type="date" class="form-control" id="requestDate" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Từ giờ</label>
                            <input type="time" class="form-control" id="startTime" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Đến giờ</label>
                            <input type="time" class="form-control" id="endTime" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lý do</label>
                        <textarea class="form-control" id="reason" rows="3" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="lateEarlySaveButton" onclick="saveLateEarly()">Lưu</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Lịch sử xử lý</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Người xử lý</th>
                                <th>Hành động</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody id="historyContent"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/pages/late-early-request.js?v=@DateTime.Now.Ticks"></script>
